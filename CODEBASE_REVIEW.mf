          return rawRoutes;
        }
      }
    } catch { }

    if (typeof window !== 'undefined') {
      try {
        const raw = localStorage.getItem('sreenidhi_routes_cache_v1');
        if (raw) return JSON.parse(raw);
      } catch { }
    }

    return INITIAL_BUS_FLEET;
  }

