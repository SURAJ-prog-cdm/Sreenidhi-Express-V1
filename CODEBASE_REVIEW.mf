## 29. `src/services/corridorProjection.ts` <a id="srcservicescorridorprojectionts"></a>

**Description:** Pure equirectangular GPS-to-route segment projection engine, Haversine meter calculation, and zero-cost buildGoogleMapsRouteUrl multi-stop Directions URL helper shared across portals.  
**File Path:** `sreenidhi-express/src/services/corridorProjection.ts`  

```typescript
import type { RouteStop } from '../types/transit.ts';

export interface GpsProjectionResult {
  segmentIndex: number;
  segmentProgress: number;
  offRouteMeters: number;
  isGpsProjected: boolean;
  nearestStopIndex: number;
}

/**
 * Compute great-circle Haversine distance in meters between two lat/lng coordinates.
 */
export function haversineMeters(lat1: number, lng1: number, lat2: number, lng2: number): number {
  const R = 6371000;
  const dLat = ((lat2 - lat1) * Math.PI) / 180;
  const dLng = ((lng2 - lng1) * Math.PI) / 180;
  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos((lat1 * Math.PI) / 180) *
      Math.cos((lat2 * Math.PI) / 180) *
      Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

function isValidGpsCoord(lat: number, lng: number): boolean {
  if (!Number.isFinite(lat) || !Number.isFinite(lng)) return false;
  if (Math.abs(lat) < 0.0001 && Math.abs(lng) < 0.0001) return false;
  return Math.abs(lat) <= 90 && Math.abs(lng) <= 180;
}

/**
 * Orthogonally project live GPS coordinates onto consecutive route stop segments
 * using local flat-earth equirectangular scaling and clamped t in [0, 1].
 */
export function projectGpsOntoStops(
  lat: number,
  lng: number,
  stops: RouteStop[],
  fallbackIndex = 0,
  fallbackProgress = 0
): GpsProjectionResult {
  if (!Array.isArray(stops) || stops.length === 0) {
    return {
      segmentIndex: 0,
      segmentProgress: 0,
      offRouteMeters: 0,
      isGpsProjected: false,
      nearestStopIndex: 0,
    };
  }

  const maxIdx = stops.length - 1;
  const safeFallbackIdx = Math.min(Math.max(Math.round(fallbackIndex || 0), 0), maxIdx);
  const safeFallbackProg = Number.isFinite(fallbackProgress)
    ? Math.max(0, Math.min(1, fallbackProgress))
    : 0;

  if (!isValidGpsCoord(lat, lng)) {
    return {
      segmentIndex: safeFallbackIdx,
      segmentProgress: safeFallbackProg,
      offRouteMeters: 0,
      isGpsProjected: false,
      nearestStopIndex: safeFallbackIdx,
    };
  }

  let nearestStopIndex = 0;
  let nearestStopDist = Infinity;
  for (let i = 0; i < stops.length; i++) {
    const s = stops[i];
    if (!s || !isValidGpsCoord(s.lat, s.lng)) continue;
    const dist = haversineMeters(lat, lng, s.lat, s.lng);
    if (dist < nearestStopDist) {
      nearestStopDist = dist;
      nearestStopIndex = i;
    }
  }

  if (stops.length === 1) {
    return {
      segmentIndex: 0,
      segmentProgress: 0,
      offRouteMeters: Number.isFinite(nearestStopDist) ? Math.round(nearestStopDist) : 0,
      isGpsProjected: true,
      nearestStopIndex: 0,
    };
  }

  let bestIndex = safeFallbackIdx;
  let bestT = safeFallbackProg;
  let minDistMeters = Infinity;

  for (let i = 0; i < stops.length - 1; i++) {
    const a = stops[i];
    const b = stops[i + 1];
    if (!a || !b || !isValidGpsCoord(a.lat, a.lng) || !isValidGpsCoord(b.lat, b.lng)) {
      continue;
    }

    const latMidRad = (((a.lat + b.lat) / 2) * Math.PI) / 180;
    const cosLat = Math.cos(latMidRad);

    const ax = a.lng * cosLat;
    const ay = a.lat;
    const bx = b.lng * cosLat;
    const by = b.lat;
    const px = lng * cosLat;
    const py = lat;

    const dx = bx - ax;
    const dy = by - ay;
    const lenSq = dx * dx + dy * dy;

    const rawT = lenSq > 1e-14 ? ((px - ax) * dx + (py - ay) * dy) / lenSq : 0;
    const t = Math.max(0, Math.min(1, rawT));

    const projLat = a.lat + (b.lat - a.lat) * t;
    const projLng = a.lng + (b.lng - a.lng) * t;
    const distMeters = haversineMeters(lat, lng, projLat, projLng);

    if (distMeters < minDistMeters) {
      minDistMeters = distMeters;
      bestIndex = i;
      bestT = t;
    }
  }

  if (!Number.isFinite(minDistMeters)) {
    return {
      segmentIndex: safeFallbackIdx,
      segmentProgress: safeFallbackProg,
      offRouteMeters: 0,
      isGpsProjected: false,
      nearestStopIndex: safeFallbackIdx,
    };
  }

  return {
    segmentIndex: bestIndex,
    segmentProgress: Number(bestT.toFixed(4)),
    offRouteMeters: Math.round(minDistMeters),
    isGpsProjected: true,
    nearestStopIndex,
  };
}

/**
 * Build a zero-cost multi-stop Google Maps Directions URL (/maps/dir/?api=1)
 * showing the driving polyline and waypoint stop sidebar across Hyderabad.
 */
export function buildGoogleMapsRouteUrl(
  stops: Array<{ lat: number; lng: number }>,
  fallbackCoords?: { lat: number; lng: number } | null
): string {
  const validStops = Array.isArray(stops)
    ? stops.filter((s) => s && isValidGpsCoord(s.lat, s.lng))
    : [];

  if (validStops.length >= 2) {
    const origin = validStops[0];
    const destination = validStops[validStops.length - 1];
    const intermediates = validStops.slice(1, -1);
    const MAX_WAYPOINTS = 9;
    let selectedIntermediates = intermediates;
    if (intermediates.length > MAX_WAYPOINTS) {
      const sampled: Array<{ lat: number; lng: number }> = [];
      const step = (intermediates.length - 1) / (MAX_WAYPOINTS - 1);
      for (let i = 0; i < MAX_WAYPOINTS; i++) {
        sampled.push(intermediates[Math.round(i * step)]);
      }
      selectedIntermediates = sampled;
    }
    const intermediateWaypoints = selectedIntermediates
      .map((s) => `${s.lat},${s.lng}`)
      .join('|');
    return `https://www.google.com/maps/dir/?api=1&origin=${origin.lat},${origin.lng}&destination=${destination.lat},${destination.lng}${
      intermediateWaypoints ? `&waypoints=${encodeURIComponent(intermediateWaypoints)}` : ''
    }&travelmode=driving`;
  }

  if (validStops.length === 1) {
    const only = validStops[0];
    return `https://www.google.com/maps/dir/?api=1&destination=${only.lat},${only.lng}&travelmode=driving`;
  }

  if (
    fallbackCoords &&
    Number.isFinite(fallbackCoords.lat) &&
    Number.isFinite(fallbackCoords.lng)
  ) {
    return `https://www.google.com/maps/dir/?api=1&destination=${fallbackCoords.lat},${fallbackCoords.lng}&travelmode=driving`;
  }

  return 'https://www.google.com/maps/dir/?api=1&travelmode=driving';
}

```

