});

app.post('/api/admin/admins', requireRole('ADMIN'), apiLimiter, async (req, res) => {
  const b = req.body ?? {};
  const adminId = str(b.adminId, 80, 'adminId');
  if (!/^[a-zA-Z0-9._@+-]{3,80}$/.test(adminId)) {
    throw new HttpError(400, 'adminId must be 3–80 valid characters (email or staff ID)');
  }
  const envAdmins = getConfiguredEnvAdmins();
  if (envAdmins.some((e) => e.id.toUpperCase() === adminId.toUpperCase())) {
    throw new HttpError(409, 'An environment-configured admin with this ID already exists');
  }
  if (extras.getAdminUser(adminId)) {
    throw new HttpError(409, 'An admin account with this ID already exists');
  }

  let finalName = typeof b.name === 'string' && b.name.trim() ? str(b.name, 80, 'name') : '';
  let passwordHash = '';
  const rawPassword = typeof b.password === 'string' ? b.password : '';
  const linkExisting = Boolean(b.linkExistingVerified);

  if (rawPassword) {
    if (rawPassword.length < 8 || rawPassword.length > 128) {
      throw new HttpError(400, 'Admin password must be 8–128 characters');
    }
    if (!finalName) finalName = adminId;
    passwordHash = await hashPassword(rawPassword);
  } else if (linkExisting) {
    const existing = extras.getStudentRow(adminId.toUpperCase());
    if (!existing || !existing.password_hash) {
      throw new HttpError(400, 'No existing registered campus account found to reuse credentials');
    }
    if (existing.verification_status && existing.verification_status !== 'VERIFIED') {
      throw new HttpError(400, 'Account must be verified before promoting to admin');
    }
    if (existing.must_change_password) {
      throw new HttpError(400, 'User must replace their temporary password before promoting to admin');
    }
    if (!finalName) finalName = existing.name || adminId;
    passwordHash = existing.password_hash;
  } else {
    throw new HttpError(400, 'Admin password must be at least 8 characters');
  }

  const created = extras.createAdminUser({
    adminId,
    name: finalName,
    passwordHash,
    createdBy: String(req.user?.sub || 'ADMIN'),
  });
  if (!created) throw new HttpError(409, 'An admin account with this ID already exists');

  appendSheetRow('Alerts_Notifications', {
    Timestamp: now(),
    'Alert ID': `ADM-GRANT-${Date.now()}`,
    'Recipient Name': created.name,
    Category: 'SECURITY',
    Title: 'Admin access granted',
    Message: `${req.user?.sub || 'ADMIN'} granted admin access to ${created.admin_id}`,
    'Delivery Status': 'AUDIT',
  });

  res.status(201).json({
    success: true,
    admin: {
      adminId: created.admin_id,
      name: created.name,
      active: Boolean(created.active),
      source: 'DATABASE',
      createdBy: created.created_by,
      createdAt: created.created_at,
    },
  });
});

app.post('/api/admin/admins/:adminId/status', requireRole('ADMIN'), apiLimiter, (req, res) => {
  const targetId = str(decodeURIComponent(req.params.adminId || ''), 80, 'adminId');
  const active = Boolean(req.body?.active);
  const envAdmins = getConfiguredEnvAdmins();
  if (envAdmins.some((e) => e.id.toUpperCase() === targetId.toUpperCase())) {
    throw new HttpError(400, 'Environment-configured primary admins cannot be modified at runtime');
  }
  if (!active && targetId.toUpperCase() === String(req.user?.sub || '').toUpperCase()) {
    throw new HttpError(400, 'Cannot revoke your own active admin access');
  }

  const updated = extras.setAdminUserActive(targetId, active);
  if (!updated) throw new HttpError(404, 'Admin account not found');

  appendSheetRow('Alerts_Notifications', {
    Timestamp: now(),
    'Alert ID': `ADM-STAT-${Date.now()}`,
    'Recipient Name': updated.name,
    Category: 'SECURITY',
    Title: active ? 'Admin access restored' : 'Admin access revoked',
    Message: `${req.user?.sub || 'ADMIN'} set ${updated.admin_id} active=${active}`,
    'Delivery Status': 'AUDIT',
  });

  res.json({
    success: true,
    admin: {
      adminId: updated.admin_id,
      name: updated.name,
      active: Boolean(updated.active),
      source: 'DATABASE',
      createdBy: updated.created_by,
      createdAt: updated.created_at,
    },
  });
});

/* ---------------- Live SQLite Backup (VACUUM INTO) ---------------- */
app.post('/api/admin/db/backup', requireRole('ADMIN'), (req, res) => {
  const result = createSqliteBackup();
  res.json({ success: true, fileName: result.fileName, backupCount: result.backupCount });
});

/* ---------------- Admin Live Diagnostics ---------------- */
app.get('/api/admin/health', requireRole('ADMIN'), apiLimiter, (req, res) => {
  const walPath = `${DB_FILE_PATH}-wal`;
  let walBytes = 0;
  try {
    if (fs.existsSync(walPath)) {
      walBytes = fs.statSync(walPath).size;
    }
  } catch {}

  const backupsDir = path.join(DATA_DIR, 'backups');
  let lastBackupFile = null;
  let lastBackupAt = null;
  try {
    if (fs.existsSync(backupsDir)) {
      const files = fs.readdirSync(backupsDir)
        .filter((f) => f.endsWith('.db'))
        .map((f) => {
          const fp = path.join(backupsDir, f);
          const st = fs.statSync(fp);
          return { file: f, mtimeMs: st.mtimeMs };
        })
        .sort((a, b) => b.mtimeMs - a.mtimeMs);
      if (files.length > 0) {
        lastBackupFile = files[0].file;
        lastBackupAt = Math.round(files[0].mtimeMs);
      }
    }
  } catch {}

  res.json({
    activeSseClients: sseClients.size,
    liveRoutes: liveBus.size,
    staleRoutes: [...staleFlag],
    walBytes,
    lastBackupFile,
    lastBackupAt,
    uptimeSec: Math.round(process.uptime()),
    memoryMb: Math.round(process.memoryUsage().rss / 1048576),
  });
});

/* ---------------- static frontend + SPA fallback ---------------- */
app.use(express.static(distPath, {
  maxAge: '1h',
  setHeaders: (res, f) => { if (/(index\.html|sw\.js|\.webmanifest)$/.test(f)) res.set('Cache-Control', 'no-store'); },
}));
app.use((req, res, next) => {
  if (req.method !== 'GET' || req.path.startsWith('/api')) return next();
  if (req.path.startsWith('/assets/') || /\.(js|css|json|png|jpe?g|gif|ico|svg|woff2?|map)$/i.test(req.path)) return res.status(404).type('text/plain').send('Not found');
  res.set('Cache-Control', 'no-store').sendFile(path.join(distPath, 'index.html'));
});

/* ---------------- errors: never echo internals ---------------- */
app.use((err, req, res, next) => {
  if (res.headersSent) return next(err);
  if (err instanceof HttpError) return res.status(err.status).json({ error: err.message });
  if (err.type === 'entity.parse.failed' || err.type === 'entity.too.large') return res.status(err.status ?? 400).json({ error: 'Invalid request body' });
  console.error('[api] unhandled:', err);
  res.status(500).json({ error: 'Internal server error' });
});

const isMainModule = Boolean(process.argv[1] && path.resolve(fileURLToPath(import.meta.url)).toLowerCase() === path.resolve(process.argv[1]).toLowerCase());
let server = null;

if (isMainModule) {
  server = app.listen(PORT, () => console.log(`[TransitPulse] listening on port ${PORT} (${IS_PROD ? 'production' : 'development'})`));
  server.on('error', (err) => { console.error('[TransitPulse] server error:', err.code === 'EADDRINUSE' ? `port ${PORT} already in use` : err); process.exit(1); });
  for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => {
    for (const c of sseClients) { try { c.res.end(); } catch {} }
    sseClients.clear();
    server?.closeIdleConnections?.();
    server?.closeAllConnections?.();
    server?.close(() => { try { db.exec('PRAGMA wal_checkpoint(TRUNCATE)'); db.close(); } catch {} process.exit(0); });
    setTimeout(() => process.exit(1), 8000).unref();
  });
}

export { app, server, sseClients, usedStreamTickets, liveBus, staleFlag, tileCache, isPlanLocked, getFirstDepartureUtcMs };

```

---

## 11. `server/excelStorage.js` <a id="serverexcelstoragejs"></a>

**Description:** Real-time Excel engine with SQLite WAL persistence, prepared statement cache, configurable DATA_DIR / DB_FILE_PATH / EXCEL_FILE_PATH, and atomic XLSX export.  
**File Path:** `sreenidhi-express/server/excelStorage.js`  

```javascript
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { DatabaseSync } from 'node:sqlite';
import * as xlsxModule from 'xlsx';

const XLSX = xlsxModule.default || xlsxModule;

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

export const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
export const DB_FILE_PATH = process.env.DB_FILE_PATH || path.join(DATA_DIR, 'transitpulse.db');
export const EXCEL_FILE_PATH = process.env.EXCEL_FILE_PATH || path.join(DATA_DIR, 'sreenidhi_transit_master.xlsx');

// Ensure data folder exists
if (!fs.existsSync(DATA_DIR)) {
  fs.mkdirSync(DATA_DIR, { recursive: true });
}

// Initialize SQLite with WAL mode for ultra-fast, concurrent, non-blocking ACID transactions
export const db = new DatabaseSync(DB_FILE_PATH);
db.exec(`
  PRAGMA journal_mode = WAL;
  PRAGMA busy_timeout = 5000;
  PRAGMA cache_size = -16000;
  PRAGMA synchronous = NORMAL;
  PRAGMA foreign_keys = ON;

  CREATE TABLE IF NOT EXISTS students (
    roll_number TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    program TEXT NOT NULL,
    route_id TEXT NOT NULL,
    pickup_stop TEXT NOT NULL,
    parent_name TEXT NOT NULL,
    parent_phone TEXT NOT NULL,
    pass_status TEXT NOT NULL DEFAULT 'ACTIVE',
    registered_at TEXT NOT NULL,
    last_active TEXT NOT NULL,
    rider_type TEXT NOT NULL DEFAULT 'STUDENT',
    gender TEXT DEFAULT 'M'
  );

  CREATE TABLE IF NOT EXISTS boarding_attendance (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT NOT NULL,
    roll_number TEXT NOT NULL,
    name TEXT,
    route_id TEXT,
    stop_name TEXT,
    event_type TEXT,
    check_in_method TEXT,
    notes TEXT
  );

  CREATE TABLE IF NOT EXISTS return_trip_changes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT NOT NULL,
    roll_number TEXT NOT NULL,
    name TEXT,
    route_id TEXT,
    original_drop TEXT,
    selected_drop TEXT,
    notification_status TEXT
  );

  CREATE TABLE IF NOT EXISTS lost_item_claims (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT NOT NULL,
    claim_id TEXT,
    roll_number TEXT,
    name TEXT,
    route_id TEXT,
    item_type TEXT,
    seat_zone TEXT,
    status TEXT
  );

  CREATE TABLE IF NOT EXISTS parent_alerts_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT NOT NULL,
    alert_id TEXT,
    recipient_name TEXT,
    recipient_phone TEXT,
    category TEXT,
    title TEXT,
    message TEXT,
    delivery_status TEXT
  );

  CREATE TABLE IF NOT EXISTS driver_trip_logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT NOT NULL,
    route_id TEXT,
    driver_name TEXT,
    bus_reg TEXT,
    direction TEXT,
    skipped_clusters TEXT,
    fuel_saved TEXT,
    cost_saved TEXT
  );

  CREATE TABLE IF NOT EXISTS alerts_notifications (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT NOT NULL,
    alert_id TEXT,
    recipient_name TEXT,
    recipient_phone TEXT,
    category TEXT,
    title TEXT,
    message TEXT,
    delivery_status TEXT
  );

  CREATE INDEX IF NOT EXISTS idx_trip_logs_route_ts ON driver_trip_logs(route_id, timestamp);
  CREATE INDEX IF NOT EXISTS idx_parent_alerts_ts ON parent_alerts_log(timestamp);
`);

// 90-day retention pruning for parent alerts on database boot
try {
  const ninetyDaysAgoIso = new Date(Date.now() - 90 * 864e5).toISOString();
  db.prepare('DELETE FROM parent_alerts_log WHERE timestamp < ?').run(ninetyDaysAgoIso);
} catch {
  // Non-fatal if table not yet initialized
}

// Cache prepared statements (previously re-prepared on every call)
const _stmts = new Map();
const prep = (sql) => { let st = _stmts.get(sql); if (!st) { st = db.prepare(sql); _stmts.set(sql, st); } return st; };

// Unified seed students matching official SNIST format & StudentLoginPage demo buttons
const UNIFIED_SEED_STUDENTS = [
  // --- Route 51 Riders (18 Students + 8 Faculty/Staff) ---
  {
