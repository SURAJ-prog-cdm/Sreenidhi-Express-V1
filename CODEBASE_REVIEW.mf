## 26. `src/components/portals/DriverConsole.tsx` <a id="srccomponentsportalsdriverconsoletsx"></a>

**Description:** Prismatic Daylight 3-tab Driver Cockpit (Trip, Stops, Alerts) with electric live headcount hero card, trip start IST timer, next stop & delay broadcaster, and geofence controls.  
**File Path:** `sreenidhi-express/src/components/portals/DriverConsole.tsx`  

```tsx
import React, { useMemo, useState, useEffect, useRef } from 'react';
import {
  AlertOctagon,
  BatteryCharging,
  Bus,
  CheckCircle2,
  ChevronDown,
  ChevronUp,
  FastForward,
  LocateFixed,
  LogOut,
  Minus,
  Plus,
  Volume2,
  VolumeX,
  Wrench,
  Zap,
  Users,
  Play,
  Square,
  Clock,
  Navigation,
} from 'lucide-react';
import { useCommuteSimulation } from '../../context/useCommuteSimulation';
import { buildGoogleMapsRouteUrl, MetroSchematicMap } from '../map/MetroSchematicMap';
import { audioSpeechService } from '../../services/audioSpeechService';
import { excelService } from '../../services/excelService';
import { nativeDeviceService } from '../../services/nativeDeviceService';
import { haversineKm } from '../../services/mapsService';

const ENABLE_AREA_SKIPPING = import.meta.env.VITE_ENABLE_AREA_SKIPPING === 'true';

function formatTimer(sec: number): string {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
}

export const DriverConsole: React.FC = () => {
  const {
    currentUser,
    buses,
    activeBus,
    activeRouteId,
    setActiveRouteId,
    students,
    arrivalStage,
    twoMinCountdownSec,
    driverVoiceEnabled,
    setDriverVoiceEnabled,
    confirmOversleepSafeDropOff,
    triggerBreakdownAndRescue,
    clearBreakdownStatus,
    livePhoneGpsActive,
    toggleLivePhoneGps,
    toggleDriverFlyoverBypass,
    stepBusForward,
    triggerStopArrivalTimer,
    simulateGateProximityBoarding,
    logoutUser,
    pushToast,
    routeOptimizationPlan,
  } = useCommuteSimulation();

  // Quick Tap Headcount Stepper State
  const [manualPassengerCount, setManualPassengerCount] = useState<number>(0);

  // Stop-by-Stop Manifest State
  const [manifestExpanded, setManifestExpanded] = useState(true);

  // Trip State Machine & Sub-Navigation
  const [driverTab, setDriverTab] = useState<'TRIP' | 'STOPS' | 'ALERTS'>('TRIP');
  const [tripRunning, setTripRunning] = useState<boolean>(false);
  const [startedTimeIst, setStartedTimeIst] = useState<string | null>(null);
  const [activeDelayMin, setActiveDelayMin] = useState<number>(0);
  const [wakeLockActive, setWakeLockActive] = useState<boolean>(false);

  useEffect(() => {
    return () => {
      void nativeDeviceService.releaseWakeLock();
    };
  }, []);

  // Auto Re-Acquire Screen WakeLock on visibilitychange (e.g. returning from phone call / background)
  useEffect(() => {
    const handleVisibilityChange = async () => {
      if (document.visibilityState === 'visible' && (tripRunning || livePhoneGpsActive)) {
        try {
          if (!nativeDeviceService.isWakeLockActive()) {
            const acquired = await nativeDeviceService.acquireWakeLock();
            setWakeLockActive(acquired);
          }
        } catch (err) {
          console.warn('[DriverConsole] Wake lock re-acquire failed:', err);
        }
      }
    };
    document.addEventListener('visibilitychange', handleVisibilityChange);
    return () => {
      document.removeEventListener('visibilitychange', handleVisibilityChange);
    };
  }, [tripRunning, livePhoneGpsActive]);

  // Dead-Zone GPS Breadcrumb Buffer (sreenidhi_driver_breadcrumbs_v1)
  const getStoredBreadcrumbs = (): Array<{ lat: number; lng: number; speedKmh: number; heading: number; accuracyM?: number | null; capturedAt: number }> => {
    try {
      const raw = localStorage.getItem('sreenidhi_driver_breadcrumbs_v1');
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  };

  const appendBreadcrumb = (crumb: { lat: number; lng: number; speedKmh: number; heading: number; accuracyM?: number | null; capturedAt: number }) => {
    try {
      const list = getStoredBreadcrumbs();
      list.push(crumb);
      if (list.length > 100) list.splice(0, list.length - 100);
      localStorage.setItem('sreenidhi_driver_breadcrumbs_v1', JSON.stringify(list));
    } catch {}
  };

  const clearBreadcrumbs = () => {
    try {
      localStorage.removeItem('sreenidhi_driver_breadcrumbs_v1');
    } catch {}
  };

  // Telemetry transmission with dead-zone breadcrumb buffer
  const transmitDriverTelemetry = async (coords: { lat: number; lng: number; speedKmh: number; heading?: number; accuracyM?: number | null }) => {
    const payload = {
      routeId: activeBus.routeId,
      lat: coords.lat,
      lng: coords.lng,
      speedKmh: coords.speedKmh,
      heading: coords.heading ?? 0,
      currentStopIndex: activeBus.currentStopIndex,
      delayMinutes: activeDelayMin,
      flyoverBypassActive: activeBus.flyoverBypassActive,
      accuracyM: coords.accuracyM ?? null,
    };
    const success = await excelService.sendBusTelemetry(payload);
    if (!success) {
      appendBreadcrumb({
        lat: coords.lat,
        lng: coords.lng,
        speedKmh: coords.speedKmh,
        heading: coords.heading ?? 0,
        accuracyM: coords.accuracyM ?? null,
        capturedAt: Date.now(),
      });
    } else {
      const crumbs = getStoredBreadcrumbs();
      if (crumbs.length > 0) {
        clearBreadcrumbs();
      }
    }
  };

  // Flush dead-zone breadcrumbs on reconnect
  useEffect(() => {
    const handleOnline = async () => {
      const crumbs = getStoredBreadcrumbs();
      if (crumbs.length > 0 && tripRunning) {
        const latest = crumbs[crumbs.length - 1];
        clearBreadcrumbs();
        if (latest) {
          void excelService.sendBusTelemetry({
            routeId: activeBus.routeId,
            lat: latest.lat,
            lng: latest.lng,
            speedKmh: latest.speedKmh,
            heading: latest.heading,
            currentStopIndex: activeBus.currentStopIndex,
            delayMinutes: activeDelayMin,
            flyoverBypassActive: activeBus.flyoverBypassActive,
            accuracyM: latest.accuracyM ?? null,
          });
        }
      }
    };
    window.addEventListener('online', handleOnline);
    return () => {
      window.removeEventListener('online', handleOnline);
    };
  }, [tripRunning, activeBus.routeId, activeBus.currentStopIndex, activeDelayMin, activeBus.flyoverBypassActive]);

  // Transmit telemetry updates during active trip (simulated / manual advances only)
  useEffect(() => {
    if (!tripRunning || livePhoneGpsActive) return;
    void transmitDriverTelemetry({
      lat: activeBus.currentLat,
      lng: activeBus.currentLng,
      speedKmh: activeBus.speedKmh,
      heading: 0,
    });
  }, [tripRunning, livePhoneGpsActive, activeBus.currentLat, activeBus.currentLng]);

  const [expectedTomorrow, setExpectedTomorrow] = useState<number>(48);
  const [absentTomorrowCount, setAbsentTomorrowCount] = useState<number>(2);

  const prevBusBoardedRef = useRef<number>(activeBus.boardedCount || 0);
  useEffect(() => {
    if (typeof activeBus.boardedCount === 'number' && activeBus.boardedCount !== prevBusBoardedRef.current) {
      prevBusBoardedRef.current = activeBus.boardedCount;
      setManualPassengerCount(activeBus.boardedCount);
    }
  }, [activeBus.boardedCount]);

  // Sync trip state and tomorrow's headcount on mount
  useEffect(() => {
    let mounted = true;
    void (async () => {
      const st = await excelService.getRouteTripState(activeBus.routeId);
      if (mounted) {
        setTripRunning(st.running);
        if (st.running && st.startedAt) {
          const dt = new Date(st.startedAt);
          if (!Number.isNaN(dt.getTime())) {
            setStartedTimeIst(
              dt.toLocaleTimeString('en-IN', {
                timeZone: 'Asia/Kolkata',
                hour: '2-digit',
                minute: '2-digit',
                hour12: true,
              })
            );
          }
        } else if (!st.running) {
          setStartedTimeIst(null);
        }
        setActiveDelayMin(st.delayMinutes);
        if (typeof st.headcount === 'number') {
          prevBusBoardedRef.current = st.headcount;
          setManualPassengerCount(st.headcount);
        }
        setExpectedTomorrow(typeof st.expectedTomorrow === 'number' ? st.expectedTomorrow : 0);
        setAbsentTomorrowCount(typeof st.absentTomorrowCount === 'number' ? st.absentTomorrowCount : 0);
      }
    })();
    return () => {
      mounted = false;
    };
  }, [activeBus.routeId]);

  const handleToggleTrip = async () => {
    const next = !tripRunning;
    setTripRunning(next);
    if (next) {
      setStartedTimeIst(
        new Date().toLocaleTimeString('en-IN', {
          timeZone: 'Asia/Kolkata',
          hour: '2-digit',
          minute: '2-digit',
          hour12: true,
        })
      );
      const acquired = await nativeDeviceService.acquireWakeLock();
      setWakeLockActive(acquired);
      // Automatically request and activate phone GPS on trip start
      if (!livePhoneGpsActive) {
        try {
          await toggleLivePhoneGps();
        } catch {
          pushToast(
            'warning',
            'Live GPS Inactive',
            'Could not obtain device location. Commuters will see corridor schedule instead of live road marker. You can proceed with manual stop departure.'
          );
        }
      }
    } else {
      setStartedTimeIst(null);
      await nativeDeviceService.releaseWakeLock();
      setWakeLockActive(false);
      if (livePhoneGpsActive) {
        await toggleLivePhoneGps();
      }
    }
    await excelService.setTripRunning(next, activeBus.routeId);
    pushToast(
      'info',
      next ? 'Trip Started' : 'Trip Ended',
      next
        ? `${activeBus.routeNumber} is now marked IN PROGRESS. Commuters can track your live movement. Screen Wake Lock active.`
        : 'Trip marked as completed. Bus resting at terminus. Screen Wake Lock released.'
    );
  };

  const handleSetDelay = async (min: number) => {
    setActiveDelayMin(min);
    await excelService.setTripDelay(min, activeBus.routeId);
    pushToast(
      min > 0 ? 'warning' : 'success',
      min > 0 ? `+${min} Min Traffic Delay Broadcasted` : 'Delay Cleared',
      min > 0
        ? `Commuters and parents notified of a +${min} min highway delay.`
        : 'Schedule restored to normal on-time tracking.'
    );
  };

  const busStudents = useMemo(
    () => students.filter((s) => s.routeId === activeBus.routeId),
    [students, activeBus.routeId],
  );

  const totalBooked = busStudents.length;
  const boardedCount = Math.max(manualPassengerCount, busStudents.filter((s) => s.boardingStatus === 'ON_BOARD').length);
  const waitingCount = Math.max(0, totalBooked - boardedCount);
  const notComingCount = busStudents.filter((s) => s.boardingStatus === 'NOT_COMING').length;

  const currentStop = activeBus.stops[activeBus.currentStopIndex] || activeBus.stops[0];

  // Headcount Stepper Actions
  const handleIncrementPassengers = (delta: number) => {
    setManualPassengerCount((prev) => {
      const next = Math.min(activeBus.capacity, Math.max(0, prev + delta));
      audioSpeechService.playClickTone();
      return next;
    });
  };

  const handleBatchBoardCurrentStop = async () => {
    const stopStudents = busStudents.filter((s) => s.pickupStopId === currentStop.id);
    const unboarded = stopStudents.filter((st) => st.boardingStatus !== 'ON_BOARD' && st.boardingStatus !== 'NOT_COMING');
    if (unboarded.length === 0) {
      pushToast('info', 'No Commuters Pending', `All commuters at ${currentStop.name} are already accounted for.`);
      return;
    }
    const count = unboarded.length;
    unboarded.forEach((st) => {
      simulateGateProximityBoarding(st.id);
    });
    void excelService.boardStop(
      currentStop.name,
      count,
      unboarded.map((s) => ({ rollNumber: s.rollNumber || s.id, name: s.name }))
    );
    setManualPassengerCount((prev) => Math.min(activeBus.capacity, prev + count));
    audioSpeechService.playBleBoardingChime();
    pushToast('success', 'Stop Boarded', `Authoritatively checked-in ${count} passengers at ${currentStop.name}.`);
  };

  const handleCheckInIndividualStudent = async (studentId: string, studentName?: string) => {
    simulateGateProximityBoarding(studentId);
    audioSpeechService.playBleBoardingChime();
    const st = busStudents.find((s) => s.id === studentId);
    const roll = st?.rollNumber || studentId;
    const name = studentName || st?.name || 'Student';
    await excelService.boardStop(currentStop.name, 1, [{ rollNumber: roll, name }]);
    setManualPassengerCount((prev) => Math.min(activeBus.capacity, prev + 1));
    pushToast('success', 'Student Boarded', `Verified check-in for student ${name} (${roll}).`);
  };

  // Auto-GPS Geofencing & Dwell Audit Refs and State
  const autoArrivedStopIdRef = useRef<string | null>(null);
  const lastDepartedStopRef = useRef<{ stopId: string; timestampMs: number } | null>(null);
  const arrivedAtMsRef = useRef<{ stopId: string; stopName: string; arrivedAtMs: number } | null>(null);
  const [autoGeofenceDistanceM, setAutoGeofenceDistanceM] = useState<number | null>(null);
  const [showManualOverride, setShowManualOverride] = useState<boolean>(false);

  const flushStopDwellLog = () => {
    const entry = arrivedAtMsRef.current;
    if (!entry) return;
    arrivedAtMsRef.current = null;
    const departedMs = Date.now();
    const dwellSec = Math.max(0, Math.round((departedMs - entry.arrivedAtMs) / 1000));
    void excelService.recordStopDwell({
      routeId: activeBus.routeId,
      stopId: entry.stopId,
      stopName: entry.stopName,
      arrivedAt: new Date(entry.arrivedAtMs).toISOString(),
      departedAt: new Date(departedMs).toISOString(),
      dwellSec,
    });
  };

  const handleArriveCurrentStop = () => {
    if (currentStop && (!arrivedAtMsRef.current || arrivedAtMsRef.current.stopId !== currentStop.id)) {
      arrivedAtMsRef.current = {
        stopId: currentStop.id,
        stopName: currentStop.name,
        arrivedAtMs: Date.now(),
      };
    }
    triggerStopArrivalTimer();
    audioSpeechService.playSuccessChime();
  };

  const handleDepartStop = () => {
    flushStopDwellLog();
    if (currentStop) {
      lastDepartedStopRef.current = { stopId: currentStop.id, timestampMs: Date.now() };
    }
    stepBusForward();
    audioSpeechService.playClickTone();
  };

  // Reset auto-arrived stop tracking ref when trip stops or activeBus changes
  useEffect(() => {
    if (!tripRunning) {
      flushStopDwellLog();
      autoArrivedStopIdRef.current = null;
      lastDepartedStopRef.current = null;
    }
  }, [tripRunning, activeBus.routeId]);

  useEffect(() => {
    if (!tripRunning || !currentStop) return;
    const distKm = haversineKm(activeBus.currentLat, activeBus.currentLng, currentStop.lat, currentStop.lng);
    const distM = Math.round(distKm * 1000);
    setAutoGeofenceDistanceM(distM);

    const arrivalThreshold = Math.min(150, currentStop.geofenceRadiusMeters || 150);

    // Auto-arrive when within arrival geofence threshold
    if (distM <= arrivalThreshold) {
      if (arrivalStage === 'IDLE' && autoArrivedStopIdRef.current !== currentStop.id) {
        autoArrivedStopIdRef.current = currentStop.id;
        if (lastDepartedStopRef.current && lastDepartedStopRef.current.stopId !== currentStop.id) {
          const elapsedSec = Math.round((Date.now() - lastDepartedStopRef.current.timestampMs) / 1000);
          if (elapsedSec >= 30 && elapsedSec <= 3600) {
            void excelService.recordSegmentArrival(
              activeBus.routeId,
              lastDepartedStopRef.current.stopId,
              currentStop.id,
              elapsedSec,
            );
          }
        }
        handleArriveCurrentStop();
      }
    } else if (distM > 225) {
      // Auto-depart when bus has left the stop perimeter
      if (arrivalStage !== 'IDLE' && autoArrivedStopIdRef.current === currentStop.id) {
        handleDepartStop();
        autoArrivedStopIdRef.current = null;
      }
    }
  }, [tripRunning, activeBus.currentLat, activeBus.currentLng, currentStop, arrivalStage]);

  const oversleepingStudents = busStudents.filter(
    (s) => s.boardingStatus === 'OVERSLEPT',
  );

  const loadPercentage = Math.round((boardedCount / activeBus.capacity) * 100);

  return (
    <div className="mx-auto w-full max-w-5xl space-y-4 pb-16 antialiased">
      {/* Compact Driver Header */}
      <div className="prismatic-card flex flex-wrap items-center justify-between gap-3 rounded-3xl p-3.5 sm:p-4">
        <div className="flex items-center gap-3 min-w-0 flex-1">
          <div className="rounded-full bg-gradient-to-br from-[#4F46E5] to-[#06B6D4] p-0.5 shadow-sm shrink-0">
            <img
              src="/sreenidhi_express_logo.jpg"
              alt="Sreenidhi Express Logo"
              className="h-10 w-10 rounded-full object-cover"
            />
          </div>
          <div className="min-w-0 flex-1">
            <div className="flex items-center gap-2 flex-wrap">
              <h1 className="text-sm sm:text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
                Driver Console
              </h1>
              <span
                className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-bold ${
                  tripRunning
                    ? 'border border-cyan-200 bg-cyan-50 text-cyan-800 dark:border-cyan-700/50 dark:bg-cyan-950/60 dark:text-cyan-300'
                    : 'bg-slate-100 text-slate-600 dark:bg-[#2E3646] dark:text-slate-300'
                }`}
              >
                {tripRunning ? (
                  <>
                    <span className="h-1.5 w-1.5 rounded-full bg-[#06B6D4] animate-pulse" />
                    <span>{activeBus.routeNumber} • Live</span>
                  </>
                ) : (
                  <span>Standby</span>
                )}
              </span>
              <span
                className={`rounded-full px-2 py-0.5 text-[10px] font-bold ${
                  wakeLockActive
                    ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300'
                    : 'bg-slate-100 text-slate-500 dark:bg-[#141821] dark:text-slate-400'
                }`}
              >
                {wakeLockActive ? 'Wake Lock: ON' : 'Wake Lock: OFF'}
              </span>
            </div>

            <div className="mt-1 flex flex-wrap items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
              {currentUser?.role === 'DRIVER' ? (
                <span className="font-semibold text-slate-700 dark:text-slate-200 truncate">
                  {activeBus.driverName || 'Assigned Driver'} • {activeBus.routeNumber} ({activeBus.registrationNo})
                </span>
              ) : (
                <select
                  aria-label="Select Driver Route"
                  value={activeRouteId}
                  onChange={(e) => setActiveRouteId(e.target.value)}
                  className="rounded-xl border border-slate-200 bg-[#F7F9FF] px-2.5 py-0.5 text-[11px] font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                >
                  {buses.map((b) => (
                    <option key={b.routeId} value={b.routeId}>
                      {b.routeNumber} ({b.registrationNo}) — {b.driverName}
                    </option>
                  ))}
                </select>
              )}
            </div>
          </div>
        </div>

        <button
          type="button"
          onClick={logoutUser}
          className="tactile-btn inline-flex items-center gap-1.5 rounded-full border border-slate-200/80 bg-[#F7F9FF] px-3.5 py-2 text-xs font-bold text-slate-700 transition hover:bg-rose-50 hover:text-rose-600 dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-300 dark:hover:bg-rose-950/40 dark:hover:text-rose-400 cursor-pointer shrink-0"
        >
          <LogOut className="h-3.5 w-3.5" />
          <span>Log out</span>
        </button>
      </div>

      {/* 3-Tab Driver Sub-Navigation */}
      <div className="prismatic-card grid grid-cols-3 gap-1.5 rounded-2xl p-1">
        {(
          [
            { id: 'TRIP', label: 'Trip' },
            { id: 'STOPS', label: 'Stops' },
            { id: 'ALERTS', label: 'Alerts' },
          ] as const
        ).map(({ id, label }) => (
          <button
            key={id}
            type="button"
            onClick={() => setDriverTab(id)}
            className={`tactile-btn rounded-xl py-2 text-xs font-extrabold transition cursor-pointer ${
              driverTab === id
                ? 'bg-gradient-to-r from-[#4F46E5] to-[#06B6D4] text-white shadow-sm shadow-indigo-500/20'
                : 'text-slate-500 hover:bg-indigo-50/70 hover:text-[#4F46E5] dark:text-slate-400 dark:hover:text-white'
            }`}
          >
            {label}
          </button>
        ))}
      </div>

      {/* Emergency Oversleep Pull-Over Banner */}
      {oversleepingStudents.length > 0 && (
        <div className="animate-pulse rounded-3xl border border-rose-400/50 bg-rose-50 p-4 text-rose-900 shadow-md dark:bg-rose-950/40 dark:text-rose-100">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div className="flex items-start gap-3">
              <AlertOctagon className="mt-0.5 h-7 w-7 shrink-0 text-rose-600 dark:text-rose-400" />
              <div>
                <p className="text-[10px] font-extrabold uppercase tracking-widest text-rose-700 dark:text-rose-300">
                  Oversleep Alert — Pull Over Safely
                </p>
                <h3 className="text-sm font-extrabold text-rose-900 dark:text-white">
                  {oversleepingStudents.map((s) => s.name).join(', ')} missed their stop and is still on board!
                </h3>
              </div>
            </div>
            <button
              type="button"
              onClick={confirmOversleepSafeDropOff}
              className="tactile-btn rounded-xl bg-rose-600 px-4 py-2 text-xs font-extrabold text-white shadow-sm hover:bg-rose-700 cursor-pointer"
            >
              Student Safely Stepped Off
            </button>
          </div>
        </div>
      )}

      {driverTab === 'TRIP' && (
        <div className="animate-panel-in space-y-4">
          {/* Primary Electric Indigo -> Cyan Driver Hero Card */}
          <div className="electric-hero rounded-3xl p-5 text-white">
            <div className="bg-futuristic-grid pointer-events-none absolute inset-0 opacity-25" />

            {/* Top Row: Live Headcount & Compact Stepper */}
            <div className="relative flex items-center justify-between gap-3">
              <div>
                <p className="text-[11px] font-semibold text-indigo-100/90">Live Headcount:</p>
                <div className="mt-0.5 flex items-baseline gap-2">
                  <span className="font-mono-timer text-3xl sm:text-4xl font-black tracking-tight text-white">
                    {boardedCount}{' '}
                    <span className="text-lg font-bold text-cyan-100/90">/ {activeBus.capacity}</span>
                  </span>
                  <span className="rounded-full bg-white/18 px-2.5 py-0.5 text-[10px] font-bold text-white ring-1 ring-white/25 backdrop-blur-xs">
                    {loadPercentage}% full
                  </span>
                </div>
              </div>

              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={() => handleIncrementPassengers(-1)}
                  title="Decrease passenger count"
                  className="tactile-btn flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 text-white ring-1 ring-white/25 backdrop-blur-xs transition hover:bg-white/30 cursor-pointer"
                >
                  <Minus className="h-4 w-4" />
                </button>
                <button
                  type="button"
                  onClick={() => handleIncrementPassengers(1)}
                  title="Increase passenger count"
                  className="tactile-btn flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 text-white ring-1 ring-white/25 backdrop-blur-xs transition hover:bg-white/30 cursor-pointer"
                >
                  <Plus className="h-4 w-4" />
                </button>
              </div>
            </div>

            {/* Middle Row: Started Time & Live GPS / 5G Pill */}
            <div className="relative mt-3.5 flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-white/15 bg-white/12 px-3.5 py-2.5 text-xs backdrop-blur-md">
              <div className="flex items-center gap-2">
                <Clock className="h-3.5 w-3.5 text-cyan-200" />
                <span className="font-semibold text-white">
                  Started {startedTimeIst || 'Not Started'}
                </span>
              </div>
              <div className="flex items-center gap-2 rounded-full bg-white/18 px-2.5 py-0.5 font-mono text-[11px] font-bold text-white">
                <BatteryCharging className="h-3.5 w-3.5 text-cyan-200" />
                <span>{livePhoneGpsActive ? 'GPS Active' : 'GPS Standby'} • 5G • {activeBus.driverBatteryPct ?? 86}%</span>
              </div>
            </div>

            {/* Bottom Full-Width Crisp White CTA */}
            <button
              type="button"
              onClick={handleToggleTrip}
              className="animate-electric-sheen tactile-btn relative mt-4 flex w-full items-center justify-center gap-2 overflow-hidden rounded-xl bg-white py-3 text-xs font-extrabold text-[#4F46E5] shadow-md transition hover:bg-indigo-50 cursor-pointer"
            >
              {tripRunning ? <Square className="h-4 w-4" /> : <Play className="h-4 w-4" />}
              <span>{tripRunning ? 'End Bus Trip' : 'Start Bus Trip'}</span>
            </button>
          </div>

          {/* Next Stop & Quick Delay Card */}
          <div className="prismatic-card rounded-3xl p-4 sm:p-5">
            <div className="flex flex-wrap items-center justify-between gap-2.5 border-b border-slate-100 pb-3.5 dark:border-[#2E3646]">
              <div className="min-w-0">
                <p className="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  Next Stop:
                </p>
                <p className="mt-0.5 text-sm sm:text-base font-extrabold text-slate-900 dark:text-white truncate">
                  {currentStop?.name}
                </p>
                <p className="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                  {waitingCount} waiting • {notComingCount} opt-out
                </p>
              </div>

              <div className="flex flex-wrap items-center gap-2">
                <span className="rounded-full border border-indigo-200/80 bg-indigo-50 px-3 py-1 font-mono text-xs font-bold text-[#4F46E5] dark:border-indigo-700/50 dark:bg-indigo-950/60 dark:text-cyan-300">
                  {arrivalStage === 'ARRIVED_2_MIN_TIMER' && twoMinCountdownSec > 0
                    ? `Dwell: ${formatTimer(twoMinCountdownSec)}`
                    : autoGeofenceDistanceM !== null
                    ? `${autoGeofenceDistanceM}m`
                    : 'Scheduled'}
                </span>
                {tripRunning && (
                  <button
                    type="button"
                    onClick={handleDepartStop}
                    className="electric-cta inline-flex items-center gap-1 rounded-xl px-3 py-1.5 text-xs font-bold text-white cursor-pointer"
                  >
                    <FastForward className="h-3.5 w-3.5" />
                    <span>Next Stop →</span>
                  </button>
                )}
              </div>
            </div>

            <div className="mt-3.5 flex flex-wrap items-center gap-2">
              {[
                { min: 5, label: '+5 min' },
                { min: 10, label: '+10 min' },
                { min: 20, label: 'Traffic (+20m)' },
              ].map((item) => (
                <button
                  key={item.min}
                  type="button"
                  onClick={() => handleSetDelay(item.min)}
                  className={`tactile-btn rounded-full px-3.5 py-1.5 text-xs font-bold transition cursor-pointer ${
                    activeDelayMin === item.min
                      ? 'bg-amber-500 text-white shadow-xs'
                      : 'border border-slate-200/80 bg-[#F7F9FF] text-slate-700 hover:border-indigo-300 hover:bg-indigo-50 hover:text-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200'
                  }`}
                >
                  {item.label}
                </button>
              ))}
              {activeDelayMin > 0 && (
                <button
                  type="button"
                  onClick={() => handleSetDelay(0)}
                  className="tactile-btn rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/60 dark:text-emerald-300 cursor-pointer"
                >
                  On-Time
                </button>
              )}
            </div>
          </div>

          {/* Compact Live GPS Corridor Schematic Card */}
          <div className="prismatic-card overflow-hidden rounded-3xl">
            <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 p-3.5 dark:border-[#2E3646]">
              <div className="flex items-center gap-2">
                <span className="h-2 w-2 rounded-full bg-[#06B6D4] shadow-[0_0_8px_rgba(6,182,212,0.85)] animate-pulse" />
                <h4 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                  Live Corridor Radar • {activeBus.routeNumber}
                </h4>
              </div>
              <span className="prismatic-subcard rounded-lg px-2.5 py-1 font-mono text-[11px] font-bold text-[#4F46E5] dark:text-cyan-300">
                {Math.round(activeBus.speedKmh)} km/h
              </span>
            </div>

            <div className="p-2.5 sm:p-3 bg-[#F7F9FF] dark:bg-[#141821]">
              <MetroSchematicMap activeBus={activeBus} highlightStopId={currentStop?.id} />
            </div>
          </div>
        </div>
      )}

      {driverTab === 'STOPS' && (
        <div className="animate-panel-in space-y-4">
          {/* Stop-by-Stop Passenger Manifest & Batch Boarding */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4 dark:border-[#2E3646]">
              <div>
                <div className="flex items-center gap-2 flex-wrap">
                  <span className="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                    <Bus className="h-4 w-4" />
                  </span>
                  <h2 className="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white">
                    Corridor Stop Schedule &amp; Manifest
                  </h2>
                  <span className="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[10px] font-bold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-indigo-300">
                    {activeBus.routeId === 'route-51'
                      ? '26 Registered (18 Students • 8 Faculty/Staff)'
                      : `${busStudents.length} Registered`}
                  </span>
                </div>
                <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
                  Tomorrow Expected: <b>{routeOptimizationPlan?.expectedRouteStudents ?? expectedTomorrow}</b> ({routeOptimizationPlan?.absentRouteStudents ?? absentTomorrowCount} opted out)
                </p>
              </div>

              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={handleBatchBoardCurrentStop}
                  className="electric-cta flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold text-white cursor-pointer"
                >
                  <CheckCircle2 className="h-4 w-4" />
                  <span>Mark {currentStop.name} Boarded</span>
                </button>
                <button
                  type="button"
                  onClick={() => setManifestExpanded(!manifestExpanded)}
                  className="tactile-btn flex items-center gap-1 rounded-xl border border-indigo-200 bg-indigo-50/70 px-2.5 py-2 text-xs font-bold text-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-cyan-300 cursor-pointer"
                >
                  <span>{manifestExpanded ? 'Collapse' : 'Expand'}</span>
                  {manifestExpanded ? <ChevronUp className="h-4 w-4" /> : <ChevronDown className="h-4 w-4" />}
                </button>
              </div>
            </div>

            {manifestExpanded && (
              <div className="mt-4 space-y-2.5">
                {activeBus.stops.map((stop, idx) => {
                  const isPassed = idx < activeBus.currentStopIndex;
                  const isCurrent = idx === activeBus.currentStopIndex;
                  const stopStudents = busStudents.filter((s) => s.pickupStopId === stop.id);
                  const stopBoarded = stopStudents.filter((s) => s.boardingStatus === 'ON_BOARD').length;

                  return (
                    <div
                      key={stop.id}
                      className={`rounded-2xl border p-3.5 transition-all ${
                        isCurrent
                          ? 'border-[#4F46E5]/60 bg-gradient-to-br from-indigo-50/90 via-white to-cyan-50/70 shadow-sm dark:border-indigo-500 dark:bg-indigo-950/30'
                          : isPassed
                          ? 'border-slate-200/60 bg-slate-50/70 opacity-75 dark:border-[#2E3646] dark:bg-[#141821]'
                          : 'border-slate-200/80 bg-[#F7F9FF] dark:border-[#2E3646] dark:bg-[#141821]'
                      }`}
                    >
                      <div className="flex flex-wrap items-center justify-between gap-2">
                        <div className="flex items-center gap-3">
                          <span
                            className={`flex h-7 w-7 shrink-0 items-center justify-center rounded-xl font-bold text-xs ${
                              isCurrent
                                ? 'bg-gradient-to-br from-[#4F46E5] to-[#06B6D4] text-white'
                                : isPassed
                                ? 'bg-slate-300 text-slate-700 dark:bg-slate-700 dark:text-slate-300'
                                : 'bg-white text-slate-900 border border-slate-200 dark:bg-[#1E2430] dark:text-white dark:border-[#2E3646]'
                            }`}
                          >
                            {stop.sequence}
                          </span>
                          <div>
                            <div className="flex items-center gap-2">
                              <h4 className="text-xs font-extrabold text-slate-900 dark:text-white">
                                {stop.name}
                              </h4>
                              {stop.metroInterchange && (
                                <span className="rounded bg-cyan-50 border border-cyan-200 px-1.5 py-0.5 text-[9px] font-bold text-cyan-800 dark:bg-cyan-950 dark:border-cyan-800 dark:text-cyan-300">
                                  METRO
                                </span>
                              )}
                            </div>
                            <p className="text-[11px] text-slate-500 dark:text-slate-400">
                              {stop.areaClusterName} • Sched: {stop.scheduledMorningTime}
                            </p>
                          </div>
                        </div>

                        <div className="flex items-center gap-2">
                          <span
                            className={`rounded-full px-2.5 py-0.5 text-[10px] font-bold ${
                              isCurrent
                                ? 'bg-gradient-to-r from-[#4F46E5] to-[#06B6D4] text-white'
                                : isPassed
                                ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300'
                                : 'bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300'
                            }`}
                          >
                            {isCurrent ? 'CURRENT STOP' : isPassed ? '✓ DEPARTED' : 'UPCOMING'}
                          </span>
                          <span className="text-xs font-mono font-bold text-slate-900 dark:text-white">
                            {stopBoarded}/{stopStudents.length} Boarded
                          </span>
                        </div>
                      </div>

                      {isCurrent && stopStudents.length > 0 && (
                        <div className="mt-3 border-t border-indigo-100 pt-2.5 dark:border-[#2E3646]">
                          <p className="text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1.5">
                            Stop Passenger Manifest:
                          </p>
                          <div className="space-y-1.5">
                            {stopStudents.map((st) => (
                              <div
                                key={st.id}
                                className="flex items-center justify-between rounded-xl bg-white/95 px-2.5 py-1.5 text-xs shadow-2xs dark:bg-[#1E2430]"
                              >
                                <div className="flex items-center gap-2">
                                  <span className="font-bold text-slate-900 dark:text-white">{st.name}</span>
                                  <span className="font-mono text-[10px] text-slate-500 dark:text-slate-400">
                                    ({st.rollNumber || st.id})
                                  </span>
                                  {st.riderType === 'FACULTY' && (
                                    <span className="rounded bg-purple-100 px-1.5 py-0.5 text-[9px] font-bold text-purple-800 dark:bg-purple-950 dark:text-purple-300">
                                      FACULTY
                                    </span>
                                  )}
                                </div>
                                <div className="flex items-center gap-2">
                                  <span
                                    className={`rounded-md px-1.5 py-0.5 text-[9px] font-black uppercase ${
                                      st.boardingStatus === 'ON_BOARD'
                                        ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300'
                                        : st.boardingStatus === 'NOT_COMING'
                                        ? 'bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300'
                                        : 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
                                    }`}
                                  >
                                    {st.boardingStatus === 'ON_BOARD'
                                      ? '✓ Boarded'
                                      : st.boardingStatus === 'NOT_COMING'
                                      ? 'Absent'
                                      : 'Waiting'}
                                  </span>
                                  {st.boardingStatus !== 'ON_BOARD' && st.boardingStatus !== 'NOT_COMING' && (
                                    <button
                                      type="button"
                                      onClick={() => handleCheckInIndividualStudent(st.id, st.name)}
                                      className="electric-cta rounded-lg px-2.5 py-0.5 text-[10px] font-bold text-white cursor-pointer"
                                    >
                                      Board
                                    </button>
                                  )}
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          {/* Tomorrow / Active Route Navigation & Optimization Panel */}
          {!ENABLE_AREA_SKIPPING ? (
            <div className="prismatic-card rounded-3xl p-4 sm:p-5">
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div className="flex items-center gap-2.5 min-w-0">
                  <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                    <Navigation className="h-4 w-4" />
                  </span>
                  <div className="min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                        Route Navigation &amp; Pilot Mode
                      </h3>
                      <span className="rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-bold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                        Phase 1 Pilot
                      </span>
                    </div>
                    <p className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                      All stops active — area-skipping disabled for Phase 1 pilot • Tomorrow:{' '}
                      <b className="text-slate-800 dark:text-slate-200">
                        {routeOptimizationPlan?.expectedRouteStudents ?? expectedTomorrow} coming
                      </b>{' '}
                      /{' '}
                      <span className="font-semibold text-amber-700 dark:text-amber-300">
                        {routeOptimizationPlan?.absentRouteStudents ?? absentTomorrowCount} opted out
                      </span>
                    </p>
                  </div>
                </div>

                <a
                  href={buildGoogleMapsRouteUrl(activeBus.stops, {
                    lat: activeBus.currentLat,
                    lng: activeBus.currentLng,
                  })}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="electric-cta flex items-center gap-2 rounded-xl text-white px-3.5 py-2 text-xs font-bold cursor-pointer"
                >
                  <Navigation className="h-3.5 w-3.5" />
                  <span>Navigate Full Route (Google Maps)</span>
                </a>
              </div>
            </div>
          ) : (
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div className="flex items-center gap-2.5">
                <span className="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                  <Navigation className="h-4 w-4" />
                </span>
                <div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                      Dynamic Route Optimization (Tomorrow Run)
                    </h3>
                    {routeOptimizationPlan?.skippedClusterIds?.length > 0 ? (
                      <span className="rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 px-2 py-0.5 text-[10px] font-bold">
                        {routeOptimizationPlan.skippedClusterIds.length} Cluster(s) Bypassed
                      </span>
                    ) : (
                      <span className="rounded-full bg-indigo-50 text-[#4F46E5] dark:bg-slate-800 dark:text-slate-300 px-2 py-0.5 text-[10px] font-bold">
                        Standard Route (All Stops Active)
                      </span>
                    )}
                  </div>
                  <p className="text-xs text-slate-500 dark:text-slate-400">
                    Automated area bypass activates when 100% of riders in a cluster are absent.
                  </p>
                </div>
              </div>

              {(() => {
                const activeStops = activeBus.stops.filter((s) => !s.isBypassed);
                const googleMapsUrl = buildGoogleMapsRouteUrl(
                  activeStops.length > 0 ? activeStops : activeBus.stops,
                  { lat: activeBus.currentLat, lng: activeBus.currentLng }
                );

                return (
                  <a
                    href={googleMapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="electric-cta flex items-center gap-2 rounded-xl text-white px-3.5 py-2 text-xs font-bold cursor-pointer"
                  >
                    <Navigation className="h-3.5 w-3.5" />
                    <span>Navigate Optimized Route (Google Maps)</span>
                  </a>
                );
              })()}
            </div>

            {routeOptimizationPlan?.skippedClusterIds?.length > 0 && (
              <div className="mt-3 flex flex-wrap items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3 text-xs text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300">
                <span className="font-bold">Projected Trip Savings:</span>
                <span className="rounded-md bg-white dark:bg-[#1E2430] px-2 py-0.5 font-mono font-bold shadow-2xs">
                  ⏱️ -{routeOptimizationPlan.estimatedMinutesSaved || 12} min
                </span>
                <span className="rounded-md bg-white dark:bg-[#1E2430] px-2 py-0.5 font-mono font-bold shadow-2xs">
                  🛣️ -{routeOptimizationPlan.estimatedKmSaved || 3.5} km
                </span>
                <span className="rounded-md bg-white dark:bg-[#1E2430] px-2 py-0.5 font-mono font-bold shadow-2xs">
                  ⛽ ~₹{Math.round((routeOptimizationPlan.estimatedKmSaved || 3.5) * 0.32 * 98)} diesel saved
                </span>
              </div>
            )}

            {routeOptimizationPlan?.clusters && (
              <div className="mt-3 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2.5">
                {routeOptimizationPlan.clusters.map((c: any) => (
                  <div
                    key={c.clusterId}
                    className={`rounded-2xl border p-3 flex flex-col justify-between ${
                      c.isSkipped
                        ? 'border-emerald-300 bg-emerald-50/50 dark:border-emerald-800 dark:bg-emerald-950/30'
                        : 'prismatic-subcard'
                    }`}
                  >
                    <div>
                      <div className="flex items-center justify-between gap-1.5">
                        <span className="text-[11px] font-bold text-slate-900 dark:text-white truncate">
                          {c.clusterName}
                        </span>
                        <span
                          className={`rounded-full px-1.5 py-0.5 text-[9px] font-extrabold uppercase shrink-0 ${
                            c.isSkipped
                              ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
                              : 'bg-indigo-50 text-[#4F46E5] dark:bg-slate-700 dark:text-slate-300'
                          }`}
                        >
                          {c.isSkipped ? 'BYPASS' : 'STOP'}
                        </span>
                      </div>
                      <p className="mt-1 text-[10px] text-slate-500 dark:text-slate-400">
                        {c.isCampus ? 'Campus Terminal Hub' : `${c.totalRegisteredStudents} registered rider(s)`}
                      </p>
                    </div>
                    {!c.isCampus && (
                      <div className="mt-2 flex items-center justify-between text-[10px] font-medium pt-1.5 border-t border-slate-200/60 dark:border-[#2E3646]">
                        <span className="text-emerald-700 dark:text-emerald-400 font-bold">
                          {c.comingStudents} coming
                        </span>
                        <span className="text-amber-700 dark:text-amber-400 font-bold">
                          {c.absentStudents} absent
                        </span>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
          )}
        </div>
      )}

      {driverTab === 'ALERTS' && (
        <div className="animate-panel-in space-y-4">
          {/* Automatic GPS Geofence & Manual Override */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <div className="flex items-center gap-2.5">
                <span className="relative flex h-3 w-3">
                  <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#06B6D4] opacity-75"></span>
                  <span className="relative inline-flex h-3 w-3 rounded-full bg-[#4F46E5]"></span>
                </span>
                <div>
                  <span className="text-xs font-extrabold text-[#4F46E5] dark:text-cyan-300">
                    Automatic GPS Geofence Active
                  </span>
                  <p className="text-[11px] text-slate-500 dark:text-slate-400">
                    Target: <b className="text-slate-900 dark:text-white">{currentStop?.name}</b>{' '}
                    {autoGeofenceDistanceM !== null && `• Distance: ${autoGeofenceDistanceM}m`}
                  </p>
                </div>
              </div>
              <span className="rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[10px] font-bold text-[#4F46E5] dark:border-indigo-700/50 dark:bg-indigo-950/60 dark:text-cyan-300 font-mono">
                ≤150m AUTO-ARRIVE • &gt;225m AUTO-DEPART
              </span>
            </div>

            <div className="mt-3.5 pt-3 border-t border-slate-100 dark:border-[#2E3646] flex flex-col gap-2">
              <button
                type="button"
                onClick={() => setShowManualOverride((prev) => !prev)}
                className="self-start text-xs font-bold text-[#4F46E5] hover:underline dark:text-cyan-300 cursor-pointer"
              >
                {showManualOverride ? 'Hide Manual Override' : 'Show Manual Override Controls'}
              </button>
              {showManualOverride && (
                <div className="flex flex-wrap gap-2 pt-1">
                  <button
                    type="button"
                    onClick={handleArriveCurrentStop}
                    className="tactile-btn rounded-xl bg-amber-600 px-3.5 py-2 text-xs font-bold text-white shadow-xs hover:bg-amber-700 cursor-pointer"
                  >
                    Force Arrive Stop (2m Timer)
                  </button>
                  <button
                    type="button"
                    onClick={handleDepartStop}
                    className="electric-cta flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold text-white cursor-pointer"
                  >
                    <FastForward className="h-3.5 w-3.5" />
                    <span>Force Depart / Next Stop</span>
                  </button>
                </div>
              )}
            </div>
          </div>

          {/* Cabin Controls */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex items-center gap-2 mb-3.5">
              <Users className="h-4 w-4 text-[#4F46E5] dark:text-cyan-300" />
              <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                Driver Telemetry &amp; Safety Actions
              </h3>
            </div>

            <div className="flex flex-wrap gap-2.5">
              <button
                type="button"
                onClick={toggleLivePhoneGps}
                className={`tactile-btn inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold transition cursor-pointer ${
                  livePhoneGpsActive
                    ? 'bg-emerald-100 text-emerald-800 ring-1 ring-emerald-500/40 dark:bg-emerald-950/60 dark:text-emerald-300'
                    : 'border border-slate-200 bg-[#F7F9FF] text-slate-800 hover:bg-indigo-50 dark:border-[#2E3646] dark:bg-[#141821] dark:text-white'
                }`}
              >
                <LocateFixed className="h-4 w-4" />
                <span>{livePhoneGpsActive ? 'Phone GPS: ON' : 'Phone GPS: OFF'}</span>
              </button>

              <button
                type="button"
                onClick={() => setDriverVoiceEnabled(!driverVoiceEnabled)}
                className={`tactile-btn inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold transition cursor-pointer ${
                  driverVoiceEnabled
                    ? 'bg-indigo-100 text-[#4F46E5] ring-1 ring-[#4F46E5]/40 dark:bg-indigo-950/60 dark:text-cyan-300'
                    : 'border border-slate-200 bg-[#F7F9FF] text-slate-800 hover:bg-indigo-50 dark:border-[#2E3646] dark:bg-[#141821] dark:text-white'
                }`}
              >
                {driverVoiceEnabled ? <Volume2 className="h-4 w-4" /> : <VolumeX className="h-4 w-4" />}
                <span>Voice Readouts: {driverVoiceEnabled ? 'ON' : 'OFF'}</span>
              </button>

              {activeBus.status === 'BREAKDOWN_RESCUE_ACTIVE' ? (
                <button
                  type="button"
                  onClick={() => clearBreakdownStatus()}
                  className="tactile-btn inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-bold text-white hover:bg-emerald-700 cursor-pointer"
                >
                  <CheckCircle2 className="h-4 w-4" />
                  <span>Clear Rescue / Resume Run</span>
                </button>
              ) : (
                <button
                  type="button"
                  onClick={() => triggerBreakdownAndRescue()}
                  className="tactile-btn inline-flex items-center gap-1.5 rounded-xl bg-rose-600 px-3.5 py-2 text-xs font-bold text-white shadow-xs hover:bg-rose-700 cursor-pointer"
                >
                  <Wrench className="h-4 w-4" />
                  <span>Breakdown / Rescue Bus</span>
                </button>
              )}
            </div>
          </div>

          {/* NH-163 Warangal Highway Corridor Mode */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div className="flex items-center gap-2.5">
                <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                  <Zap className="h-4 w-4" />
                </span>
                <div>
                  <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                    NH-163 Warangal Highway Corridor Mode
                  </h3>
                  <p className="text-xs text-slate-500 dark:text-slate-400">
                    {activeBus.flyoverBypassActive
                      ? 'Bypassing congested ground traffic over the Uppal-Narapally elevated flyover (-14 min saved).'
                      : 'Operating on ground-level service road for student neighborhood cluster pickup stops.'}
                  </p>
                </div>
              </div>

              <button
                type="button"
                onClick={() => toggleDriverFlyoverBypass()}
                className={`rounded-xl px-4 py-2 text-xs font-extrabold transition cursor-pointer ${
                  activeBus.flyoverBypassActive
                    ? 'bg-emerald-100 text-emerald-800 ring-1 ring-emerald-500/40 dark:bg-emerald-950/60 dark:text-emerald-300'
                    : 'electric-cta text-white'
                }`}
              >
                {activeBus.flyoverBypassActive ? 'Flyover Active (-14 min)' : 'Engage Uppal Flyover Bypass'}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

```

---

## 27. `src/components/portals/AdminDashboard.tsx` <a id="srccomponentsportalsadmindashboardtsx"></a>

**Description:** Prismatic Daylight 3-tab Transport Admin Desk (Verify, Fleet, Logs) with electric pending approvals hero card, 1-click verification queue, fleet matrix, and health/CSV tools.  
**File Path:** `sreenidhi-express/src/components/portals/AdminDashboard.tsx`  

```tsx
import React, { useState, useEffect, useRef } from 'react';
import {
  FileSpreadsheet,
  ShieldCheck,
  LogOut,
  AlertTriangle,
  Bell,
  Trash2,
  PackageSearch,
  Star,
  Download,
  CheckCircle2,
  Send,
  RotateCcw,
  Lock,
  Unlock,
  Navigation,
  Upload,
  Database,
  Key,
  Activity,
  Radio,
  HardDrive,
  Clock,
} from 'lucide-react';
import { useCommuteSimulation } from '../../context/useCommuteSimulation';
import { MetroSchematicMap } from '../map/MetroSchematicMap';
import { excelService } from '../../services/excelService';

const ENABLE_AREA_SKIPPING = import.meta.env.VITE_ENABLE_AREA_SKIPPING === 'true';

interface ScrutinyApplication {
  id: string;
  studentId: string;
  studentName: string;
  rollNumber: string;
  program: string;
  routeId: string;
  requestType: string;
  title: string;
  reason: string;
  status: 'PENDING' | 'PENDING_SCRUTINY' | 'APPROVED' | 'REJECTED';
}

export const AdminDashboard: React.FC = () => {
  const {
    currentUser,
    buses,
    activeBus,
    activeRouteId,
    setActiveRouteId,
    routeOptimizationPlan,
    setClusterOptimizationOverride,
    toggleRoutePlanLock,
    logoutUser,
    downloadMasterExcel,
    pushToast,
  } = useCommuteSimulation();

  const totalFleetBuses = buses.length || 1;
  const onTimeBusesCount = buses.filter((b) => (b.trafficDelayMinutes || 0) <= 5).length;
  const fleetPunctualityPct = Math.round((onTimeBusesCount / totalFleetBuses) * 100);
  const totalDelayMinutes = buses.reduce((acc, b) => acc + (b.trafficDelayMinutes || 0), 0);
  const avgFleetDelayMin = (totalDelayMinutes / totalFleetBuses).toFixed(1);

  const [adminTab, setAdminTab] = useState<'VERIFY' | 'FLEET' | 'LOGS'>('VERIFY');
  const [applications, setApplications] = useState<ScrutinyApplication[]>([]);
  const [scrutinyLoadingId, setScrutinyLoadingId] = useState<string | null>(null);

  // Real-time backend incident queue
  const [incidents, setIncidents] = useState<any[]>([]);
  const [announcements, setAnnouncements] = useState<any[]>([]);
  const [newAnnouncementText, setNewAnnouncementText] = useState('');
  const [newAnnouncementRoute, setNewAnnouncementRoute] = useState('ALL');
  const [isPostingAnnouncement, setIsPostingAnnouncement] = useState(false);

  // Lost and found queue
  const [lostItems, setLostItems] = useState<any[]>([]);

  // Ride feedback
  const [feedbackList, setFeedbackList] = useState<any[]>([]);

  // Bulk Excel Onboarding & Live SQLite Backup State
  const [isImportingRoster, setIsImportingRoster] = useState(false);
  const [bulkImportResult, setBulkImportResult] = useState<{
    createdCount: number;
    skippedExistingCount: number;
    errors: any[];
    credentials: any[];
  } | null>(null);
  const [pendingVerifications, setPendingVerifications] = useState<Array<{
    roll_number: string;
    name: string;
    email: string;
    student_phone: string;
    pickup_stop: string;
    registered_at: string;
    verification_status: string;
  }>>([]);
  const [verifyRouteChoice, setVerifyRouteChoice] = useState<Record<string, string>>({});
  const [verifyingRoll, setVerifyingRoll] = useState<string | null>(null);
  const [isBackupLoading, setIsBackupLoading] = useState(false);
  const [serverHealth, setServerHealth] = useState<{
    activeSseClients: number;
    liveRoutes: number;
    staleRoutes: string[];
    walBytes: number;
    lastBackupFile: string | null;
    lastBackupAt: number | null;
    uptimeSec: number;
    memoryMb: number;
  } | null>(null);
  const [isHealthRefreshing, setIsHealthRefreshing] = useState(false);
  const [reportRouteFilter, setReportRouteFilter] = useState('');
  const [reportDateFilter, setReportDateFilter] = useState('');
  const [isReportLoading, setIsReportLoading] = useState(false);
  const [adminAccounts, setAdminAccounts] = useState<Array<{
    adminId: string;
    name: string;
    active: boolean;
    source: 'ENV' | 'DATABASE';
    createdBy: string | null;
    createdAt: string | null;
  }>>([]);
  const [newAdminId, setNewAdminId] = useState('');
  const [newAdminName, setNewAdminName] = useState('');
  const [newAdminPassword, setNewAdminPassword] = useState('');
  const [isGrantingAdmin, setIsGrantingAdmin] = useState(false);
  const [togglingAdminId, setTogglingAdminId] = useState<string | null>(null);
  const [passwordResetRequests, setPasswordResetRequests] = useState<
    Array<{
      account_roll: string;
      name: string;
      phone_number: string;
      otp: string;
      expires_at: number;
      created_at: number;
    }>
  >([]);
  const [isRefreshingResets, setIsRefreshingResets] = useState(false);
  const [driverUtilityReport, setDriverUtilityReport] = useState<Awaited<ReturnType<typeof excelService.getDriverUtilityLogs>>>({
    logs: [],
    tripStarts: [],
    summary: {
      totalStopsLogged: 0,
      avgDwellSec: 0,
      avgDwellFormatted: '0s',
      maxDwellSec: 0,
      longestStopName: null,
      tooShortCount: 0,
      tooLongCount: 0,
    },
  });
  const fileInputRef = useRef<HTMLInputElement>(null);

  const formatDwellText = (sec: number) => {
    const total = Math.max(0, Math.round(Number(sec) || 0));
    const mins = Math.floor(total / 60);
    const rem = total % 60;
    return mins > 0 ? `${mins}m ${rem}s` : `${rem}s`;
  };

  const fetchDriverUtilityReport = async (routeOverride = reportRouteFilter, dateOverride = reportDateFilter) => {
    setIsReportLoading(true);
    try {
      const report = await excelService.getDriverUtilityLogs(
        routeOverride || undefined,
        dateOverride || undefined
      );
      setDriverUtilityReport(report);
    } finally {
      setIsReportLoading(false);
    }
  };

  const fetchHealth = async () => {
    setIsHealthRefreshing(true);
    try {
      const data = await excelService.getAdminHealth();
      if (data) setServerHealth(data);
    } catch {
      // Ignore
    } finally {
      setIsHealthRefreshing(false);
    }
  };

  const reloadData = async () => {
    void fetchHealth();
    const incs = await excelService.fetchIncidents(false);
    setIncidents(incs);
    const anns = await excelService.fetchAnnouncements();
    setAnnouncements(anns);
    const lost = await excelService.fetchLostItems(false);
    setLostItems(lost);
    const fb = await excelService.fetchFeedback();
    setFeedbackList(fb);
    const liveApps = await excelService.fetchApplications();
    if (Array.isArray(liveApps)) {
      setApplications(
        liveApps.map((a: any) => ({
          id: a.id,
          studentId: `stu-${a.roll_number || a.roll || a.rollNumber || '01'}`,
          studentName: a.student_name || a.name || a.studentName || 'Student',
          rollNumber: a.roll_number || a.roll || a.rollNumber || '',
          program: a.program || 'B.Tech Undergrad',
          routeId: a.route_id || a.routeId || 'route-51',
          requestType: a.request_type || a.requestType || 'ROUTE_CHANGE',
          title: a.title || 'Transport Service Request',
          reason: a.description || a.reason || '',
          status: a.status === 'PENDING_SCRUTINY' ? 'PENDING' : (a.status || 'PENDING'),
        }))
      );
    }
    const pv = await excelService.listPendingVerifications();
    setPendingVerifications(pv);
    setVerifyRouteChoice((prev) => {
      const next = { ...prev };
      for (const row of pv) {
        if (!next[row.roll_number]) next[row.roll_number] = 'route-51';
      }
      return next;
    });
    const adminsList = await excelService.listAdminUsers();
    setAdminAccounts(adminsList);
    const resetReqs = await excelService.getPasswordResetRequests();
    setPasswordResetRequests(resetReqs);
  };

  const refreshPasswordResetRequests = async () => {
    setIsRefreshingResets(true);
    try {
      const resetReqs = await excelService.getPasswordResetRequests();
      setPasswordResetRequests(resetReqs);
    } finally {
      setIsRefreshingResets(false);
    }
  };

  const handleGrantAdminAccess = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newAdminId.trim() || !newAdminPassword) return;
    setIsGrantingAdmin(true);
    try {
      const res = await excelService.grantAdminAccess({
        adminId: newAdminId.trim(),
        name: newAdminName.trim() || newAdminId.trim(),
        password: newAdminPassword,
      });
      if (res.success && res.admin) {
        pushToast('success', 'Admin Access Granted', `${res.admin.adminId} can now sign in with their credentials.`);
        setNewAdminId('');
        setNewAdminName('');
        setNewAdminPassword('');
        const adminsList = await excelService.listAdminUsers();
        setAdminAccounts(adminsList);
      } else {
        pushToast('danger', 'Grant Failed', res.message || 'Could not create admin access account.');
      }
    } finally {
      setIsGrantingAdmin(false);
    }
  };

  const handleToggleAdminStatus = async (adminId: string, nextActive: boolean) => {
    setTogglingAdminId(adminId);
    try {
      const res = await excelService.setAdminAccessStatus(adminId, nextActive);
      if (res.success) {
        pushToast(
          nextActive ? 'success' : 'warning',
          nextActive ? 'Admin Restored' : 'Admin Revoked',
          `${adminId} access has been ${nextActive ? 'restored' : 'revoked'}.`
        );
        const adminsList = await excelService.listAdminUsers();
        setAdminAccounts(adminsList);
      } else {
        pushToast('danger', 'Update Failed', res.message || 'Could not update admin access status.');
      }
    } finally {
      setTogglingAdminId(null);
    }
  };

  const handleVerifyRegistration = async (rollNumber: string, approved: boolean) => {
    setVerifyingRoll(rollNumber);
    const chosenRoute = verifyRouteChoice[rollNumber] || 'route-51';
    try {
      const res = await excelService.verifyStudentRegistration(rollNumber, {
        approved,
        routeId: approved ? chosenRoute : undefined,
      });
      if (res.success) {
        pushToast(
          approved ? 'success' : 'warning',
          approved ? 'Rider Verified' : 'Registration Rejected',
          approved
            ? `${rollNumber} approved and assigned to ${chosenRoute}.`
            : `${rollNumber} rejected from active boarding manifest.`
        );
        await reloadData();
      } else {
        pushToast('danger', 'Verification Failed', res.message || 'Could not update student status.');
      }
    } finally {
      setVerifyingRoll(null);
    }
  };

  useEffect(() => {
    void reloadData();
  }, []);

  useEffect(() => {
    let active = true;
    const loadReport = async () => {
      setIsReportLoading(true);
      try {
        const report = await excelService.getDriverUtilityLogs(
          reportRouteFilter || undefined,
          reportDateFilter || undefined
        );
        if (active) setDriverUtilityReport(report);
      } finally {
        if (active) setIsReportLoading(false);
      }
    };
    void loadReport();
    return () => {
      active = false;
    };
  }, [reportRouteFilter, reportDateFilter]);

  const handleResolveIncident = async (id: number) => {
    const ok = await excelService.resolveIncident(id);
    if (ok) {
      pushToast('success', 'Incident Resolved', `Incident #${id} marked as resolved and archived.`);
      void reloadData();
    }
  };

  const handlePostAnnouncement = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newAnnouncementText.trim()) return;
    setIsPostingAnnouncement(true);
    const ok = await excelService.createAnnouncement(newAnnouncementText.trim(), newAnnouncementRoute);
    setIsPostingAnnouncement(false);
    if (ok) {
      setNewAnnouncementText('');
      pushToast('success', 'Announcement Broadcasted', 'Message pushed to student & parent feeds.');
      void reloadData();
    }
  };

  const handleDeleteAnnouncement = async (id: number) => {
    const ok = await excelService.deleteAnnouncement(id);
    if (ok) {
      pushToast('info', 'Announcement Retracted', 'Announcement removed from active feeds.');
      void reloadData();
    }
  };

  const handleResolveLost = async (id: number) => {
    const ok = await excelService.resolveLostItem(id);
    if (ok) {
      pushToast('success', 'Lost Item Resolved', `Item #${id} marked as returned to owner.`);
      void reloadData();
    }
  };

  const handleDownloadCsv = async (
    type: 'incidents' | 'feedback' | 'absences' | 'lost' | 'boardings' | 'driver_utility',
    filters?: { routeId?: string; date?: string }
  ) => {
    try {
      await excelService.downloadCsvExport(type, filters);
      pushToast('success', 'CSV Downloaded', `${type.toUpperCase()} records exported for Excel.`);
    } catch (err: any) {
      pushToast('danger', 'Export Failed', err?.message || 'Could not download CSV export.');
    }
  };

  const handleBulkFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsImportingRoster(true);
    try {
      // Dynamically import SheetJS so it stays in its own vendor chunk and never inflates mobile bundle
      const XLSX = await import('xlsx');
      const buffer = await file.arrayBuffer();
      const workbook = XLSX.read(buffer, { type: 'array' });
      const firstSheetName = workbook.SheetNames[0];
      const sheet = workbook.Sheets[firstSheetName];
      const rawRows: any[] = XLSX.utils.sheet_to_json(sheet);

      if (!rawRows || rawRows.length === 0) {
        pushToast('warning', 'Empty Sheet', 'No data rows found in the uploaded workbook.');
        setIsImportingRoster(false);
        return;
      }

      const mappedRiders = rawRows.map((r) => {
        const getVal = (...keys: string[]) => {
          for (const k of keys) {
            for (const rowKey of Object.keys(r)) {
              if (rowKey.trim().toLowerCase() === k.toLowerCase()) {
                return String(r[rowKey] ?? '').trim();
              }
            }
          }
          return '';
        };

        const rollNumber = getVal('Roll Number', 'roll_number', 'rollNumber', 'Employee ID', 'ID', 'Roll No');
        const name = getVal('Name', 'Student Name', 'student_name', 'Employee Name', 'Full Name');
        const program = getVal('Program', 'Department', 'Designation', 'Branch', 'Course');
        const routeId = getVal('Route', 'Route ID', 'route_id', 'routeId', 'Bus Route');
        const pickupStop = getVal('Stop', 'Pickup Stop', 'pickup_stop', 'pickupStop', 'Boarding Point', 'Stage');
        const parentPhone = getVal('Parent Phone', 'parent_phone', 'parentPhone', 'Mobile', 'Phone', 'Contact');
        const riderType = getVal('Rider Type', 'rider_type', 'riderType', 'Category', 'Role');

        return {
          rollNumber,
          name,
          program: program || 'Engineering',
          routeId: routeId || 'route-51',
          pickupStop: pickupStop || 'Campus',
          parentPhone: parentPhone || '+91 00000 00000',
          riderType: riderType.toUpperCase().includes('FACULTY') ? 'FACULTY' : 'STUDENT',
        };
      });

      const res = await excelService.bulkImportStudents(mappedRiders);
      if (res.success) {
        setBulkImportResult(res);
        pushToast(
          'success',
          'Roster Onboarded',
          `Created ${res.createdCount} new accounts (${res.skippedExistingCount} existing skipped).`
        );
      } else {
        pushToast('danger', 'Import Failed', res.errors?.[0]?.error || 'Failed to import roster.');
      }
    } catch (err: any) {
      console.error('Bulk import error:', err);
      pushToast('danger', 'Import Error', err?.message || 'Could not parse spreadsheet file.');
    } finally {
      setIsImportingRoster(false);
      e.target.value = '';
    }
  };

  const handleDownloadPinsCsv = () => {
    if (!bulkImportResult || !bulkImportResult.credentials || bulkImportResult.credentials.length === 0) {
      return;
    }
    const headers = ['Roll Number / ID', 'Name', 'Route', 'Pickup Stop', 'Rider Type', 'Temporary Password / PIN'];
    const rows = bulkImportResult.credentials.map((c) => [
      c.rollNumber,
      c.name,
      c.routeId,
      c.pickupStop,
      c.riderType,
      c.temporaryPassword,
    ]);
    const esc = (s: any) => {
      let strVal = String(s ?? '');
      if (/^[=+\-@\t\r]/.test(strVal)) strVal = "'" + strVal;
      return /[",\n\r]/.test(strVal) ? `"${strVal.replace(/"/g, '""')}"` : strVal;
    };
    const csvContent = [headers.map(esc).join(','), ...rows.map((r) => r.map(esc).join(','))].join('\r\n') + '\r\n';
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `sreenidhi_onboarding_pins_${Date.now()}.csv`;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => {
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 150);
  };

  const handleCreateBackup = async () => {
    setIsBackupLoading(true);
    try {
      const res = await excelService.createDatabaseBackup();
      if (res.success) {
        pushToast('success', 'WAL Backup Created', `Saved ${res.fileName} (${res.backupCount} backups stored).`);
        void fetchHealth();
      } else {
        pushToast('danger', 'Backup Failed', 'Could not create SQLite backup snapshot.');
      }
    } catch {
      pushToast('danger', 'Backup Error', 'Server backup endpoint unreachable.');
    } finally {
      setIsBackupLoading(false);
    }
  };

  const handleStatusChange = async (id: string, newStatus: 'APPROVED' | 'REJECTED') => {
    setScrutinyLoadingId(id);
    try {
      const ok = await excelService.reviewApplication(id, newStatus, 'Reviewed by Transport Incharge');
      if (ok) {
        setApplications((prev) =>
          prev.map((app) => (app.id === id ? { ...app, status: newStatus } : app))
        );
        pushToast(
          newStatus === 'APPROVED' ? 'success' : 'info',
          `Application ${newStatus}`,
          `Application ${id} status saved to transport database.`
        );
      } else {
        pushToast('danger', 'Review Failed', `Could not update scrutiny status for ${id}.`);
      }
    } finally {
      setScrutinyLoadingId(null);
    }
  };

  const activeIncidentsCount = incidents.filter((i) => i.open).length;

  return (
    <div className="mx-auto w-full max-w-5xl space-y-4 sm:space-y-5 pb-16 antialiased">
      {/* Compact Header */}
      <div className="prismatic-card flex flex-wrap items-center justify-between gap-3 rounded-3xl p-3.5 sm:p-4">
        <div className="flex items-center gap-3 min-w-[220px] flex-1">
          <div className="rounded-full bg-gradient-to-br from-[#4F46E5] to-[#06B6D4] p-0.5 shadow-sm shrink-0">
            <img
              src="/sreenidhi_express_logo.jpg"
              alt="Sreenidhi Express Logo"
              className="h-10 w-10 rounded-full object-cover"
            />
          </div>
          <div className="min-w-0">
            <div className="flex items-center gap-2 flex-wrap">
              <h1 className="text-sm sm:text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
                Transport Admin
              </h1>
              <span className="inline-flex items-center gap-1 rounded-full border border-indigo-200/80 bg-indigo-50/90 px-2.5 py-0.5 text-[11px] font-bold text-[#4F46E5] dark:border-indigo-700/50 dark:bg-indigo-950/60 dark:text-cyan-300">
                <span className="h-1.5 w-1.5 rounded-full bg-[#06B6D4] animate-pulse" />
                {activeBus?.routeNumber || 'Route 51'} Pilot
              </span>
            </div>
            <p className="text-[11px] text-slate-500 dark:text-slate-400 truncate">
              Officer: <b>{currentUser?.name || 'Transport Incharge'}</b> • <code className="font-mono">{currentUser?.id || 'SNIST-ADM-01'}</code>
            </p>
          </div>
        </div>

        {/* Right Actions: Master Excel & Logout */}
        <div className="flex flex-wrap items-center gap-2 shrink-0">
          <button
            type="button"
            onClick={downloadMasterExcel}
            className="electric-cta flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold text-white cursor-pointer"
          >
            <FileSpreadsheet className="h-3.5 w-3.5" />
            <span>Master Excel (.xlsx)</span>
          </button>

          <button
            type="button"
            onClick={logoutUser}
            className="tactile-btn flex h-9 w-9 items-center justify-center rounded-full border border-slate-200/80 bg-[#F7F9FF] text-slate-600 transition hover:bg-rose-50 hover:text-rose-600 dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-300 dark:hover:bg-rose-950/40 dark:hover:text-rose-400 cursor-pointer"
            title="Sign Out"
          >
            <LogOut className="h-4 w-4" />
          </button>
        </div>
      </div>

      {/* 3-Tab Sub-Navigation */}
      <div className="prismatic-card grid grid-cols-3 gap-1.5 rounded-2xl p-1">
        {(
          [
            { id: 'VERIFY', label: 'Verify' },
            { id: 'FLEET', label: 'Fleet' },
            { id: 'LOGS', label: 'Logs' },
          ] as const
        ).map(({ id, label }) => (
          <button
            key={id}
            type="button"
            onClick={() => setAdminTab(id)}
            className={`tactile-btn rounded-xl py-2 text-xs font-extrabold transition cursor-pointer ${
              adminTab === id
                ? 'bg-gradient-to-r from-[#4F46E5] to-[#06B6D4] text-white shadow-sm shadow-indigo-500/20'
                : 'text-slate-500 hover:bg-indigo-50/70 hover:text-[#4F46E5] dark:text-slate-400 dark:hover:text-white'
            }`}
          >
            {label}
          </button>
        ))}
      </div>

      {adminTab === 'VERIFY' && (
        <div className="animate-panel-in space-y-4">
          {/* Electric Indigo -> Cyan Summary Hero Card */}
          <div className="electric-hero rounded-3xl p-5 text-white">
            <div className="bg-futuristic-grid pointer-events-none absolute inset-0 opacity-25" />

            <div className="relative flex flex-wrap items-start justify-between gap-3">
              <div>
                <p className="text-[11px] font-semibold text-indigo-100/90">Pending Approvals:</p>
                <p className="font-mono-timer mt-0.5 text-3xl sm:text-4xl font-black tracking-tight text-white">
                  {pendingVerifications.length}
                </p>
              </div>

              <div className="text-right">
                <span className="inline-flex items-center rounded-full bg-white/18 px-3 py-1 text-[11px] font-bold text-white ring-1 ring-white/25 backdrop-blur-xs">
                  Active Buses: {buses.length} • On-Time: {fleetPunctualityPct}%
                </span>
                <p className="mt-1.5 text-[11px] font-medium text-cyan-100/95">
                  Avg Delay: {avgFleetDelayMin}m • {activeIncidentsCount} Open Incident(s)
                </p>
              </div>
            </div>

            <button
              type="button"
              onClick={() =>
                void handleDownloadCsv('driver_utility', {
                  routeId: reportRouteFilter || undefined,
                  date: reportDateFilter || undefined,
                })
              }
              className="animate-electric-sheen tactile-btn relative mt-4 flex w-full items-center justify-center gap-2 overflow-hidden rounded-xl bg-white py-2.5 text-xs font-extrabold text-[#4F46E5] shadow-md transition hover:bg-indigo-50 cursor-pointer"
            >
              <Download className="h-4 w-4" />
              <span>Export Driver Utility CSV</span>
            </button>
          </div>

          {/* Pending Verifications Card */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3.5 dark:border-[#2E3646]">
              <div>
                <h3 className="text-sm font-extrabold text-slate-900 dark:text-white">
                  Pending Verifications (Self-Signup Desk)
                </h3>
                <p className="text-[11px] text-slate-500 dark:text-slate-400">
                  Verify new riders with 1 click and assign them to an active route.
                </p>
              </div>
              <button
                type="button"
                onClick={() => void reloadData()}
                className="text-xs font-bold text-[#4F46E5] hover:underline dark:text-cyan-300 cursor-pointer"
              >
                Refresh Queue
              </button>
            </div>

            <div className="mt-3.5 space-y-2.5">
              {pendingVerifications.length === 0 ? (
                <p className="rounded-2xl border border-dashed border-indigo-200/80 p-4 text-center text-xs italic text-slate-500 dark:border-[#2E3646] dark:text-slate-400">
                  No pending self-registrations awaiting Transport Office verification.
                </p>
              ) : (
                pendingVerifications.map((stu) => (
                  <div
                    key={stu.roll_number}
                    className="prismatic-subcard flex flex-wrap items-center justify-between gap-3 rounded-2xl p-3.5"
                  >
                    <div className="min-w-0 flex-1">
                      <p className="font-mono text-xs font-black text-[#4F46E5] dark:text-cyan-300 truncate">
                        {stu.roll_number} • <span className="font-sans font-bold text-slate-900 dark:text-white">{stu.pickup_stop || 'Unassigned'}</span>
                      </p>
                      <p className="mt-0.5 text-xs font-bold text-slate-900 dark:text-white">
                        {stu.name}
                      </p>
                      <p className="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400 truncate">
                        {stu.email} • Phone: <span className="font-mono">{stu.student_phone || 'N/A'}</span>
                      </p>
                    </div>

                    <div className="flex flex-wrap items-center gap-2">
                      <select
                        aria-label={`Assign route for ${stu.roll_number}`}
                        value={verifyRouteChoice[stu.roll_number] || 'route-51'}
                        onChange={(e) =>
                          setVerifyRouteChoice((prev) => ({ ...prev, [stu.roll_number]: e.target.value }))
                        }
                        className="rounded-xl border border-slate-200/80 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#1E2430] dark:text-white"
                      >
                        {buses.map((b) => (
                          <option key={b.routeId} value={b.routeId}>
                            {b.routeNumber} ({b.routeName})
                          </option>
                        ))}
                      </select>
                      <button
                        type="button"
                        disabled={verifyingRoll === stu.roll_number}
                        onClick={() => void handleVerifyRegistration(stu.roll_number, true)}
                        className="tactile-btn inline-flex items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-extrabold text-emerald-700 hover:bg-emerald-100 disabled:opacity-50 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 cursor-pointer"
                        title="Approve & assign route"
                      >
                        ✓
                      </button>
                      <button
                        type="button"
                        disabled={verifyingRoll === stu.roll_number}
                        onClick={() => void handleVerifyRegistration(stu.roll_number, false)}
                        className="tactile-btn inline-flex items-center justify-center rounded-xl border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-extrabold text-rose-700 hover:bg-rose-100 disabled:opacity-50 dark:border-rose-800 dark:bg-rose-950/60 dark:text-rose-300 cursor-pointer"
                        title="Reject registration"
                      >
                        ✕
                      </button>
                    </div>
                  </div>
                ))
              )}
            </div>

            {passwordResetRequests.length > 0 && (
              <div className="mt-4 border-t border-slate-100 pt-3.5 dark:border-[#2E3646]">
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <div className="flex items-center gap-2">
                    <Key className="h-3.5 w-3.5 text-[#4F46E5] dark:text-cyan-300" />
                    <h4 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                      Active Password Reset Codes
                    </h4>
                  </div>
                  <button
                    type="button"
                    onClick={() => void refreshPasswordResetRequests()}
                    disabled={isRefreshingResets}
                    className="text-[11px] font-bold text-[#4F46E5] hover:underline disabled:opacity-50 dark:text-cyan-300 cursor-pointer"
                  >
                    {isRefreshingResets ? 'Refreshing…' : 'Refresh'}
                  </button>
                </div>

                <div className="mt-2.5 space-y-2">
                  {passwordResetRequests.map((req) => {
                    const minsRemaining = Math.max(1, Math.ceil((req.expires_at - Date.now()) / 60000));
                    return (
                      <div
                        key={req.account_roll}
                        className="prismatic-subcard flex flex-wrap items-center justify-between gap-2.5 rounded-2xl px-3.5 py-2.5"
                      >
                        <div className="min-w-0 flex-1">
                          <p className="text-xs font-bold text-slate-900 dark:text-white truncate">
                            <span className="font-mono font-black text-[#4F46E5] dark:text-cyan-300">
                              {req.account_roll}
                            </span>
                            {req.name ? ` • ${req.name}` : ''}
                          </p>
                          <p className="text-[10px] text-slate-500 dark:text-slate-400">
                            Expires in {minsRemaining} min • Verify ID before sharing
                          </p>
                        </div>
                        <span className="rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-1 font-mono text-sm font-black tracking-widest text-[#4F46E5] dark:border-indigo-700/60 dark:bg-indigo-950/60 dark:text-cyan-300">
                          {req.otp}
                        </span>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>

          {/* Detailed Timestamps & Stop Duration Report Panel */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3.5 dark:border-[#2E3646]">
              <div>
                <div className="flex items-center gap-2">
                  <Clock className="h-4 w-4 text-[#4F46E5] dark:text-cyan-300" />
                  <h3 className="text-sm font-extrabold text-slate-900 dark:text-white">
                    Detailed Timestamps &amp; Stop Duration Report
                  </h3>
                </div>
                <p className="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                  Live stop arrivals, departures, scheduled-vs-actual variance &amp; stopping durations (IST).
                </p>
              </div>

              <div className="flex flex-wrap items-center gap-2">
                <select
                  aria-label="Filter report by route"
                  value={reportRouteFilter}
                  onChange={(e) => setReportRouteFilter(e.target.value)}
                  className="rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-2.5 py-1.5 text-xs font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                >
                  <option value="">All Routes</option>
                  <option value="route-51">Route 51</option>
                  <option value="route-14">Route 14</option>
                </select>

                <input
                  aria-label="Filter report by date"
                  type="date"
                  value={reportDateFilter}
                  onChange={(e) => setReportDateFilter(e.target.value)}
                  className="rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-2.5 py-1.5 text-xs font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                />

                {reportDateFilter && (
                  <button
                    type="button"
                    onClick={() => setReportDateFilter('')}
                    className="tactile-btn rounded-xl border border-indigo-200 bg-indigo-50 px-2.5 py-1.5 text-[11px] font-bold text-[#4F46E5] hover:bg-indigo-100 dark:border-indigo-800 dark:bg-indigo-950/60 dark:text-cyan-300 cursor-pointer"
                  >
                    All Dates
                  </button>
                )}

                <button
                  type="button"
                  onClick={() => void fetchDriverUtilityReport()}
                  disabled={isReportLoading}
                  className="tactile-btn inline-flex items-center gap-1 rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-2.5 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-[#4F46E5] disabled:opacity-50 dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200 cursor-pointer"
                >
                  <RotateCcw className={`h-3.5 w-3.5 ${isReportLoading ? 'animate-spin' : ''}`} />
                  <span>Refresh</span>
                </button>

                <button
                  type="button"
                  onClick={() =>
                    void handleDownloadCsv('driver_utility', {
                      routeId: reportRouteFilter || undefined,
                      date: reportDateFilter || undefined,
                    })
                  }
                  className="electric-cta inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-bold text-white cursor-pointer"
                >
                  <Download className="h-3.5 w-3.5" />
                  <span>Export Timestamp CSV</span>
                </button>
              </div>
            </div>

            {/* 4 Compact KPI Summary Cards */}
            <div className="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
              <div className="prismatic-subcard rounded-2xl p-3">
                <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Stops Logged
                </p>
                <p className="font-mono-timer mt-1 text-lg font-black text-slate-900 dark:text-white">
                  {driverUtilityReport.summary.totalStopsLogged}
                </p>
              </div>

              <div className="prismatic-subcard rounded-2xl p-3">
                <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Avg Stop Duration
                </p>
                <p className="font-mono-timer mt-1 text-lg font-black text-[#4F46E5] dark:text-cyan-300">
                  {driverUtilityReport.summary.avgDwellFormatted}
                </p>
              </div>

              <div className="prismatic-subcard rounded-2xl p-3">
                <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Longest Stop
                </p>
                <p className="mt-1 truncate text-xs font-extrabold text-slate-900 dark:text-white">
                  {driverUtilityReport.summary.longestStopName
                    ? `${driverUtilityReport.summary.longestStopName} (${formatDwellText(driverUtilityReport.summary.maxDwellSec)})`
                    : '—'}
                </p>
              </div>

              <div className="prismatic-subcard rounded-2xl p-3">
                <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Flagged Stops
                </p>
                <p className="mt-1 text-xs font-extrabold text-slate-800 dark:text-slate-200">
                  Too Short: <span className="text-amber-600 dark:text-amber-400">{driverUtilityReport.summary.tooShortCount}</span> • Too Long:{' '}
                  <span className="text-rose-600 dark:text-rose-400">{driverUtilityReport.summary.tooLongCount}</span>
                </p>
              </div>
            </div>

            {/* Latest Trip Starts Strip */}
            {driverUtilityReport.tripStarts.length > 0 && (
              <div className="mt-3 flex flex-wrap items-center gap-2">
                {driverUtilityReport.tripStarts.map((trip) => (
                  <div
                    key={trip.route_id}
                    className="prismatic-subcard inline-flex flex-wrap items-center gap-2 rounded-2xl px-3 py-1.5 text-[11px]"
                  >
                    <span className="font-mono font-black uppercase text-[#4F46E5] dark:text-cyan-300">
                      {trip.route_id}
                    </span>
                    <span className="text-slate-600 dark:text-slate-300">
                      Started at <b>{trip.started_at_ist || trip.started_at}</b>
                    </span>
                    <span
                      className={`rounded-full px-2 py-0.5 text-[10px] font-extrabold ${
                        trip.running
                          ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300'
                          : 'bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300'
                      }`}
                    >
                      {trip.running ? 'ACTIVE' : 'COMPLETED'}
                    </span>
                    <span className="font-semibold text-slate-700 dark:text-slate-300">
                      Headcount: {trip.headcount || 0}
                    </span>
                  </div>
                ))}
              </div>
            )}

            {/* Detailed Timestamp & Stopping Duration Table */}
            {driverUtilityReport.logs.length === 0 ? (
              <p className="mt-4 rounded-2xl border border-dashed border-indigo-200/80 p-4 text-center text-xs italic text-slate-500 dark:border-[#2E3646] dark:text-slate-400">
                No stop timestamps recorded for this filter yet. Start a trip in the Driver Console and pass a stop geofence (or tap Depart Stop) to log live arrival, departure, and stopping duration.
              </p>
            ) : (
              <div className="mt-4 overflow-x-auto rounded-2xl border border-slate-200/80 dark:border-[#2E3646]">
                <table className="w-full min-w-[740px] text-left text-xs">
                  <thead className="bg-[#F7F9FF] text-[11px] font-extrabold uppercase tracking-wider text-slate-600 dark:bg-[#141821] dark:text-slate-300 border-b border-slate-200/80 dark:border-[#2E3646]">
                    <tr>
                      <th className="px-3 py-2.5">Route</th>
                      <th className="px-3 py-2.5">Stop</th>
                      <th className="px-3 py-2.5">Scheduled (IST)</th>
                      <th className="px-3 py-2.5">Arrived (IST)</th>
                      <th className="px-3 py-2.5">Departed (IST)</th>
                      <th className="px-3 py-2.5">Stop Duration</th>
                      <th className="px-3 py-2.5">Variance</th>
                      <th className="px-3 py-2.5">Flag</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100 bg-white dark:divide-[#2E3646] dark:bg-[#1E2430]">
                    {driverUtilityReport.logs.map((row) => {
                      const delay = row.delay_minutes;
                      const varianceBadge =
                        delay === null || delay === undefined ? (
                          <span className="text-slate-400">—</span>
                        ) : delay >= -2 && delay <= 2 ? (
                          <span className="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-extrabold text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
                            On Time
                          </span>
                        ) : delay > 2 ? (
                          <span
                            className={`rounded-full px-2 py-0.5 text-[10px] font-extrabold ${
                              delay > 10
                                ? 'bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300'
                                : 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300'
                            }`}
                          >
                            +{delay} min
                          </span>
                        ) : (
                          <span className="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-extrabold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                            {delay} min
                          </span>
                        );

                      const flagClass =
                        row.flag === 'TOO_SHORT'
                          ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300'
                          : row.flag === 'TOO_LONG'
                          ? 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300'
                          : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';

                      return (
                        <tr key={row.id} className="hover:bg-[#F7F9FF]/70 dark:hover:bg-[#242B38]/60">
                          <td className="px-3 py-2 font-mono font-bold uppercase text-[#4F46E5] dark:text-cyan-300 whitespace-nowrap">
                            {row.route_id}
                          </td>
                          <td className="px-3 py-2 font-bold text-slate-900 dark:text-white">
                            {row.stop_name}
                          </td>
                          <td className="px-3 py-2 font-mono text-slate-600 dark:text-slate-300 whitespace-nowrap">
                            {row.scheduled_time || '—'}
                          </td>
                          <td className="px-3 py-2 font-mono text-slate-700 dark:text-slate-200 whitespace-nowrap">
                            {row.arrived_at_ist || row.arrived_at}
                          </td>
                          <td className="px-3 py-2 font-mono text-slate-700 dark:text-slate-200 whitespace-nowrap">
                            {row.departed_at_ist || row.departed_at}
                          </td>
                          <td className="px-3 py-2 font-mono font-extrabold text-slate-900 dark:text-white whitespace-nowrap">
                            {row.dwell_formatted || formatDwellText(row.dwell_sec)}
                          </td>
                          <td className="px-3 py-2 whitespace-nowrap">{varianceBadge}</td>
                          <td className="px-3 py-2 whitespace-nowrap">
                            <span className={`rounded-full px-2 py-0.5 text-[10px] font-extrabold ${flagClass}`}>
                              {row.flag}
                            </span>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </div>

          {/* Master Scrutiny & Approval Workflow */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-[#2E3646]">
              <div className="flex items-center gap-2">
                <ShieldCheck className="h-5 w-5 text-[#4F46E5] dark:text-cyan-300" />
                <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                  Transport Requests &amp; Scrutiny Queue
                </h3>
              </div>
              <span className="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[11px] font-bold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-indigo-300">
                {applications.filter((a) => a.status === 'PENDING' || a.status === 'PENDING_SCRUTINY').length} Pending ({applications.length} Total)
              </span>
            </div>

            <div className="mt-4 space-y-3">
              {applications.length === 0 ? (
                <p className="text-xs text-slate-500 dark:text-slate-400 italic p-4 text-center rounded-2xl border border-dashed border-slate-200 dark:border-[#2E3646]">
                  No pending scrutiny applications found. All special transport requests are cleared.
                </p>
              ) : (
                applications.map((app) => (
                  <div
                    key={app.id}
                    className="prismatic-subcard flex flex-wrap items-center justify-between gap-3 rounded-2xl p-4"
                  >
                    <div>
                      <div className="flex items-center gap-2 flex-wrap">
                        <span className="font-mono text-xs font-black text-[#4F46E5] dark:text-cyan-300">
                          {app.id}
                        </span>
                        <span className="font-bold text-xs text-slate-900 dark:text-white">
                          {app.studentName} ({app.rollNumber})
                        </span>
                        <span className="rounded-md bg-white px-2 py-0.5 text-[10px] font-bold text-slate-500 dark:bg-[#1E2430] dark:text-slate-400">
                          {app.requestType.replace(/_/g, ' ')}
                        </span>
                      </div>
                      <p className="mt-1 text-xs font-semibold text-slate-900 dark:text-white">
                        {app.title}
                      </p>
                      <p className="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                        {app.reason}
                      </p>
                    </div>

                    <div className="flex items-center gap-2">
                      {app.status === 'PENDING' || app.status === 'PENDING_SCRUTINY' ? (
                        <>
                          <button
                            type="button"
                            disabled={scrutinyLoadingId === app.id}
                            onClick={() => handleStatusChange(app.id, 'APPROVED')}
                            className="electric-cta rounded-xl px-3 py-1.5 text-xs font-bold text-white disabled:opacity-50 cursor-pointer"
                          >
                            {scrutinyLoadingId === app.id ? 'Saving...' : 'Approve'}
                          </button>
                          <button
                            type="button"
                            disabled={scrutinyLoadingId === app.id}
                            onClick={() => handleStatusChange(app.id, 'REJECTED')}
                            className="tactile-btn rounded-xl border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-bold text-rose-700 hover:bg-rose-100 dark:border-rose-800 dark:bg-rose-950/40 dark:text-rose-300 disabled:opacity-50 cursor-pointer"
                          >
                            {scrutinyLoadingId === app.id ? 'Saving...' : 'Reject'}
                          </button>
                        </>
                      ) : (
                        <span
                          className={`rounded-xl px-3 py-1 text-xs font-bold ${
                            app.status === 'APPROVED'
                              ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300'
                              : 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300'
                          }`}
                        >
                          {app.status}
                        </span>
                      )}
                    </div>
                  </div>
                ))
              )}
            </div>
          </div>

          {/* Authorized Admin Access Management */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3.5 dark:border-[#2E3646]">
              <div>
                <div className="flex items-center gap-2">
                  <Key className="h-4 w-4 text-[#4F46E5] dark:text-cyan-300" />
                  <h3 className="text-sm font-extrabold text-slate-900 dark:text-white">
                    Authorized Admin Access Accounts
                  </h3>
                </div>
                <p className="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                  Grant Admin portal login credentials to additional HODs, supervisors, or coordinators.
                </p>
              </div>
              <span className="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[11px] font-bold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                {adminAccounts.filter((a) => a.active).length} Active
              </span>
            </div>

            <form onSubmit={handleGrantAdminAccess} className="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-4">
              <input
                type="text"
                value={newAdminId}
                onChange={(e) => setNewAdminId(e.target.value)}
                placeholder="Admin ID / Email"
                className="rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-2 text-xs font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                required
              />
              <input
                type="text"
                value={newAdminName}
                onChange={(e) => setNewAdminName(e.target.value)}
                placeholder="Full Name (e.g. HOD CSE)"
                className="rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-2 text-xs font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                required
              />
              <input
                type="password"
                value={newAdminPassword}
                onChange={(e) => setNewAdminPassword(e.target.value)}
                placeholder="Password (min 8 chars)"
                minLength={8}
                className="rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-2 text-xs font-semibold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                required
              />
              <button
                type="submit"
                disabled={isGrantingAdmin}
                className="electric-cta rounded-xl px-3.5 py-2 text-xs font-extrabold text-white disabled:opacity-50 cursor-pointer"
              >
                {isGrantingAdmin ? 'Granting...' : 'Grant Admin Access'}
              </button>
            </form>

            {adminAccounts.length > 0 && (
              <div className="mt-4 space-y-2">
                {adminAccounts.map((adm) => {
                  const isSelf =
                    adm.adminId.toUpperCase() === String(currentUser?.id || '').toUpperCase();
                  return (
                    <div
                      key={`${adm.source}-${adm.adminId}`}
                      className="prismatic-subcard flex flex-wrap items-center justify-between gap-2.5 rounded-2xl px-3.5 py-2.5"
                    >
                      <div className="min-w-0">
                        <div className="flex flex-wrap items-center gap-2">
                          <span className="font-mono text-xs font-black text-[#4F46E5] dark:text-cyan-300">
                            {adm.adminId}
                          </span>
                          <span className="text-xs font-bold text-slate-900 dark:text-white">
                            {adm.name}
                          </span>
                          <span className="rounded-full bg-slate-200/80 px-2 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                            {adm.source}
                          </span>
                          <span
                            className={`rounded-full px-2 py-0.5 text-[10px] font-extrabold ${
                              adm.active
                                ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300'
                                : 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300'
                            }`}
                          >
                            {adm.active ? 'ACTIVE' : 'REVOKED'}
                          </span>
                        </div>
                        {adm.createdBy && (
                          <p className="mt-0.5 text-[10px] text-slate-500 dark:text-slate-400">
                            Granted by {adm.createdBy}
                          </p>
                        )}
                      </div>

                      {adm.source === 'DATABASE' && (
                        <button
                          type="button"
                          disabled={togglingAdminId === adm.adminId || (adm.active && isSelf)}
                          onClick={() => void handleToggleAdminStatus(adm.adminId, !adm.active)}
                          className={`tactile-btn rounded-xl px-3 py-1 text-[11px] font-extrabold disabled:opacity-45 cursor-pointer ${
                            adm.active
                              ? 'border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 dark:border-rose-800 dark:bg-rose-950/40 dark:text-rose-300'
                              : 'border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300'
                          }`}
                        >
                          {adm.active ? (isSelf ? 'Current Session' : 'Revoke') : 'Restore'}
                        </button>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      )}

      {adminTab === 'FLEET' && (
        <div className="animate-panel-in space-y-4">
          {/* Live GPS Fleet Radar Corridor Card */}
          <div className="prismatic-card overflow-hidden rounded-3xl">
            <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 p-3.5 dark:border-[#2E3646]">
              <div className="flex items-center gap-2">
                <span className="h-2 w-2 rounded-full bg-[#06B6D4] shadow-[0_0_8px_rgba(6,182,212,0.85)] animate-pulse" />
                <span className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                  Fleet Radar Overview • {activeBus.routeNumber}
                </span>
              </div>
              <span className="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[10px] font-extrabold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                GPS Live Schematic
              </span>
            </div>

            <div className="p-2.5 sm:p-3 bg-[#F7F9FF] dark:bg-[#141821]">
              <MetroSchematicMap activeBus={activeBus} />
            </div>
          </div>

          {/* Route Selector & Optimization Status / Area Attendance Matrix */}
          {!ENABLE_AREA_SKIPPING ? (
            <div className="prismatic-card rounded-3xl p-4 sm:p-5">
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div className="flex items-center gap-2.5 min-w-0 flex-1">
                  <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                    <Navigation className="h-4 w-4" />
                  </span>
                  <div className="min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <h2 className="text-sm font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                        Fleet Route Status
                      </h2>
                      <span className="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[10px] font-bold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                        {activeRouteId === 'route-51'
                          ? '26 Registered (18 Students • 8 Faculty/Staff)'
                          : `${routeOptimizationPlan?.totalRouteStudents || 0} Registered`}
                      </span>
                    </div>
                    <p className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                      Phase 1 Pilot Policy: Area-skipping is disabled — all stops remain active. Enable via{' '}
                      <code className="font-mono text-[11px] font-semibold text-[#4F46E5] dark:text-cyan-300">
                        VITE_ENABLE_AREA_SKIPPING=true
                      </code>{' '}
                      for Phase 2.
                    </p>
                  </div>
                </div>

                <select
                  aria-label="Select fleet route"
                  value={activeRouteId}
                  onChange={(e) => setActiveRouteId(e.target.value)}
                  className="rounded-xl border border-slate-200 bg-[#F7F9FF] px-3 py-1.5 text-xs font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                >
                  {buses.map((b) => (
                    <option key={b.routeId} value={b.routeId}>
                      {b.routeNumber} ({b.routeName})
                    </option>
                  ))}
                </select>
              </div>
            </div>
          ) : (
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4 dark:border-[#2E3646]">
              <div className="flex items-center gap-2.5">
                <span className="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                  <Navigation className="h-4 w-4" />
                </span>
                <div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <h2 className="text-sm font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                      Route Optimization &amp; Area Attendance Matrix
                    </h2>
                    <span className="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[10px] font-bold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                      {activeRouteId === 'route-51'
                        ? '26 Registered (18 Students • 8 Faculty/Staff)'
                        : `${routeOptimizationPlan?.totalRouteStudents || 0} Registered`}
                    </span>
                  </div>
                  <p className="text-xs text-slate-500 dark:text-slate-400">
                    Bypasses area clusters when 100% of registered riders have active absences.
                  </p>
                </div>
              </div>

              <div className="flex items-center gap-2.5 flex-wrap">
                <select
                  value={activeRouteId}
                  onChange={(e) => setActiveRouteId(e.target.value)}
                  className="rounded-xl border border-slate-200 bg-[#F7F9FF] px-3 py-1.5 text-xs font-bold text-slate-900 focus:border-[#4F46E5] focus:outline-none dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                >
                  {buses.map((b) => (
                    <option key={b.routeId} value={b.routeId}>
                      {b.routeNumber} ({b.routeName})
                    </option>
                  ))}
                </select>

                <button
                  type="button"
                  onClick={() => toggleRoutePlanLock(activeRouteId, !routeOptimizationPlan?.locked)}
                  className={`flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-bold transition cursor-pointer ${
                    routeOptimizationPlan?.locked
                      ? 'bg-amber-100 text-amber-900 border border-amber-300 hover:bg-amber-200 dark:bg-amber-950/60 dark:text-amber-200 dark:border-amber-800'
                      : 'electric-cta text-white'
                  }`}
                >
                  {routeOptimizationPlan?.locked ? (
                    <>
                      <Lock className="h-3.5 w-3.5" />
                      <span>Locked (1h Pre-Departure) — Unlock</span>
                    </>
                  ) : (
                    <>
                      <Unlock className="h-3.5 w-3.5" />
                      <span>Open (Lock Overnight Plan)</span>
                    </>
                  )}
                </button>
              </div>
            </div>

            <div className="mt-4 overflow-x-auto">
              <table className="w-full text-left text-xs">
                <thead>
                  <tr className="border-b border-slate-100 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:border-[#2E3646] dark:text-slate-400">
                    <th className="pb-2">Area Cluster</th>
                    <th className="pb-2">Stops</th>
                    <th className="pb-2 text-center">Registered</th>
                    <th className="pb-2 text-center">Absent</th>
                    <th className="pb-2 text-center">Coming</th>
                    <th className="pb-2 text-center">Status</th>
                    <th className="pb-2 text-right">Admin Override</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-100 dark:divide-[#2E3646]">
                  {(routeOptimizationPlan?.clusters || []).map((cluster: any) => {
                    const isOverridden =
                      Array.isArray(routeOptimizationPlan?.overrideKeepClusters) &&
                      routeOptimizationPlan.overrideKeepClusters.includes(cluster.clusterId);
                    return (
                      <tr key={cluster.clusterId} className="hover:bg-indigo-50/40 dark:hover:bg-white/[0.02]">
                        <td className="py-2.5 font-bold text-slate-900 dark:text-white">
                          {cluster.clusterName}
                        </td>
                        <td className="py-2.5 text-slate-500 dark:text-slate-400">
                          {(cluster.stops || []).map((s: any) => s.shortName || s.name).join(' • ')}
                        </td>
                        <td className="py-2.5 text-center font-mono font-semibold">
                          <div>{cluster.totalRegisteredStudents || cluster.totalStudents}</div>
                          {(cluster.facultyCount > 0 || cluster.studentCount > 0) && (
                            <div className="text-[10px] text-slate-500 dark:text-slate-400">
                              {cluster.studentCount || 0}S • {cluster.facultyCount || 0}F
                            </div>
                          )}
                        </td>
                        <td className="py-2.5 text-center font-mono font-bold text-amber-600 dark:text-amber-400">
                          {cluster.absentStudents}
                        </td>
                        <td className="py-2.5 text-center font-mono font-bold text-emerald-600 dark:text-emerald-400">
                          {cluster.comingStudents}
                        </td>
                        <td className="py-2.5 text-center">
                          {cluster.isCampus ? (
                            <span className="rounded-full bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2 py-0.5 text-[10px] font-bold">
                              CAMPUS HUB
                            </span>
                          ) : cluster.isSkipped ? (
                            <span className="rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2 py-0.5 text-[10px] font-bold">
                              BYPASS (0 Riders)
                            </span>
                          ) : isOverridden ? (
                            <span className="rounded-full bg-indigo-100 text-[#4F46E5] dark:bg-indigo-950 dark:text-indigo-300 px-2 py-0.5 text-[10px] font-bold">
                              FORCE KEPT
                            </span>
                          ) : (
                            <span className="rounded-full bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2 py-0.5 text-[10px] font-bold">
                              ACTIVE STOP
                            </span>
                          )}
                        </td>
                        <td className="py-2.5 text-right">
                          {!cluster.isCampus && (
                            <button
                              type="button"
                              onClick={() => setClusterOptimizationOverride(activeRouteId, cluster.clusterId, !isOverridden)}
                              className={`tactile-btn rounded-lg px-2.5 py-1 text-[11px] font-bold transition cursor-pointer ${
                                isOverridden
                                  ? 'bg-indigo-100 text-[#4F46E5] hover:bg-indigo-200 dark:bg-indigo-950/70 dark:text-indigo-300'
                                  : 'border border-slate-200 bg-[#F7F9FF] text-slate-800 hover:bg-white dark:border-[#2E3646] dark:bg-[#141821] dark:text-white'
                              }`}
                            >
                              {isOverridden ? 'Clear Keep Override' : 'Force Keep Stop'}
                            </button>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
          )}

          {/* Live Incident Queue */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-[#2E3646]">
              <div className="flex items-center gap-2">
                <AlertTriangle className={`h-5 w-5 ${activeIncidentsCount > 0 ? 'text-rose-500 animate-bounce' : 'text-slate-400'}`} />
                <h2 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                  Live Incident Queue ({activeIncidentsCount} Open)
                </h2>
              </div>
              <button
                type="button"
                onClick={reloadData}
                className="text-xs font-bold text-[#4F46E5] hover:underline dark:text-cyan-300 cursor-pointer"
              >
                Refresh Feed
              </button>
            </div>

            <div className="mt-3.5 space-y-2.5">
              {incidents.length === 0 ? (
                <p className="text-xs text-slate-500 dark:text-slate-400 italic p-2">
                  No incidents reported today. All routes operating under normal conditions.
                </p>
              ) : (
                incidents.slice(0, 5).map((inc) => (
                  <div
                    key={inc.id}
                    className={`flex flex-wrap items-center justify-between gap-3 rounded-2xl border p-3.5 ${
                      inc.open
                        ? 'border-rose-300 bg-rose-50/70 dark:bg-rose-950/30'
                        : 'prismatic-subcard opacity-60'
                    }`}
                  >
                    <div>
                      <div className="flex items-center gap-2">
                        <span
                          className={`rounded-md px-2 py-0.5 text-[10px] font-black uppercase ${
                            inc.kind === 'SOS' ? 'bg-rose-600 text-white' : 'bg-amber-500 text-white'
                          }`}
                        >
                          {inc.kind}
                        </span>
                        <span className="font-extrabold text-xs text-slate-900 dark:text-white">
                          {inc.route_id} • Reported by {inc.who}
                        </span>
                        <span className="text-[10px] text-slate-500 dark:text-slate-400">
                          {new Date(inc.ts).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}
                        </span>
                      </div>
                      <p className="mt-1 text-xs text-slate-600 dark:text-slate-400">{inc.msg}</p>
                    </div>

                    {inc.open ? (
                      <button
                        type="button"
                        onClick={() => handleResolveIncident(inc.id)}
                        className="tactile-btn flex items-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-1.5 text-xs font-extrabold text-white shadow-xs hover:bg-emerald-700 cursor-pointer"
                      >
                        <CheckCircle2 className="h-3.5 w-3.5" />
                        <span>Mark Resolved</span>
                      </button>
                    ) : (
                      <span className="text-xs font-bold text-emerald-600 dark:text-emerald-400">✓ Resolved</span>
                    )}
                  </div>
                ))
              )}
            </div>
          </div>

          {/* Announcements Composer */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex items-center gap-2 border-b border-slate-100 pb-3 dark:border-[#2E3646]">
              <Bell className="h-5 w-5 text-[#4F46E5] dark:text-cyan-300" />
              <h2 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                Campus Route Announcements Composer
              </h2>
            </div>

            <form onSubmit={handlePostAnnouncement} className="mt-3.5 space-y-3">
              <div className="flex flex-wrap gap-2">
                <select
                  value={newAnnouncementRoute}
                  onChange={(e) => setNewAnnouncementRoute(e.target.value)}
                  className="rounded-xl border border-slate-200 bg-[#F7F9FF] px-3 py-2 text-xs font-bold text-slate-900 dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                >
                  <option value="ALL">Broadcast to All Routes</option>
                  {buses.map((b) => (
                    <option key={b.routeId} value={b.routeId}>
                      {b.routeNumber} ({b.routeName.split('—')[0].trim()})
                    </option>
                  ))}
                </select>

                <input
                  type="text"
                  value={newAnnouncementText}
                  onChange={(e) => setNewAnnouncementText(e.target.value)}
                  placeholder="e.g. Warangal Highway heavy rain advisory: Bus arriving with 10m caution."
                  className="flex-1 min-w-[240px] rounded-xl border border-slate-200 bg-[#F7F9FF] px-3 py-2 text-xs text-slate-900 outline-none focus:border-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-white"
                  maxLength={280}
                  required
                />

                <button
                  type="submit"
                  disabled={isPostingAnnouncement || !newAnnouncementText.trim()}
                  className="electric-cta flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-bold text-white disabled:opacity-50 cursor-pointer"
                >
                  <Send className="h-3.5 w-3.5" />
                  <span>{isPostingAnnouncement ? 'Broadcasting...' : 'Publish'}</span>
                </button>
              </div>
            </form>

            {announcements.length > 0 && (
              <div className="mt-4 space-y-2 border-t border-slate-100 pt-3 dark:border-[#2E3646]">
                <p className="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Active Notices on Passenger Feeds:
                </p>
                {announcements.slice(0, 4).map((ann) => (
                  <div
                    key={ann.id}
                    className="prismatic-subcard flex items-center justify-between rounded-xl p-2.5 text-xs"
                  >
                    <div>
                      <span className="font-bold text-[#4F46E5] dark:text-cyan-300">[{ann.route_id}]:</span>{' '}
                      <span className="text-slate-900 dark:text-white">{ann.msg}</span>
                      <span className="ml-2 text-[10px] text-slate-500 dark:text-slate-400">
                        {new Date(ann.ts).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}
                      </span>
                    </div>
                    <button
                      type="button"
                      onClick={() => handleDeleteAnnouncement(ann.id)}
                      className="p-1 text-slate-400 hover:text-rose-500 cursor-pointer"
                      title="Delete Announcement"
                    >
                      <Trash2 className="h-4 w-4" />
                    </button>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      {adminTab === 'LOGS' && (
        <div className="animate-panel-in space-y-4">
          {/* Live Server Health Strip */}
          <div className="prismatic-card rounded-3xl p-4 sm:p-5">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div className="flex items-center gap-2">
                <span className="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                  <Activity className="h-4 w-4" />
                </span>
                <div>
                  <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                    Live Server Health &amp; Diagnostics
                  </h3>
                  <p className="text-[11px] text-slate-500 dark:text-slate-400">
                    Real-time SSE streams, SQLite WAL storage, and backups.
                  </p>
                </div>
              </div>

              <div className="flex flex-wrap items-center gap-2 text-xs">
                <div className="prismatic-subcard flex items-center gap-1.5 rounded-xl px-2.5 py-1">
                  <Radio className="h-3.5 w-3.5 text-[#06B6D4] animate-pulse" />
                  <span className="text-slate-500 dark:text-slate-400">SSE:</span>
                  <span className="font-bold text-slate-900 dark:text-white">{serverHealth?.activeSseClients ?? 0}</span>
                </div>

                <div className="prismatic-subcard flex items-center gap-1.5 rounded-xl px-2.5 py-1">
                  <span className="text-slate-500 dark:text-slate-400">Routes:</span>
                  <span className="font-bold text-emerald-600 dark:text-emerald-400">{serverHealth?.liveRoutes ?? 0} live</span>
                  {serverHealth?.staleRoutes && serverHealth.staleRoutes.length > 0 && (
                    <span className="font-bold text-amber-600 dark:text-amber-400">({serverHealth.staleRoutes.length} stale)</span>
                  )}
                </div>

                <div className="prismatic-subcard flex items-center gap-1.5 rounded-xl px-2.5 py-1">
                  <HardDrive className="h-3.5 w-3.5 text-[#4F46E5]" />
                  <span className="text-slate-500 dark:text-slate-400">WAL:</span>
                  <span className="font-mono font-bold text-slate-900 dark:text-white">
                    {serverHealth ? (serverHealth.walBytes < 1024 ? `${serverHealth.walBytes} B` : `${(serverHealth.walBytes / 1024).toFixed(1)} KB`) : '0 B'}
                  </span>
                </div>

                <div className="prismatic-subcard flex items-center gap-1.5 rounded-xl px-2.5 py-1">
                  <span className="text-slate-500 dark:text-slate-400">Last Backup:</span>
                  <span className="font-bold text-slate-900 dark:text-white">
                    {serverHealth?.lastBackupAt ? new Date(serverHealth.lastBackupAt).toLocaleTimeString() : 'None'}
                  </span>
                </div>

                <button
                  type="button"
                  onClick={handleCreateBackup}
                  disabled={isBackupLoading}
                  className="electric-cta flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-bold text-white disabled:opacity-50 cursor-pointer"
                >
                  <Database className="h-3.5 w-3.5" />
                  <span>{isBackupLoading ? 'Backing Up...' : 'SQLite WAL Backup'}</span>
                </button>

                <button
                  type="button"
                  onClick={fetchHealth}
                  disabled={isHealthRefreshing}
                  title="Refresh Server Health"
                  className="tactile-btn rounded-xl border border-slate-200 bg-[#F7F9FF] p-1.5 text-slate-700 hover:bg-indigo-50 dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200 cursor-pointer"
                >
                  <RotateCcw className={`h-3.5 w-3.5 ${isHealthRefreshing ? 'animate-spin' : ''}`} />
                </button>
              </div>
            </div>
          </div>

          {/* Bulk Onboard Roster (.xlsx) & SQLite WAL Backup */}
          <div className="prismatic-card rounded-3xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4 dark:border-[#2E3646]">
              <div className="flex items-center gap-2.5">
                <span className="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-50 to-cyan-50 text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
                  <Upload className="h-4 w-4" />
                </span>
                <div>
                  <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                    Bulk Onboard Roster (.xlsx) &amp; System Backup
                  </h3>
                  <p className="text-xs text-slate-500 dark:text-slate-400">
                    Onboard up to 500 riders via .xlsx/.csv with activation PINs and SQLite WAL backups.
                  </p>
                </div>
              </div>

              <div className="flex flex-wrap items-center gap-2">
                <input
                  type="file"
                  ref={fileInputRef}
                  onChange={handleBulkFileChange}
                  accept=".xlsx,.xls,.csv"
                  className="hidden"
                />
                <button
                  type="button"
                  onClick={() => fileInputRef.current?.click()}
                  disabled={isImportingRoster}
                  className="electric-cta flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold text-white disabled:opacity-50 cursor-pointer"
                >
                  <Upload className="h-3.5 w-3.5" />
                  <span>{isImportingRoster ? 'Parsing Sheet...' : 'Bulk Onboard Roster (.xlsx)'}</span>
                </button>
                <button
                  type="button"
                  onClick={handleCreateBackup}
                  disabled={isBackupLoading}
                  className="tactile-btn flex items-center gap-1.5 rounded-xl border border-slate-200 bg-[#F7F9FF] px-3.5 py-2 text-xs font-bold text-slate-800 hover:bg-indigo-50 dark:border-[#2E3646] dark:bg-[#141821] dark:text-white cursor-pointer"
                >
                  <Database className="h-3.5 w-3.5 text-[#4F46E5]" />
                  <span>{isBackupLoading ? 'Backing Up...' : 'Create SQLite WAL Backup'}</span>
                </button>
              </div>
            </div>

            {bulkImportResult && (
              <div className="mt-4 rounded-2xl border border-indigo-200 bg-indigo-50/60 p-4 dark:border-indigo-900/60 dark:bg-indigo-950/30">
                <div className="flex flex-wrap items-center justify-between gap-3 mb-3">
                  <div>
                    <h4 className="text-xs font-extrabold text-indigo-950 dark:text-indigo-200 flex items-center gap-1.5">
                      <Key className="h-4 w-4 text-[#4F46E5] dark:text-cyan-300" />
                      <span>One-Time Rider Activation PINs ({bulkImportResult.createdCount} Accounts Created)</span>
                    </h4>
                    <p className="text-[11px] text-indigo-700 dark:text-indigo-300 mt-0.5">
                      {bulkImportResult.skippedExistingCount} existing preserved • {bulkImportResult.errors?.length || 0} errors skipped.
                    </p>
                  </div>
                  <div className="flex items-center gap-2">
                    <button
                      type="button"
                      onClick={handleDownloadPinsCsv}
                      className="electric-cta flex items-center gap-1 rounded-xl px-3 py-1.5 text-xs font-bold text-white cursor-pointer"
                    >
                      <Download className="h-3.5 w-3.5" />
                      <span>Download Onboarding PINs (CSV)</span>
                    </button>
                    <button
                      type="button"
                      onClick={() => setBulkImportResult(null)}
                      className="tactile-btn rounded-xl border border-indigo-200 bg-white px-2.5 py-1.5 text-xs font-bold text-[#4F46E5] hover:bg-indigo-50 dark:border-indigo-800 dark:bg-[#1E2430] dark:text-indigo-300 cursor-pointer"
                    >
                      Dismiss
                    </button>
                  </div>
                </div>

                {bulkImportResult.credentials && bulkImportResult.credentials.length > 0 && (
                  <div className="overflow-x-auto max-h-64 rounded-xl border border-indigo-200 bg-white dark:border-indigo-900 dark:bg-[#141821]">
                    <table className="w-full text-left text-xs">
                      <thead className="sticky top-0 bg-[#F7F9FF] dark:bg-[#1E2430] text-slate-600 dark:text-slate-300 font-bold border-b border-slate-200 dark:border-[#2E3646]">
                        <tr>
                          <th className="px-3 py-2">Roll Number</th>
                          <th className="px-3 py-2">Name</th>
                          <th className="px-3 py-2">Route</th>
                          <th className="px-3 py-2">Stop</th>
                          <th className="px-3 py-2">Role</th>
                          <th className="px-3 py-2">Activation PIN</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-100 dark:divide-[#2E3646] font-medium">
                        {bulkImportResult.credentials.map((c, idx) => (
                          <tr key={idx}>
                            <td className="px-3 py-1.5 font-mono font-bold text-slate-900 dark:text-white">{c.rollNumber}</td>
                            <td className="px-3 py-1.5 text-slate-700 dark:text-slate-300">{c.name}</td>
                            <td className="px-3 py-1.5 uppercase text-slate-500 dark:text-slate-400">{c.routeId}</td>
                            <td className="px-3 py-1.5 text-slate-500 dark:text-slate-400">{c.pickupStop}</td>
                            <td className="px-3 py-1.5">
                              <span
                                className={`px-2 py-0.5 rounded text-[10px] font-bold ${
                                  c.riderType === 'FACULTY'
                                    ? 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300'
                                    : 'bg-indigo-100 text-[#4F46E5] dark:bg-indigo-950 dark:text-indigo-300'
                                }`}
                              >
                                {c.riderType}
                              </span>
                            </td>
                            <td className="px-3 py-1.5">
                              <span className="font-mono font-extrabold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 dark:text-emerald-300 dark:bg-emerald-950 dark:border-emerald-800">
                                {c.temporaryPassword}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            )}
          </div>

          {/* 1-Click CSV Export Bar */}
          <div className="prismatic-card rounded-3xl p-4 sm:p-5">
            <div className="flex items-center gap-2 mb-3">
              <Download className="h-4 w-4 text-[#4F46E5] dark:text-cyan-300" />
              <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                1-Click Administrative CSV Data Exports
              </h3>
            </div>
            <div className="flex flex-wrap gap-2">
              <button
                type="button"
                onClick={() => handleDownloadCsv('incidents')}
                className="tactile-btn rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200 cursor-pointer"
              >
                Export Incidents (CSV)
              </button>
              <button
                type="button"
                onClick={() => handleDownloadCsv('feedback')}
                className="tactile-btn rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200 cursor-pointer"
              >
                Export Feedback (CSV)
              </button>
              <button
                type="button"
                onClick={() => handleDownloadCsv('absences')}
                className="tactile-btn rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200 cursor-pointer"
              >
                Export Absences (CSV)
              </button>
              <button
                type="button"
                onClick={() => handleDownloadCsv('lost')}
                className="tactile-btn rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200 cursor-pointer"
              >
                Export Lost &amp; Found (CSV)
              </button>
              <button
                type="button"
                onClick={() => handleDownloadCsv('boardings')}
                className="tactile-btn rounded-xl border border-slate-200/80 bg-[#F7F9FF] px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-[#4F46E5] dark:border-[#2E3646] dark:bg-[#141821] dark:text-slate-200 cursor-pointer"
              >
                Export Boarding Roster (CSV)
              </button>
              <button
                type="button"
                onClick={() =>
                  void handleDownloadCsv('driver_utility', {
                    routeId: reportRouteFilter || undefined,
                    date: reportDateFilter || undefined,
                  })
                }
                className="electric-cta rounded-xl px-3 py-1.5 text-xs font-bold text-white cursor-pointer"
              >
                Export Driver Utility CSV
              </button>
            </div>
          </div>

          {/* Lost & Found Desk & Student Ride Feedback Dual Grid */}
          <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div className="prismatic-card rounded-3xl p-5">
              <div className="flex items-center gap-2 border-b border-slate-100 pb-3 dark:border-[#2E3646]">
                <PackageSearch className="h-5 w-5 text-[#4F46E5] dark:text-cyan-300" />
                <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                  Campus Lost &amp; Found Desk
                </h3>
              </div>
              <div className="mt-3.5 space-y-2.5 max-h-56 overflow-y-auto">
                {lostItems.length === 0 ? (
                  <p className="text-xs text-slate-500 dark:text-slate-400 italic p-2">
                    No items reported missing today.
                  </p>
                ) : (
                  lostItems.map((item) => (
                    <div
                      key={item.id}
                      className="prismatic-subcard flex items-center justify-between rounded-xl p-2.5 text-xs"
                    >
                      <div>
                        <p className="font-bold text-slate-900 dark:text-white">{item.msg}</p>
                        <p className="text-[10px] text-slate-500 dark:text-slate-400">
                          Reported by {item.who} • {new Date(item.ts).toLocaleDateString('en-IN')}
                        </p>
                      </div>
                      {item.open ? (
                        <button
                          type="button"
                          onClick={() => handleResolveLost(item.id)}
                          className="tactile-btn rounded-lg bg-emerald-600 px-2.5 py-1 text-[11px] font-bold text-white hover:bg-emerald-700 cursor-pointer"
                        >
                          Returned
                        </button>
                      ) : (
                        <span className="text-[11px] font-bold text-emerald-600">✓ Returned</span>
                      )}
                    </div>
                  ))
                )}
              </div>
            </div>

            <div className="prismatic-card rounded-3xl p-5">
              <div className="flex items-center gap-2 border-b border-slate-100 pb-3 dark:border-[#2E3646]">
                <Star className="h-5 w-5 text-amber-500 fill-amber-500" />
                <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
                  Student Ride Feedback
                </h3>
              </div>
              <div className="mt-3.5 space-y-2.5 max-h-56 overflow-y-auto">
                {feedbackList.length === 0 ? (
                  <p className="text-xs text-slate-500 dark:text-slate-400 italic p-2">
                    No ride ratings submitted yet today.
                  </p>
                ) : (
                  feedbackList.slice(0, 6).map((fb) => (
                    <div
                      key={fb.id}
                      className="prismatic-subcard rounded-xl p-2.5 text-xs"
                    >
                      <div className="flex items-center justify-between">
                        <span className="font-bold text-slate-900 dark:text-white">
                          {fb.student_name} ({fb.roll_number})
                        </span>
                        <span className="font-mono text-amber-500 font-bold">
                          {'★'.repeat(fb.rating)} ({fb.rating}/5)
                        </span>
                      </div>
                      <p className="mt-1 text-[11px] text-slate-600 dark:text-slate-400">
                        &quot;{fb.msg}&quot;
                      </p>
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

```

---

## 28. `src/components/portals/ParentPortal.tsx` <a id="srccomponentsportalsparentportaltsx"></a>

**Description:** Prismatic Daylight Parent oversight portal (feature-gated via VITE_ENABLE_PARENT_PORTAL) for tracking child bus arrival, lost item reporting, and WhatsApp/in-app safety alerts.  
**File Path:** `sreenidhi-express/src/components/portals/ParentPortal.tsx`  

```tsx
import React, { useState, useEffect } from 'react';
import {
  Phone,
  PhoneCall,
  Send,
  LogOut,
  CalendarX,
  PackageSearch,
  AlertTriangle,
  Bell,
} from 'lucide-react';
import { useCommuteSimulation } from '../../context/useCommuteSimulation';
import { MetroSchematicMap } from '../map/MetroSchematicMap';

const ENABLE_AREA_SKIPPING = import.meta.env.VITE_ENABLE_AREA_SKIPPING === 'true';
import { excelService } from '../../services/excelService';
import { calculateStopEtaSeconds, getGoogleMapsLiveEta } from '../../services/mapsService';
import { PhoneOnboardingModal } from '../notifications/PhoneOnboardingModal';
import { LiveTransitTracker } from '../notifications/LiveTransitTracker';
import { MobileAlertCard } from '../notifications/MobileAlertCard';
import { SmsMessageDrawer } from '../notifications/SmsMessageDrawer';

export const ParentPortal: React.FC = () => {
  const {
    activeStudent,
    activeBus,
    currentUser,
    logoutUser,
    pushToast,
    routeOptimizationPlan,
    setAbsenceTomorrow,
  } = useCommuteSimulation();

  const [isAbsentTomorrow, setIsAbsentTomorrow] = useState(false);
  const [isUpdatingAbsence, setIsUpdatingAbsence] = useState(false);
  const [openIncidents, setOpenIncidents] = useState<any[]>([]);
  const [lostDescription, setLostDescription] = useState('');
  const [isSubmittingLost, setIsSubmittingLost] = useState(false);

  // Mobile Phone & E-Commerce Alerts State
  const [parentPhone, setParentPhone] = useState<string>('');
  const [isPhoneVerified, setIsPhoneVerified] = useState<boolean>(true);
  const [isPhoneModalOpen, setIsPhoneModalOpen] = useState<boolean>(false);
  const [isSmsDrawerOpen, setIsSmsDrawerOpen] = useState<boolean>(false);
  const [busDelayMinutes, setBusDelayMinutes] = useState<number>(0);
  const [isTripActive, setIsTripActive] = useState<boolean>(true);
  const [isSendingTestNotif, setIsSendingTestNotif] = useState<boolean>(false);

  // Active student ward (strictly derived from authenticated parent session)
  const studentName = currentUser?.role === 'PARENT' ? (currentUser.wardName || activeStudent?.name || 'Student') : (activeStudent?.name || 'Student');
  const studentRoll = currentUser?.role === 'PARENT' ? (currentUser.wardRoll || activeStudent?.rollNumber || '') : (activeStudent?.rollNumber || '');
  const wardRouteId = (currentUser as any)?.wardRouteId || activeBus?.routeId || 'route-51';
  const routeNumber = activeBus?.routeNumber || wardRouteId.replace('route-', 'Route ');
  const pickupStopName = (currentUser as any)?.wardPickupStop || activeStudent?.pickupStopId || 'Assigned Stop';
  const driverName = activeBus?.driverName || 'Designated Driver';
  const driverPhone = activeBus?.driverPhone || '+91 77999 56801';

  const studentStop = activeBus?.stops?.find(
    (s: any) => s.name === pickupStopName || s.id === activeStudent?.pickupStopId
  );
  const highlightStopId = studentStop?.id || activeStudent?.pickupStopId || activeBus?.stops[0]?.id || '';

  const [countdownSec, setCountdownSec] = useState<number>(720);
  const [learnedMedians, setLearnedMedians] = useState<Record<string, { medianSec: number; sampleCount: number }>>({});
  const [etaSource, setEtaSource] = useState<string>('Live GPS + Road ETA');

  // Fetch learned Hyderabad traffic segment medians (₹0 ML / Median model)
  useEffect(() => {
    let mounted = true;
    if (activeBus?.routeId) {
      excelService.fetchEtaModel(activeBus.routeId).then((res) => {
        if (mounted && res?.segments) {
          setLearnedMedians(res.segments);
        }
      });
    }
    return () => {
      mounted = false;
    };
  }, [activeBus?.routeId]);

  // Calculate dynamic ETA whenever bus GPS, telemetry, or target changes
  useEffect(() => {
    let isMounted = true;
    const calculateEta = async () => {
      const targetStop =
        studentStop ||
        activeBus?.stops?.find((s: any) => s.id === highlightStopId) ||
        activeBus?.stops?.[0];
      if (!activeBus || !targetStop) return;

      const targetStopIndex = activeBus.stops.findIndex((s: any) => s.id === targetStop.id);
      const safeTargetIndex = targetStopIndex >= 0 ? targetStopIndex : 0;

      const res = await getGoogleMapsLiveEta(
        { lat: activeBus.currentLat, lng: activeBus.currentLng },
        { lat: targetStop.lat, lng: targetStop.lng },
        activeBus.speedKmh,
        activeBus.trafficDelayMinutes,
      );
      if (!isMounted) return;

      let finalSeconds = 0;
      let finalSource = 'Live GPS + Road ETA';
      const hasLearned = Object.keys(learnedMedians).length > 0;

      if (res.source === 'GOOGLE_MAPS_DIRECTIONS') {
        finalSeconds = res.seconds;
        finalSource = 'Google Maps Directions';
      } else if (hasLearned) {
        finalSeconds = calculateStopEtaSeconds(
          activeBus.currentLat,
          activeBus.currentLng,
          activeBus.stops,
          activeBus.currentStopIndex,
          safeTargetIndex,
          activeBus.speedKmh,
          activeBus.trafficDelayMinutes,
          learnedMedians,
        );
        finalSource = 'Learned Traffic ETA';
      } else {
        finalSeconds = calculateStopEtaSeconds(
          activeBus.currentLat,
          activeBus.currentLng,
          activeBus.stops,
          activeBus.currentStopIndex,
          safeTargetIndex,
          activeBus.speedKmh,
          activeBus.trafficDelayMinutes,
        );
        finalSource = 'Live GPS + Road ETA';
      }

      if (finalSeconds > 0) {
        setCountdownSec(finalSeconds);
        setEtaSource(finalSource);
      }
    };
    void calculateEta();
    return () => {
      isMounted = false;
    };
  }, [
    activeBus?.currentLat,
    activeBus?.currentLng,
    activeBus?.speedKmh,
    activeBus?.trafficDelayMinutes,
    activeBus?.currentStopIndex,
    activeBus?.stops,
    highlightStopId,
    studentStop,
    learnedMedians,
  ]);

  useEffect(() => {
    const timer = setInterval(() => {
      setCountdownSec((prev) => (prev > 0 ? prev - 1 : 0));
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  const formatHms = (totalSeconds: number): string => {
    const s = Math.max(0, Math.floor(totalSeconds));
    const hrs = Math.floor(s / 3600);
    const mins = Math.floor((s % 3600) / 60);
    const secs = s % 60;
    return `${hrs.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  };
  const displayCountdownHms = formatHms(countdownSec);

  const busCurrentStopIndex = activeBus?.currentStopIndex ?? 0;
  const nextStopName =
    activeBus?.stops[Math.min(busCurrentStopIndex + 1, Math.max((activeBus?.stops?.length || 1) - 1, 0))]?.name ||
    'Sreenidhi Campus';

  // Load absence, incidents, contact info & bus state on mount
  useEffect(() => {
    let mounted = true;
    void (async () => {
      const abs = await excelService.getAbsenceTomorrow(studentRoll);
      if (mounted) setIsAbsentTomorrow(abs.absentTomorrow);
      const incs = await excelService.fetchIncidents(true);
      if (mounted) setOpenIncidents(incs.filter((i) => i.route_id === wardRouteId || i.route_id === 'ALL'));
    })();

    excelService.getContactInfo(studentRoll)
      .then((data) => {
        if (mounted && data && data.parentPhone) {
          setParentPhone(data.parentPhone);
          setIsPhoneVerified(Boolean(data.parentPhoneVerified));
        } else if (mounted) {
          const prompted = sessionStorage.getItem('parent_phone_prompted');
          if (!prompted) {
            setIsPhoneModalOpen(true);
            sessionStorage.setItem('parent_phone_prompted', '1');
          }
        }
      })
      .catch((err) => console.error('Failed to load parent contact info', err));

    excelService.getBusState(wardRouteId)
      .then((data) => {
        if (mounted && data && data.success) {
          setIsTripActive(data.running ?? true);
          setBusDelayMinutes(data.delayMinutes || 0);
        }
      })
      .catch((err) => console.error('Failed to load bus state', err));

    return () => {
      mounted = false;
    };
  }, [studentRoll, wardRouteId]);

  const handleToggleAbsence = async () => {
    setIsUpdatingAbsence(true);
    const nextState = !isAbsentTomorrow;
    const res = await setAbsenceTomorrow(studentRoll, nextState);
    setIsUpdatingAbsence(false);
    if (res.success) {
      setIsAbsentTomorrow(nextState);
    }
  };

  const handleSubmitLost = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!lostDescription.trim()) return;
    setIsSubmittingLost(true);
    const ok = await excelService.reportLostItem(lostDescription.trim(), `Parent of ${studentName} (${studentRoll})`);
    setIsSubmittingLost(false);
    if (ok) {
      setLostDescription('');
      pushToast('success', 'Reported to Transport Office', 'The transport desk has received your item report.');
    }
  };

  const handleTestAppNotification = async () => {
    setIsSendingTestNotif(true);
    pushToast('info', 'Dispatching In-App Alert', 'Generating test notification for your ward...');
    try {
      const res = await excelService.testParentNotification(studentRoll);
      if (res.success) {
        pushToast('success', 'In-App Alert Received', `Safety notification logged for ${studentName}.`);
        setIsSmsDrawerOpen(true);
      } else {
        pushToast('danger', 'Dispatch Failed', 'Could not dispatch test notification.');
      }
    } catch {
      pushToast('danger', 'Network Error', 'Failed to reach notifications server.');
    } finally {
      setIsSendingTestNotif(false);
    }
  };

  const handleOpenWhatsApp = () => {
    const cleanDigits = (parentPhone || '').replace(/\D/g, '').slice(-10);
    if (!cleanDigits || cleanDigits.length < 10) {
      pushToast('warning', 'Phone Number Required', 'Please configure your 10-digit WhatsApp phone number first.');
      setIsPhoneModalOpen(true);
      return;
    }
    const message = `Sreenidhi Express Transport Alert: Live bus tracking and arrival updates for student ${studentName} (${studentRoll}) on ${routeNumber}. View status: ${window.location.origin}`;
    const url = `https://wa.me/91${cleanDigits}?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    pushToast('success', 'WhatsApp Alert Opened', `Drafted WhatsApp safety alert for +91 ${cleanDigits}`);
  };

  return (
    <div className="mx-auto w-full max-w-5xl space-y-4 pb-12 antialiased">
      {/* Top Header Card */}
      <div className="prismatic-card flex items-center justify-between rounded-3xl p-4">
        <div className="flex-1 min-w-0 pr-3">
          <div className="flex items-center gap-1.5 flex-wrap">
            <h1 className="text-base font-extrabold tracking-tight text-slate-900 dark:text-white truncate">
              {studentName}
            </h1>
            <span className="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-0.5 text-[10px] font-bold text-[#4F46E5] dark:border-indigo-700/50 dark:bg-indigo-950/60 dark:text-cyan-300">
              Verified Rider
            </span>
          </div>
          <p className="font-mono text-xs font-bold text-[#4F46E5] dark:text-cyan-300">
            Roll No: {studentRoll}
          </p>
          <p className="text-[11px] text-slate-500 dark:text-slate-400 truncate">
            Parent Oversight • {routeNumber}
          </p>
        </div>

        {/* Top-Right Corner: SMS Bell, Sign Out & Official Brand Logo */}
        <div className="flex items-center gap-2 shrink-0">
          <button
            type="button"
            onClick={() => setIsSmsDrawerOpen(true)}
            className="tactile-btn relative rounded-2xl border border-slate-200 p-2 text-slate-600 transition hover:bg-indigo-50 hover:text-[#4F46E5] dark:border-[#2E3646] dark:text-slate-300 dark:hover:bg-[#2B313F] cursor-pointer"
            title="Live Transit SMS & App Messages"
          >
            <Bell className="h-4 w-4" />
            <span className="absolute -top-1 -right-1 flex h-2.5 w-2.5">
              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#06B6D4] opacity-75"></span>
              <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#06B6D4]"></span>
            </span>
          </button>
          <button
            type="button"
            onClick={logoutUser}
            className="tactile-btn rounded-2xl border border-slate-200 p-2 text-slate-600 transition hover:bg-rose-50 hover:text-rose-600 dark:border-[#2E3646] dark:text-slate-300 dark:hover:bg-[#2B313F] cursor-pointer"
            title="Sign Out"
          >
            <LogOut className="h-4 w-4" />
          </button>
          <div className="rounded-2xl bg-gradient-to-br from-[#4F46E5] to-[#06B6D4] p-0.5">
            <img
              src="/sreenidhi_express_logo.jpg"
              alt="Sreenidhi Express Logo"
              className="h-11 w-11 rounded-[14px] object-cover"
            />
          </div>
        </div>
      </div>

      {/* Open SOS / Safety Alert Feed */}
      {openIncidents.length > 0 && (
        <div className="space-y-2">
          {openIncidents.map((inc) => (
            <div
              key={inc.id}
              className="flex items-start gap-2.5 rounded-2xl border border-rose-300 bg-rose-50 p-3 text-xs text-rose-900 dark:bg-rose-950/50 dark:text-rose-200"
            >
              <AlertTriangle className="h-4 w-4 shrink-0 text-rose-600 mt-0.5" />
              <div>
                <p className="font-extrabold uppercase tracking-wider">{inc.kind} ALERT ON {inc.route_id}</p>
                <p className="mt-0.5 text-[11px]">{inc.msg}</p>
                <p className="text-[10px] text-rose-700/80 dark:text-rose-400 mt-0.5">
                  Reported at {new Date(inc.ts).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })} • Transport desk notified
                </p>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Live Transit Milestone Tracker */}
      <LiveTransitTracker
        routeId={activeBus?.routeId || wardRouteId}
        routeName={activeBus?.routeName || 'Campus Express'}
        pickupStop={pickupStopName}
        isTripStarted={isTripActive}
        delayMinutes={busDelayMinutes}
        formattedCountdown={displayCountdownHms}
        studentName={studentName}
        rollNumber={studentRoll}
      />

      {/* Remote Absence Control for Ward */}
      <div className="prismatic-card space-y-2 rounded-3xl p-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className={`rounded-xl p-2 ${isAbsentTomorrow ? 'bg-amber-100 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300' : 'bg-indigo-50 text-[#4F46E5] dark:bg-slate-800 dark:text-cyan-300'}`}>
              <CalendarX className="h-5 w-5" />
            </div>
            <div>
              <div className="flex items-center gap-2 flex-wrap">
                <p className="text-xs font-bold text-slate-900 dark:text-white">
                  Mark child not travelling tomorrow
                </p>
                <span className="rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-semibold text-[#4F46E5] dark:bg-slate-800 dark:text-slate-400">
                  Cutoff: 1 hour before bus departure
                </span>
              </div>
              <p className="text-[11px] text-slate-500 dark:text-slate-400">
                {isAbsentTomorrow ? 'Bus driver notified not to wait at stop' : 'Driver and transport desk will not expect student'}
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={handleToggleAbsence}
            disabled={isUpdatingAbsence}
            className={`relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none ${
              isAbsentTomorrow ? 'bg-gradient-to-r from-[#4F46E5] to-[#06B6D4]' : 'bg-slate-300 dark:bg-slate-700'
            }`}
            role="switch"
            aria-checked={isAbsentTomorrow}
          >
            <span
              className={`pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out ${
                isAbsentTomorrow ? 'translate-x-5' : 'translate-x-0'
              }`}
            />
          </button>
        </div>

        {/* Dynamic Area Reroute Live Status for Ward */}
        {(() => {
          const wardClusterId = activeStudent?.areaClusterId || studentStop?.areaClusterId || '';
          const isClusterBypassed = Boolean(
            ENABLE_AREA_SKIPPING &&
            routeOptimizationPlan?.skippedClusterIds?.includes(wardClusterId)
          );
          const isDownstreamBypass = Boolean(
            ENABLE_AREA_SKIPPING &&
            routeOptimizationPlan?.skippedClusterIds?.length &&
            !isClusterBypassed &&
            activeBus?.stops.some(
              (s: any) => s.sequence < (studentStop?.sequence || 99) && routeOptimizationPlan.skippedClusterIds.includes(s.areaClusterId)
            )
          );

          if (isClusterBypassed) {
            return (
              <div className="rounded-xl border border-amber-300 bg-amber-50 p-2.5 text-[11px] text-amber-900 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-200">
                <span className="font-bold">⚠️ Ward Area Cluster Bypassed:</span> All registered riders in this area marked absent. Morning bus will skip this stop and use the highway express corridor.
              </div>
            );
          }
          if (isDownstreamBypass) {
            return (
              <div className="rounded-xl border border-emerald-300 bg-emerald-50 p-2.5 text-[11px] text-emerald-900 dark:border-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-200">
                <span className="font-bold">⚡ Earlier Pickup Alert:</span> An upstream area cluster is skipped tomorrow morning. Bus may arrive 5–10 minutes earlier than normal.
              </div>
            );
          }
          return null;
        })()}
      </div>

      {/* Live Commute Status Card */}
      <div className="electric-hero rounded-3xl p-5 text-white">
        <div className="bg-futuristic-grid pointer-events-none absolute inset-0 opacity-20" />
        <div className="relative flex items-start justify-between">
          <div>
            <span className="text-[11px] font-bold uppercase tracking-wider text-indigo-100/85">
              Live Commute Status
            </span>
            <h2 className="mt-0.5 text-base font-extrabold text-white">
              {routeNumber} • En Route
            </h2>
            <p className="text-xs text-cyan-100">
              Next Stop: <b className="text-white">{nextStopName}</b>
            </p>
          </div>

          <div className="rounded-2xl border border-white/25 bg-white/15 px-3 py-1.5 text-right backdrop-blur-xs">
            <span className="text-[10px] font-extrabold uppercase text-indigo-100">
              ETA ({etaSource})
            </span>
            <p className="font-mono-timer text-sm font-black text-white">
              ~{Math.max(1, Math.round(countdownSec / 60))} mins
            </p>
          </div>
        </div>

        <div className="relative mt-4 flex items-center justify-between border-t border-white/20 pt-3 text-xs text-indigo-100">
          <span>Assigned Pickup: <b className="text-white">{pickupStopName}</b></span>
          <span>Speed: <b className="font-mono text-white">{activeBus.speedKmh} km/h</b></span>
        </div>
      </div>

      {/* Live GPS Fleet Corridor Card */}
      <div className="prismatic-card overflow-hidden rounded-3xl">
        <div className="flex items-center justify-between border-b border-slate-100 p-3 dark:border-[#2E3646]">
          <div className="flex items-center gap-2">
            <span className="h-2 w-2 rounded-full bg-[#06B6D4] animate-pulse" />
            <span className="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
              Live Route Corridor • {routeNumber}
            </span>
          </div>
          <span className="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[10px] font-extrabold text-[#4F46E5] dark:bg-indigo-950/60 dark:text-cyan-300">
            GPS Live Schematic
          </span>
        </div>

        <div className="p-2.5 sm:p-3 bg-[#F7F9FF] dark:bg-[#141821]">
          <MetroSchematicMap
            activeBus={activeBus}
            highlightStopId={highlightStopId}
          />
        </div>
      </div>

      {/* Official Sreenidhi Transport Assistance & Driver Help Desk */}
      <div className="prismatic-card rounded-3xl p-5">
        <div className="flex items-center gap-2">
          <PhoneCall className="h-5 w-5 text-[#4F46E5] dark:text-cyan-300" />
          <h2 className="text-sm font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
            Direct Driver &amp; Campus Contacts
          </h2>
        </div>

        <div className="mt-3.5 space-y-3">
          <div className="prismatic-subcard flex items-center justify-between rounded-2xl p-3">
            <div>
              <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Assigned Bus Driver ({routeNumber})
              </p>
              <p className="text-xs font-extrabold text-slate-900 dark:text-white">
                {driverName}
              </p>
              <p className="font-mono text-xs font-bold text-[#4F46E5] dark:text-cyan-300">
                {driverPhone}
              </p>
            </div>

            <a
              href={`tel:${driverPhone.replace(/\s+/g, '')}`}
              className="electric-cta inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-xs font-bold text-white"
            >
              <Phone className="h-3.5 w-3.5" />
              <span>Call Driver</span>
            </a>
          </div>

          <div className="prismatic-subcard flex items-center justify-between rounded-2xl p-3">
            <div>
              <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Sreenidhi Transport Helpline
              </p>
              <p className="text-xs font-extrabold text-slate-900 dark:text-white">
                Campus Transport Desk (SNIST)
              </p>
              <p className="font-mono text-xs font-bold text-[#4F46E5] dark:text-cyan-300">
                +91 77999 56801 / +91 77999 56802
              </p>
            </div>

            <a
              href="tel:+917799956801"
              className="tactile-btn inline-flex items-center gap-1.5 rounded-xl bg-slate-900 px-3 py-2 text-xs font-bold text-white shadow-xs hover:bg-slate-800 dark:bg-white/10"
            >
              <Phone className="h-3.5 w-3.5" />
              <span>Call Helpline</span>
            </a>
          </div>

          <div className="rounded-xl border border-dashed border-indigo-200/80 p-2.5 text-[11px] text-slate-500 dark:border-[#2E3646] dark:text-slate-400">
            <p>
              <b>Campus EPABX:</b> +91 8415-395222 / 395444 • <b>General:</b> +91 9948119481
            </p>
            <p className="mt-0.5">
              <b>Campus:</b> Yamnampet, Ghatkesar, Hyderabad - 501301 (Telangana)
            </p>
          </div>
        </div>
      </div>

      {/* Parent Mobile Alert Center & E-Commerce Notification Preferences */}
      <MobileAlertCard
        userType="PARENT"
        rollNumber={studentRoll}
        phoneNumber={parentPhone}
        isVerified={isPhoneVerified}
        onOpenPhoneModal={() => setIsPhoneModalOpen(true)}
        onNotificationSent={() => setIsSmsDrawerOpen(true)}
      />

      {/* Lost & Found Item Form for Parents */}
      <div className="prismatic-card p-5">
        <div className="flex items-center gap-2">
          <PackageSearch className="h-5 w-5 text-[#4F46E5] dark:text-[#06B6D4]" />
          <h2 className="text-sm font-extrabold uppercase tracking-wider text-[#0F172A] dark:text-white">
            Lost Something on the Bus?
          </h2>
        </div>
        <form onSubmit={handleSubmitLost} className="mt-3 space-y-2.5">
          <textarea
            value={lostDescription}
            onChange={(e) => setLostDescription(e.target.value)}
            rows={2}
            placeholder="Describe the lost item (e.g. child left school bag or calculator on Route 14)"
            className="w-full rounded-2xl border border-indigo-100/90 bg-[#F7F9FF] p-3 text-xs text-[#0F172A] placeholder:text-slate-400 focus:border-[#4F46E5] focus:outline-hidden dark:border-[#374151] dark:bg-[#2B313F] dark:text-white"
            maxLength={280}
            required
          />
          <button
            type="submit"
            disabled={isSubmittingLost || !lostDescription.trim()}
            className="tactile-btn electric-cta px-4 py-2.5 text-xs font-extrabold disabled:opacity-50"
          >
            {isSubmittingLost ? 'Reporting...' : 'Report to Transport Office'}
          </button>
        </form>
      </div>

      {/* Quick Action / Safety Alerts */}
      <div className="grid grid-cols-2 gap-2.5">
        <button
          type="button"
          onClick={handleTestAppNotification}
          disabled={isSendingTestNotif}
          className="tactile-btn prismatic-subcard flex items-center justify-center gap-2 py-3 px-3 text-xs font-extrabold text-[#0F172A] hover:border-[#4F46E5]/40 hover:bg-indigo-50/60 dark:text-white dark:hover:bg-[#323A4A]"
        >
          <Bell className="h-4 w-4 text-[#4F46E5] dark:text-[#06B6D4]" />
          <span>{isSendingTestNotif ? 'Sending...' : 'Send Test App Notification'}</span>
        </button>

        <button
          type="button"
          onClick={handleOpenWhatsApp}
          className="tactile-btn flex items-center justify-center gap-2 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 py-3 px-3 text-xs font-extrabold text-emerald-700 shadow-xs transition hover:bg-emerald-500/20 dark:text-emerald-300 cursor-pointer"
        >
          <Send className="h-4 w-4 text-emerald-600 dark:text-emerald-400" />
          <span>Open WhatsApp Alert</span>
        </button>
      </div>

      {/* Parent Phone Number Onboarding & Verification Modal */}
      <PhoneOnboardingModal
        isOpen={isPhoneModalOpen}
        onClose={() => setIsPhoneModalOpen(false)}
        userType="PARENT"
        rollNumber={studentRoll}
        initialPhone={parentPhone}
        onSuccess={(verifiedPhone) => {
          setParentPhone(verifiedPhone);
          setIsPhoneVerified(true);
          pushToast('success', 'Parent Mobile Alerts Configured', `Notifications configured for +91 ${verifiedPhone}`);
        }}
      />

      {/* Live SMS & App Messages Drawer */}
      <SmsMessageDrawer
        isOpen={isSmsDrawerOpen}
        onClose={() => setIsSmsDrawerOpen(false)}
        rollNumber={studentRoll}
        userType="PARENT"
        phoneNumber={parentPhone}
      />
    </div>
  );
};

