## 9. `server/dbExtras.js` <a id="serverdbextrasjs"></a>

**Description:** SQLite migration layer (verification_status, trip started_at, stop_dwell_logs, otp_verifications PK), prepared statement caching, student verification queue, 60-day dwell audit logs, Route 51 manifest seeding, and audit logging.  
**File Path:** `sreenidhi-express/server/dbExtras.js`  

```javascript
// server/dbExtras.js — schema additions + queries the hardened API needs. Pass in the DatabaseSync from excelStorage.
import crypto from 'node:crypto';
import { resolveStopForStudent, ROUTE_TOPOLOGY, normalizeRouteTopologyId, ROUTE_51_SEED_RIDERS } from './routeTopology.js';
import { hashPassword } from './security.js';

export function createExtras(db) {
  const cols = (t) => db.prepare(`PRAGMA table_info(${t})`).all().map((c) => c.name);
  const addCol = (t, c, def) => { if (!cols(t).includes(c)) db.exec(`ALTER TABLE ${t} ADD COLUMN ${c} ${def}`); };

  function migrate() {
    addCol('students', 'password_hash', 'TEXT');
    addCol('students', 'telegram_chat_id', 'TEXT');
    addCol('students', 'fee_status', "TEXT NOT NULL DEFAULT 'PAID'");
    addCol('students', 'grace_until', 'INTEGER NOT NULL DEFAULT 0');
    addCol('students', 'grace_count', 'INTEGER NOT NULL DEFAULT 0');
    addCol('students', 'must_change_password', 'INTEGER NOT NULL DEFAULT 0');
    addCol('students', 'session_version', 'INTEGER NOT NULL DEFAULT 0');
    addCol('students', 'student_phone', "TEXT DEFAULT ''");
    addCol('students', 'student_phone_verified', 'INTEGER NOT NULL DEFAULT 0');
    addCol('students', 'parent_phone_verified', 'INTEGER NOT NULL DEFAULT 0');
    addCol('students', 'current_billing_cycle', "TEXT NOT NULL DEFAULT '2026-TERM-1'");
    addCol('students', 'last_grace_cycle', "TEXT DEFAULT ''");
    addCol('students', 'stop_id', 'TEXT');
    addCol('students', 'area_cluster_id', 'TEXT');
    addCol('students', 'rider_type', "TEXT NOT NULL DEFAULT 'STUDENT'");
    addCol('students', 'gender', "TEXT DEFAULT 'M'");
    addCol('students', 'verification_status', "TEXT NOT NULL DEFAULT 'VERIFIED'");
    addCol('students', 'email', "TEXT DEFAULT ''");
    db.exec(`
      CREATE TABLE IF NOT EXISTS processed_events (event_id TEXT PRIMARY KEY, received_at TEXT NOT NULL);
      CREATE TABLE IF NOT EXISTS driver_trip_logs (
        id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT NOT NULL, route_id TEXT, driver_name TEXT,
        bus_reg TEXT, direction TEXT, skipped_clusters TEXT, fuel_saved TEXT, cost_saved TEXT);
      CREATE TABLE IF NOT EXISTS parent_alerts_log (
        id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT NOT NULL, recipient_phone TEXT,
        student_roll TEXT, message TEXT, alert_type TEXT, delivery_status TEXT);
      CREATE TABLE IF NOT EXISTS applications (
        id TEXT PRIMARY KEY, roll_number TEXT NOT NULL, student_name TEXT, request_type TEXT, title TEXT,
        description TEXT, proof_url TEXT, requested_value TEXT, status TEXT NOT NULL DEFAULT 'PENDING_SCRUTINY',
        admin_note TEXT, reviewed_by TEXT, reviewed_at TEXT, created_at TEXT NOT NULL);
      CREATE TABLE IF NOT EXISTS telegram_link_codes (
        code TEXT PRIMARY KEY, roll_number TEXT NOT NULL, expires_at INTEGER NOT NULL, used INTEGER NOT NULL DEFAULT 0);
      CREATE TABLE IF NOT EXISTS absences (
        roll_number TEXT NOT NULL, day TEXT NOT NULL, created_at TEXT NOT NULL,
        PRIMARY KEY (roll_number, day));
      CREATE TABLE IF NOT EXISTS route_plans (
        route_id TEXT NOT NULL,
        day TEXT NOT NULL,
        skipped_clusters_json TEXT NOT NULL DEFAULT '[]',
        override_keep_clusters_json TEXT NOT NULL DEFAULT '[]',
        locked INTEGER NOT NULL DEFAULT 0,
        locked_at TEXT,
        estimated_minutes_saved INTEGER NOT NULL DEFAULT 0,
        estimated_km_saved REAL NOT NULL DEFAULT 0,
        updated_at TEXT NOT NULL,
        PRIMARY KEY (route_id, day));
      CREATE TABLE IF NOT EXISTS trip_states (
        route_id TEXT PRIMARY KEY,
        running INTEGER NOT NULL DEFAULT 0,
        delay_minutes INTEGER NOT NULL DEFAULT 0,
        headcount INTEGER NOT NULL DEFAULT 0,
        updated_at TEXT NOT NULL);
      CREATE TABLE IF NOT EXISTS incidents (
        id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, kind TEXT NOT NULL,
        who TEXT NOT NULL, route_id TEXT, msg TEXT NOT NULL, open INTEGER NOT NULL DEFAULT 1);
      CREATE TABLE IF NOT EXISTS announcements (
        id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, route_id TEXT,
        msg TEXT NOT NULL);
      CREATE TABLE IF NOT EXISTS lost_and_found (
        id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, who TEXT NOT NULL,
        contact TEXT, msg TEXT NOT NULL, open INTEGER NOT NULL DEFAULT 1);
      CREATE TABLE IF NOT EXISTS ride_feedback (
        id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, roll_number TEXT NOT NULL,
        student_name TEXT NOT NULL, route_id TEXT NOT NULL, rating INTEGER NOT NULL, msg TEXT NOT NULL);
      CREATE TABLE IF NOT EXISTS otp_verifications (
        account_roll TEXT NOT NULL,
        user_type TEXT NOT NULL,
        purpose TEXT NOT NULL DEFAULT 'PHONE_VERIFY',
        phone_number TEXT NOT NULL,
        otp TEXT NOT NULL,
        expires_at INTEGER NOT NULL,
        created_at INTEGER NOT NULL,
        attempts INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY (account_roll, user_type, purpose));
      CREATE TABLE IF NOT EXISTS migration_flags (
        name TEXT PRIMARY KEY, applied_at INTEGER NOT NULL);
      CREATE TABLE IF NOT EXISTS mobile_notifications (
        id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, recipient_type TEXT NOT NULL,
        roll_number TEXT, phone_number TEXT NOT NULL, category TEXT NOT NULL, title TEXT NOT NULL,
        message TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'DELIVERED', channel TEXT NOT NULL DEFAULT 'IN_APP_SMS');
      CREATE TABLE IF NOT EXISTS notification_preferences (
        roll_number TEXT NOT NULL, user_type TEXT NOT NULL, trip_started INTEGER NOT NULL DEFAULT 1,
        approaching_stop INTEGER NOT NULL DEFAULT 1, boarded INTEGER NOT NULL DEFAULT 1,
        traffic_delay INTEGER NOT NULL DEFAULT 1, campus_arrived INTEGER NOT NULL DEFAULT 1,
        emergency_broadcast INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (roll_number, user_type));
      CREATE TABLE IF NOT EXISTS active_stop_timers (
        route_id TEXT PRIMARY KEY,
        stop_name TEXT NOT NULL,
        started_at INTEGER NOT NULL,
        duration_seconds INTEGER NOT NULL,
        expires_at INTEGER NOT NULL);
      CREATE TABLE IF NOT EXISTS push_subscriptions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        roll_number TEXT NOT NULL,
        user_type TEXT NOT NULL,
        endpoint TEXT NOT NULL UNIQUE,
        p256dh TEXT NOT NULL,
        auth TEXT NOT NULL,
        created_at INTEGER NOT NULL
      );
      CREATE TABLE IF NOT EXISTS stop_segment_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        route_id TEXT NOT NULL,
        from_stop_id TEXT NOT NULL,
        to_stop_id TEXT NOT NULL,
        day_of_week INTEGER NOT NULL,
        shift TEXT NOT NULL,
        duration_sec INTEGER NOT NULL,
        recorded_at INTEGER NOT NULL
      );
      CREATE TABLE IF NOT EXISTS route_geometry_cache (
        cache_key TEXT PRIMARY KEY,
        route_id TEXT NOT NULL,
        geometry_json TEXT NOT NULL,
        distance_km REAL NOT NULL,
        duration_min INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
      );
      CREATE TABLE IF NOT EXISTS stop_dwell_logs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        route_id TEXT NOT NULL,
        stop_id TEXT NOT NULL,
        stop_name TEXT NOT NULL,
        arrived_at TEXT NOT NULL,
        departed_at TEXT NOT NULL,
        dwell_sec INTEGER NOT NULL,
        flag TEXT NOT NULL DEFAULT 'NORMAL',
        recorded_at INTEGER NOT NULL
      );
      CREATE TABLE IF NOT EXISTS admin_users (
        admin_id TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        password_hash TEXT NOT NULL,
        active INTEGER NOT NULL DEFAULT 1,
        session_version INTEGER NOT NULL DEFAULT 0,
        created_by TEXT,
        created_at TEXT NOT NULL
      );
      CREATE INDEX IF NOT EXISTS idx_admin_users_active ON admin_users(active);
      CREATE INDEX IF NOT EXISTS idx_dwell_route_ts ON stop_dwell_logs(route_id, recorded_at);
      CREATE INDEX IF NOT EXISTS idx_route_geom_route ON route_geometry_cache(route_id, updated_at);
      CREATE INDEX IF NOT EXISTS idx_push_sub_roll ON push_subscriptions(roll_number, user_type);
      CREATE INDEX IF NOT EXISTS idx_seg_hist_lookup ON stop_segment_history(route_id, from_stop_id, to_stop_id, day_of_week, shift, recorded_at);
      CREATE INDEX IF NOT EXISTS idx_att_roll_ts ON boarding_attendance(roll_number, timestamp);
      CREATE INDEX IF NOT EXISTS idx_att_route_ts ON boarding_attendance(route_id, timestamp);
      CREATE INDEX IF NOT EXISTS idx_apps_roll ON applications(roll_number);
      CREATE INDEX IF NOT EXISTS idx_mob_notif_roll ON mobile_notifications(roll_number, ts);
      CREATE INDEX IF NOT EXISTS idx_absences_day ON absences(day, roll_number);
      CREATE INDEX IF NOT EXISTS idx_incidents_route_ts ON incidents(route_id, open, ts);
      CREATE INDEX IF NOT EXISTS idx_trip_logs_route_ts ON driver_trip_logs(route_id, timestamp);
      CREATE INDEX IF NOT EXISTS idx_parent_alerts_ts ON parent_alerts_log(timestamp);
    `);
    addCol('otp_verifications', 'attempts', 'INTEGER NOT NULL DEFAULT 0');
    addCol('otp_verifications', 'account_roll', 'TEXT');
    addCol('otp_verifications', 'user_type', 'TEXT');
    addCol('otp_verifications', 'purpose', 'TEXT');
    addCol('trip_states', 'started_at', 'TEXT');
    // Rebuild legacy otp_verifications tables whose PRIMARY KEY was phone_number
    // so ON CONFLICT(account_roll, user_type, purpose) in saveOtp succeeds cleanly.
    const otpTableSql = db.prepare("SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'otp_verifications'").get()?.sql || '';
    if (otpTableSql && !/primary\s+key\s*\(\s*account_roll\s*,\s*user_type\s*,\s*purpose\s*\)/i.test(otpTableSql)) {
      tx(() => {
        db.exec(`
          DROP TABLE IF EXISTS otp_verifications_v2;
          CREATE TABLE otp_verifications_v2 (
            account_roll TEXT NOT NULL,
            user_type TEXT NOT NULL,
            purpose TEXT NOT NULL DEFAULT 'PHONE_VERIFY',
            phone_number TEXT NOT NULL,
            otp TEXT NOT NULL,
            expires_at INTEGER NOT NULL,
            created_at INTEGER NOT NULL,
            attempts INTEGER NOT NULL DEFAULT 0,
            PRIMARY KEY (account_roll, user_type, purpose)
          );
          INSERT OR IGNORE INTO otp_verifications_v2
            (account_roll, user_type, purpose, phone_number, otp, expires_at, created_at, attempts)
          SELECT
            COALESCE(NULLIF(account_roll, ''), phone_number),
            COALESCE(NULLIF(user_type, ''), 'STUDENT'),
            COALESCE(NULLIF(purpose, ''), 'PHONE_VERIFY'),
            phone_number,
            otp,
            expires_at,
            created_at,
            COALESCE(attempts, 0)
          FROM otp_verifications;
          DROP TABLE otp_verifications;
          ALTER TABLE otp_verifications_v2 RENAME TO otp_verifications;
        `);
      });
    }
    addCol('telegram_link_codes', 'kind', "TEXT NOT NULL DEFAULT 'TELEGRAM'");
    // The seed file creates a duplicate 'SUH24AIM014' alias row for Aarav; fold it away.
    db.prepare("DELETE FROM students WHERE roll_number = 'SUH24AIM014' AND EXISTS (SELECT 1 FROM students WHERE roll_number='23SN1A0501')").run();

    // Earlier builds created this column with a permissive default. There is
    // no trustworthy verification audit for those old values, so require a
    // fresh OTP once rather than treating a legacy flag as proof of ownership.
    const phoneResetDone = db.prepare("SELECT 1 FROM migration_flags WHERE name = 'phone_verification_reset_v3'").get();
    if (!phoneResetDone) {
      db.prepare('UPDATE students SET student_phone_verified = 0, parent_phone_verified = 0').run();
      db.prepare("INSERT INTO migration_flags (name, applied_at) VALUES ('phone_verification_reset_v3', ?)").run(Date.now());
    }

    // 90-day retention pruning for notifications & parent alerts (never prunes students, attendance, applications, absences)
    try {
      const ninetyDaysAgoMs = Date.now() - 90 * 864e5;
      const ninetyDaysAgoIso = new Date(ninetyDaysAgoMs).toISOString();
      db.prepare('DELETE FROM mobile_notifications WHERE ts < ?').run(ninetyDaysAgoMs);
      db.prepare('DELETE FROM parent_alerts_log WHERE timestamp < ?').run(ninetyDaysAgoIso);
    } catch {
      // Non-fatal if tables not yet initialized
    }

    // Seed default sample notifications if table is empty
    const notifCount = db.prepare('SELECT COUNT(*) as c FROM mobile_notifications').get()?.c || 0;
    if (notifCount === 0) {
      const now = Date.now();
      db.prepare(`INSERT INTO mobile_notifications (ts, recipient_type, roll_number, phone_number, category, title, message, status, channel) VALUES
        (?, 'ALL', '23SN1A0501', '+91 98765 43210', 'TRIP_STARTED', '🚀 Trip Started: Bus #14 En Route', 'Route 14 bus has departed Tarnaka terminal at 07:15 AM. Live GPS tracking is active.', 'DELIVERED', 'IN_APP_SMS'),
        (?, 'ALL', '23SN1A0501', '+91 98765 43210', 'APPROACHING_STOP', '⏱️ 5-Minute Heads Up: Tarnaka Stop', 'Bus #14 is approaching Tarnaka X Road (ETA: 4 mins). Please be ready at your boarding spot.', 'DELIVERED', 'IN_APP_SMS'),
        (?, 'ALL', '23SN1A0501', '+91 98765 43210', 'BOARDED', '🎒 Boarding Confirmed: Aarav Sharma', 'Student Aarav Sharma (23SN1A0501) has safely boarded Bus #14 at Tarnaka.', 'DELIVERED', 'IN_APP_SMS')
      `).run(now - 25 * 60 * 1000, now - 15 * 60 * 1000, now - 10 * 60 * 1000);
    }

    // Backfill stop_id and area_cluster_id for existing students
    try {
      const unmapped = db.prepare('SELECT roll_number, route_id, pickup_stop FROM students WHERE stop_id IS NULL OR area_cluster_id IS NULL').all();
      for (const s of unmapped) {
        const resolved = resolveStopForStudent(s.route_id, s.pickup_stop);
        if (resolved) {
          db.prepare('UPDATE students SET stop_id = ?, area_cluster_id = ? WHERE roll_number = ?')
            .run(resolved.stopId, resolved.areaClusterId, s.roll_number);
        }
      }
    } catch (e) {
      console.warn('[dbExtras] Student topology backfill non-fatal:', e);
    }

    // Seed Route 51 manifest riders (18 students + 8 faculty/staff)
    try {
      const isProd = process.env.NODE_ENV === 'production';
      const studentHash = 'scrypt$16384$8$1$kIJS-k9SIMhCdQRXXY4quA$MOO7S-6r3W_s4MDdjgqeKXo_H5MEg7Oin-5JyTmFPfKE45cCCqa1G9pJ2KTXjBUxcggrIUAAq_d2LybzoYv92A';
      const facultyHash = 'scrypt$16384$8$1$xMK1uRnRMbrm-8jCV4yAhw$i8-SdYytyncjSAGzUuMtaZYh-hE91GM4jK3yk3wNp0i4-DEs2P5m7oiisGhaGtafJCA6nYE-KNL3MDevglflww';
      const insertRider = db.prepare(`
        INSERT OR IGNORE INTO students
        (roll_number, name, program, route_id, pickup_stop, parent_name, parent_phone, pass_status, registered_at, last_active, password_hash, stop_id, area_cluster_id, rider_type, gender)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `);
      const updateRider = db.prepare(`
        UPDATE students
        SET password_hash = COALESCE(password_hash, ?),
            stop_id = COALESCE(stop_id, ?),
            area_cluster_id = COALESCE(area_cluster_id, ?),
            rider_type = COALESCE(rider_type, ?),
            gender = COALESCE(gender, ?)
        WHERE roll_number = ?
      `);
      for (const r of ROUTE_51_SEED_RIDERS) {
        const initialPasswordHash = isProd ? null : (r.rider_type === 'FACULTY' ? facultyHash : studentHash);
        insertRider.run(
          r.roll_number,
          r.name,
          r.program,
          r.route_id,
          r.pickup_stop,
          r.parent_name,
          r.parent_phone,
          r.pass_status,
          r.registered_at,
          r.last_active,
          initialPasswordHash,
          r.stop_id,
          r.area_cluster_id,
          r.rider_type,
          r.gender
        );
        updateRider.run(
          initialPasswordHash,
          r.stop_id,
          r.area_cluster_id,
          r.rider_type,
          r.gender,
          r.roll_number
        );
      }
      db.prepare("INSERT OR IGNORE INTO migration_flags (name, applied_at) VALUES ('route_51_manifest_seed_v1', ?)").run(Date.now());
      console.log('[dbExtras] Seeded 26 Route 51 manifest riders (18 students, 8 faculty)');

      // Fix 3 (P1): Backfill Dev password_hash for Legacy Seed Students on Fresh DB
      if (process.env.NODE_ENV !== 'production') {
        const legacyRolls = ['23SN1A0501', '23SN1A0542', '23SN1A0588', '23SN1A1208', '23SN1A0419'];
        const updateLegacy = db.prepare('UPDATE students SET password_hash = COALESCE(password_hash, ?) WHERE roll_number = ?');
        for (const roll of legacyRolls) {
          updateLegacy.run(studentHash, roll);
        }
      }

      // Fix 1 (P0): Seed 2 real Route 51 applications if applications table is empty
      const appCount = db.prepare('SELECT COUNT(*) as c FROM applications').get()?.c || 0;
      if (appCount === 0) {
        const nowIso = new Date().toISOString();
        const insertApp = db.prepare(`
          INSERT INTO applications (id, roll_number, student_name, request_type, title, description, status, created_at)
          VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        `);
        insertApp.run(
          'APP-2026-881',
          '26011CSEAI0109',
          'Makineedi Sai Venkata Syam Suraj',
          'BUS_PASS_RENEWAL',
          'Semester Bus Pass Fee Clearance',
          'College transport fee paid via SBI portal; request Route 51 pass activation.',
          'PENDING_SCRUTINY',
          nowIso
        );
        insertApp.run(
          'APP-2026-882',
          '26011CSEAI0112',
          'Mallu Jaswanth Reddy',
          'ROUTE_CHANGE',
          'Alternate Evening Drop at Ameerpet Metro',
          'Attending evening project lab until 6:00 PM on Route 51.',
          'PENDING_SCRUTINY',
          nowIso
        );
      }

      // Seed persistent demo parent access codes (1-year validity for demo convenience)
      if (process.env.NODE_ENV === 'production') {
        db.prepare("DELETE FROM telegram_link_codes WHERE code IN ('PARENT51', 'PARENT14')").run();
      } else {
        db.prepare(`
          INSERT OR REPLACE INTO telegram_link_codes (code, roll_number, expires_at, kind)
          VALUES ('PARENT51', '26011CSEAI0109', ?, 'PARENT'),
                 ('PARENT14', '23SN1A0501', ?, 'PARENT')
        `).run(Date.now() + 365 * 864e5, Date.now() + 365 * 864e5);
      }
    } catch (e) {
      console.warn('[dbExtras] Route 51 seeding non-fatal:', e);
    }
  }

  /** Run fn atomically (DatabaseSync has no .transaction helper). */
  function tx(fn) {
    db.exec('BEGIN IMMEDIATE');
    try { const r = fn(); db.exec('COMMIT'); return r; } catch (e) { db.exec('ROLLBACK'); throw e; }
  }

  const getStudentRow = (roll) => db.prepare('SELECT * FROM students WHERE roll_number = ?').get(roll);
  const setPasswordHash = (roll, hash) => db.prepare('UPDATE students SET password_hash = ? WHERE roll_number = ?').run(hash, roll).changes > 0;
  const getSessionVersion = (roll) => Number(getStudentRow(roll)?.session_version || 0);
  const isSessionCurrent = (roll, version) => getSessionVersion(roll) === Number(version || 0);
  const revokeStudentSessions = (roll) =>
    db.prepare('UPDATE students SET session_version = COALESCE(session_version, 0) + 1 WHERE roll_number = ?').run(roll).changes > 0;
  const touchLastActive = (roll) => db.prepare("UPDATE students SET last_active = ? WHERE roll_number = ?").run(new Date().toISOString().replace('T', ' ').slice(0, 19), roll);

  /** Create-only. Returns false (never overwrites) if the roll number already exists. */
  function createStudent(s, passwordHash) {
    const now = new Date().toISOString().replace('T', ' ').slice(0, 19);
    const routeId = s.routeId || s.route_id || null;
    const pickupStop = s.pickupStop || s.pickup_stop || null;
    const resolved = resolveStopForStudent(routeId, pickupStop);
    const stopId = s.stopId || s.stop_id || resolved?.stopId || null;
    const clusterId = s.areaClusterId || s.area_cluster_id || resolved?.areaClusterId || null;
    const riderType = s.riderType || s.rider_type || 'STUDENT';
    const gender = s.gender || 'M';
    const r = db.prepare(`INSERT OR IGNORE INTO students
      (roll_number,name,program,route_id,pickup_stop,parent_name,parent_phone,pass_status,registered_at,last_active,password_hash,stop_id,area_cluster_id,rider_type,gender)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).run(
        s.roll || s.roll_number || null,
        s.name || null,
        s.program || 'Engineering',
        routeId,
        pickupStop,
        s.parentName || s.parent_name || 'Parent',
        s.parentPhone || s.parent_phone || '+91 00000 00000',
        s.pass_status || 'ACTIVE',
        now,
        now,
        passwordHash || null,
        stopId,
        clusterId,
        riderType,
        gender
      );
    return r.changes === 1;
  }

  /** Idempotency: true the first time an eventId is seen, false on replays. */
  const claimEvent = (id) => db.prepare('INSERT OR IGNORE INTO processed_events (event_id, received_at) VALUES (?,?)').run(id, new Date().toISOString()).changes === 1;
  const pruneEvents = () => {
    const thirtyDaysAgoIso = new Date(Date.now() - 30 * 864e5).toISOString();
    const sixtyDaysAgoMs = Date.now() - 60 * 864e5;
    const ninetyDaysAgoMs = Date.now() - 90 * 864e5;
    const ninetyDaysAgoIso = new Date(ninetyDaysAgoMs).toISOString();
    try {
      db.prepare("DELETE FROM processed_events WHERE received_at < ?").run(thirtyDaysAgoIso);
      db.prepare('DELETE FROM stop_segment_history WHERE recorded_at < ?').run(sixtyDaysAgoMs);
      db.prepare('DELETE FROM stop_dwell_logs WHERE recorded_at < ?').run(sixtyDaysAgoMs);
      db.prepare('DELETE FROM mobile_notifications WHERE ts < ?').run(ninetyDaysAgoMs);
      db.prepare('DELETE FROM parent_alerts_log WHERE timestamp < ?').run(ninetyDaysAgoIso);
    } catch {}
  };

  const recentCheckIn = (roll, routeId, sinceMs) =>
    !!db.prepare("SELECT 1 FROM boarding_attendance WHERE roll_number=? AND route_id=? AND event_type LIKE 'BOARDED%' AND timestamp >= ? LIMIT 1")
      .get(roll, routeId, new Date(Date.now() - sinceMs).toISOString().replace('T', ' ').slice(0, 19));

  /* applications (were an in-memory Map → lost on restart) */
  const saveApplication = (a) => db.prepare(`INSERT INTO applications (id,roll_number,student_name,request_type,title,description,proof_url,requested_value,created_at)
    VALUES (?,?,?,?,?,?,?,?,?)`).run(a.id, a.roll, a.name, a.requestType, a.title, a.description, a.proofUrl, a.requestedValue, new Date().toISOString());
  const listApplications = (roll) => (roll
    ? db.prepare('SELECT * FROM applications WHERE roll_number = ? ORDER BY created_at DESC').all(roll)
    : db.prepare('SELECT * FROM applications ORDER BY created_at DESC LIMIT 500').all());
  const getApplication = (id) => db.prepare('SELECT * FROM applications WHERE id = ?').get(id);
  const reviewApplication = (id, status, note, by) => db.prepare('UPDATE applications SET status=?, admin_note=?, reviewed_by=?, reviewed_at=? WHERE id=?').run(status, note, by, new Date().toISOString(), id);

  /* Telegram parent linking: student asks for a code, parent sends "/start CODE" to the bot */
  function createLinkCode(roll) {
    const code = crypto.randomBytes(5).toString('hex').toUpperCase();
    db.prepare("INSERT INTO telegram_link_codes (code, roll_number, expires_at, kind) VALUES (?,?,?,'TELEGRAM')").run(code, roll, Date.now() + 24 * 3600e3);
    return code;
  }

  /** Parent-portal access code: 30 days, reusable on the parent's devices; generating a new one revokes the old ones. */
  function createParentCode(roll) {
    return tx(() => {
      db.prepare("DELETE FROM telegram_link_codes WHERE roll_number = ? AND kind = 'PARENT'").run(roll);
      const code = crypto.randomBytes(5).toString('hex').toUpperCase();
      db.prepare("INSERT INTO telegram_link_codes (code, roll_number, expires_at, kind) VALUES (?,?,?,'PARENT')").run(code, roll, Date.now() + 30 * 864e5);
      return code;
    });
  }
  const redeemParentCode = (code) =>
    db.prepare("SELECT roll_number FROM telegram_link_codes WHERE code = ? AND kind = 'PARENT' AND expires_at > ?").get(String(code).toUpperCase(), Date.now())?.roll_number ?? null;
  function consumeLinkCode(code, chatId) {
    return tx(() => {
      const row = db.prepare("SELECT * FROM telegram_link_codes WHERE code = ? AND kind = 'TELEGRAM' AND used = 0 AND expires_at > ?").get(String(code).toUpperCase(), Date.now());
      if (!row) return null;
      db.prepare('UPDATE telegram_link_codes SET used = 1 WHERE code = ?').run(row.code);
      db.prepare('UPDATE students SET telegram_chat_id = ? WHERE roll_number = ?').run(String(chatId), row.roll_number);
      return row.roll_number;
    });
  }

  /* Fee, Pass & 1-Day Grace Pass Rules */
  const getCurrentBillingCycle = () => process.env.CURRENT_BILLING_CYCLE || '2026-TERM-1';

  const activateGracePass = (roll) => {
    const s = getStudentRow(roll);
    if (!s) return { success: false, error: 'Student record not found' };
    const now = Date.now();
    if (s.grace_until && s.grace_until > now) {
      return { 
        success: false, 
        error: 'An emergency 1-day grace pass is already active for this account.',
        graceUntil: s.grace_until 
      };
    }
    const currentCycle = s.current_billing_cycle || getCurrentBillingCycle();
    const effectiveGraceCount = (s.last_grace_cycle === currentCycle) ? (s.grace_count || 0) : 0;
    // Strict limit: maximum 1 emergency grace pass per billing cycle for fee-due students
    if (effectiveGraceCount >= 1 && (s.fee_status || 'DUE').toUpperCase() !== 'PAID') {
      return { 
        success: false, 
        error: `Emergency 1-Day Grace Pass has already been used for billing cycle ${currentCycle}. Please clear outstanding transport fee or contact the Transport Scrutiny Desk.` 
      };
    }
    const graceUntil = now + 24 * 3600 * 1000;
    db.prepare('UPDATE students SET grace_until = ?, grace_count = ?, last_grace_cycle = ? WHERE roll_number = ?')
      .run(graceUntil, effectiveGraceCount + 1, currentCycle, roll);
    return { success: true, graceUntil };
  };

  const resetBillingCycle = (newCycle) => {
    return db.prepare('UPDATE students SET current_billing_cycle = ?, grace_count = 0').run(newCycle).changes;
  };

  const setFeeStatus = (roll, status) => {
    const isPaid = String(status).toUpperCase() === 'PAID';
    return db.prepare('UPDATE students SET fee_status = ?, pass_status = ? WHERE roll_number = ?')
      .run(isPaid ? 'PAID' : 'DUE', isPaid ? 'ACTIVE' : 'LOCKED', roll).changes > 0;
  };

  const canStudentTravel = (roll) => {
    const s = getStudentRow(roll);
    if (!s) return false;
    const feePaid = (s.fee_status || '').toUpperCase() === 'PAID';
    const passActive = (s.pass_status || '').toUpperCase() === 'ACTIVE';
    const graceActive = Boolean(s.grace_until && s.grace_until > Date.now());
    return (feePaid && passActive) || graceActive;
  };

  /* Password Forced Change */
  const setMustChangePassword = (roll, val) =>
    db.prepare('UPDATE students SET must_change_password = ? WHERE roll_number = ?').run(val ? 1 : 0, roll).changes > 0;
  const clearMustChangePassword = (roll) =>
    db.prepare('UPDATE students SET must_change_password = 0 WHERE roll_number = ?').run(roll).changes > 0;

  /* Route Helper & Exact Absence / Headcount Engine */
  function extractRouteNum(routeId) {
    const m = String(routeId || '').match(/\d+/);
    return m ? parseInt(m[0], 10) : null;
  }

  const getAssignedStudentCount = (routeId) => {
    const num = extractRouteNum(routeId);
    if (!num) return 0;
    const numPad = num < 10 ? '0' + num : String(num);
    const r = db.prepare(`SELECT COUNT(*) as c FROM students 
      WHERE (route_id = ? OR route_id = ? OR route_id = ? OR route_id LIKE ? OR route_id LIKE ? OR route_id LIKE ? OR route_id LIKE ?)
        AND (verification_status IS NULL OR verification_status = 'VERIFIED')`)
      .get(`route-${num}`, `Route ${num}`, `Route ${numPad}`, `Route ${num} %`, `Route ${numPad} %`, `Route ${num}-%`, `Route ${numPad}-%`);
    return r?.c || 0;
  };

  const listStudentsForRoute = (routeId) => {
    const num = extractRouteNum(routeId);
    if (!num) return [];
    const numPad = num < 10 ? '0' + num : String(num);
    return db.prepare(`SELECT * FROM students 
      WHERE (route_id = ? OR route_id = ? OR route_id = ? OR route_id LIKE ? OR route_id LIKE ? OR route_id LIKE ? OR route_id LIKE ?)
        AND (verification_status IS NULL OR verification_status = 'VERIFIED')`)
      .all(`route-${num}`, `Route ${num}`, `Route ${numPad}`, `Route ${num} %`, `Route ${numPad} %`, `Route ${num}-%`, `Route ${numPad}-%`);
  };

  /* Durable Active Stop Timers (one active stop per bus route, persists across restarts) */
  const setStopTimer = (routeId, stopName, durationSeconds = 120) => {
    const num = extractRouteNum(routeId) || 14;
    const norm = `route-${num}`;
    const nowMs = Date.now();
    const expiresAt = nowMs + durationSeconds * 1000;
    db.prepare(`
      INSERT INTO active_stop_timers (route_id, stop_name, started_at, duration_seconds, expires_at)
      VALUES (?, ?, ?, ?, ?)
      ON CONFLICT(route_id) DO UPDATE SET
        stop_name = excluded.stop_name,
        started_at = excluded.started_at,
        duration_seconds = excluded.duration_seconds,
        expires_at = excluded.expires_at
    `).run(norm, stopName, nowMs, durationSeconds, expiresAt);
    return { routeId: norm, stopName, durationSeconds, startedAt: nowMs, expiresAt };
  };

  const getStopTimer = (routeId) => {
    const num = extractRouteNum(routeId) || 14;
    const norm = `route-${num}`;
    const row = db.prepare('SELECT * FROM active_stop_timers WHERE route_id = ?').get(norm);
    if (!row) return null;
    const remainingSeconds = Math.max(0, Math.floor((row.expires_at - Date.now()) / 1000));
    if (remainingSeconds <= 0) {
      db.prepare('DELETE FROM active_stop_timers WHERE route_id = ?').run(norm);
      return null;
    }
    return {
      routeId: row.route_id,
      stopName: row.stop_name,
      durationSeconds: row.duration_seconds,
      startedAt: row.started_at,
      remainingSeconds,
      expiresAt: row.expires_at,
    };
  };

  const clearStopTimer = (routeId) => {
    const num = extractRouteNum(routeId) || 14;
    const norm = `route-${num}`;
    db.prepare('DELETE FROM active_stop_timers WHERE route_id = ?').run(norm);
  };

  const stopKey = (value) => String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');

  /* Boarding idempotency checker */
  const isBoardedToday = (roll, routeId) => {
    try {
      const num = extractRouteNum(routeId) || 14;
      const r = db.prepare(`
        SELECT 1 FROM boarding_attendance 
        WHERE roll_number = ? AND (route_id = ? OR route_id = ? OR route_id LIKE ?)
          AND event_type LIKE 'BOARDED%' AND date(timestamp) = date('now')
        LIMIT 1
      `).get(roll, `route-${num}`, `Route ${num}`, `%Route ${num}%`);
      return Boolean(r);
    } catch {
      return false;
    }
  };

  const isOptedOutToday = (roll, routeId) => {
    const num = extractRouteNum(routeId) || 14;
    return !!db.prepare(`SELECT 1 FROM boarding_attendance
      WHERE roll_number = ? AND (route_id = ? OR route_id = ? OR route_id LIKE ?)
        AND event_type = 'NOT_COMING_OPT_OUT' AND date(timestamp) = date('now') LIMIT 1`)
      .get(roll, `route-${num}`, `Route ${num}`, `%Route ${num}%`);
  };

  const getPendingStopStudentCount = (routeId, stopName) => {
    const routeNum = extractRouteNum(routeId);
    if (!routeNum) return 0;
    const rows = db.prepare('SELECT roll_number, route_id, pickup_stop FROM students').all();
    return rows.filter((row) =>
      extractRouteNum(row.route_id) === routeNum &&
      stopKey(row.pickup_stop) === stopKey(stopName) &&
      !isBoardedToday(row.roll_number, routeId) &&
      !isOptedOutToday(row.roll_number, routeId)
    ).length;
  };

  const clearStopTimerIfNoPending = (routeId, stopName) => {
    const timer = getStopTimer(routeId);
    if (!timer || stopKey(timer.stopName) !== stopKey(stopName)) return false;
    if (getPendingStopStudentCount(routeId, stopName) > 0) return false;
    clearStopTimer(routeId);
    return true;
  };

  /* Absences ("Not Travelling Tomorrow") */
  const setAbsence = (roll, day, absent) => {
    if (absent) {
      db.prepare('INSERT OR IGNORE INTO absences (roll_number, day, created_at) VALUES (?,?,?)').run(roll, day, new Date().toISOString());
    } else {
      db.prepare('DELETE FROM absences WHERE roll_number = ? AND day = ?').run(roll, day);
    }
  };
  const isAbsent = (roll, day) => !!db.prepare('SELECT 1 FROM absences WHERE roll_number = ? AND day = ?').get(roll, day);
  const listAbsences = (day) => {
    return db.prepare(`SELECT a.roll_number, a.day, s.name, s.route_id, s.pickup_stop, a.created_at
      FROM absences a LEFT JOIN students s ON a.roll_number = s.roll_number
      WHERE (? IS NULL OR a.day = ?) ORDER BY a.created_at DESC`).all(day || null, day || null);
  };
  const countAbsencesForRoute = (routeId, day) => {
    const num = extractRouteNum(routeId);
    if (!num) return 0;
    const numPad = num < 10 ? '0' + num : String(num);
    const r = db.prepare(`SELECT COUNT(*) as c FROM absences a
      JOIN students s ON a.roll_number = s.roll_number
      WHERE (s.route_id = ? OR s.route_id = ? OR s.route_id = ? OR s.route_id LIKE ? OR s.route_id LIKE ? OR s.route_id LIKE ? OR s.route_id LIKE ?)
        AND (s.verification_status IS NULL OR s.verification_status = 'VERIFIED')
        AND a.day = ?`)
      .get(`route-${num}`, `Route ${num}`, `Route ${numPad}`, `Route ${num} %`, `Route ${numPad} %`, `Route ${num}-%`, `Route ${numPad}-%`, day);
    return r?.c || 0;
  };

  /* Persistent Trip State Machine */
  const getTripState = (routeId) => {
    const num = extractRouteNum(routeId) || 14;
    const norm = `route-${num}`;
    const row = db.prepare('SELECT * FROM trip_states WHERE route_id = ?').get(norm);
    if (row) {
      return {
        running: Boolean(row.running),
        delayMinutes: row.delay_minutes || 0,
        headcount: row.headcount || 0,
        startedAt: row.started_at || null,
        updatedAt: row.updated_at
      };
    }
    return { running: false, delayMinutes: 0, headcount: 0, startedAt: null, updatedAt: new Date().toISOString() };
  };

  const setTripState = (routeId, running, delayMinutes, headcount, startedAt = undefined) => {
    const num = extractRouteNum(routeId) || 14;
    const norm = `route-${num}`;
    const now = new Date().toISOString();
    const existing = db.prepare('SELECT started_at FROM trip_states WHERE route_id = ?').get(norm);
    const effectiveStartedAt = startedAt !== undefined ? startedAt : (existing?.started_at ?? null);
    db.prepare(`INSERT OR REPLACE INTO trip_states (route_id, running, delay_minutes, headcount, started_at, updated_at)
      VALUES (?,?,?,?,?,?)`)
      .run(norm, running ? 1 : 0, delayMinutes || 0, headcount || 0, effectiveStartedAt, now);
    return getTripState(norm);
  };

  /* Incidents (SOS & Breakdowns) */
  const createIncident = (kind, who, routeId, msg) => {
    const r = db.prepare('INSERT INTO incidents (ts, kind, who, route_id, msg, open) VALUES (?,?,?,?,?,1)')
      .run(Date.now(), kind, who, routeId || 'route-14', msg);
    return r.lastInsertRowid;
  };
  const listIncidents = (openOnly) => {
    return openOnly
      ? db.prepare('SELECT * FROM incidents WHERE open = 1 ORDER BY id DESC').all()
      : db.prepare('SELECT * FROM incidents ORDER BY id DESC LIMIT 500').all();
  };
  const resolveIncident = (id) =>
    db.prepare('UPDATE incidents SET open = 0 WHERE id = ?').run(id).changes > 0;

  /* Announcements */
  const createAnnouncement = (routeId, msg) => {
    const r = db.prepare('INSERT INTO announcements (ts, route_id, msg) VALUES (?,?,?)')
      .run(Date.now(), routeId || 'ALL', msg);
    return r.lastInsertRowid;
  };
  const listAnnouncements = (routeId) => {
    return db.prepare('SELECT * FROM announcements WHERE (? IS NULL OR route_id = ? OR route_id = \'ALL\') ORDER BY id DESC LIMIT 50')
      .all(routeId || null, routeId || null);
  };
  const deleteAnnouncement = (id) =>
    db.prepare('DELETE FROM announcements WHERE id = ?').run(id).changes > 0;

  /* Lost and Found */
  const reportLostItem = (who, contact, msg) => {
    const r = db.prepare('INSERT INTO lost_and_found (ts, who, contact, msg, open) VALUES (?,?,?,?,1)')
      .run(Date.now(), who, contact || '', msg);
    return r.lastInsertRowid;
  };
  const listLostItems = (openOnly) => {
    return openOnly
      ? db.prepare('SELECT * FROM lost_and_found WHERE open = 1 ORDER BY id DESC').all()
      : db.prepare('SELECT * FROM lost_and_found ORDER BY id DESC LIMIT 200').all();
  };
  const resolveLostItem = (id) =>
    db.prepare('UPDATE lost_and_found SET open = 0 WHERE id = ?').run(id).changes > 0;

  /* Ride Feedback */
  const saveFeedback = (roll, name, routeId, rating, msg) => {
    const r = db.prepare('INSERT INTO ride_feedback (ts, roll_number, student_name, route_id, rating, msg) VALUES (?,?,?,?,?,?)')
      .run(Date.now(), roll, name, routeId || 'route-14', rating, msg);
    return r.lastInsertRowid;
  };
  const listFeedback = () =>
    db.prepare('SELECT * FROM ride_feedback ORDER BY id DESC LIMIT 500').all();

  /* Mobile Phone & OTP Verification */
  const saveOtp = (arg1, arg2, arg3, arg4) => {
    let roll, userType, phone, otp;
    if (arg3 === undefined) {
      phone = String(arg1 || '');
      otp = String(arg2 || '');
      roll = phone;
      userType = 'STUDENT';
    } else {
      roll = String(arg1 || '');
      userType = String(arg2 || 'STUDENT');
      phone = String(arg3 || '');
      otp = String(arg4 || '');
    }
    const expiresAt = Date.now() + 5 * 60 * 1000;
    // Key by (account_roll, user_type, purpose). Resending a code preserves failed attempts.
    const existing = db.prepare("SELECT attempts FROM otp_verifications WHERE account_roll = ? AND user_type = ? AND purpose = 'PHONE_VERIFY'")
      .get(roll, userType);
    const attempts = existing ? Number(existing.attempts || 0) : 0;
    db.prepare(`INSERT INTO otp_verifications
      (account_roll, user_type, purpose, phone_number, otp, expires_at, created_at, attempts)
      VALUES (?, ?, 'PHONE_VERIFY', ?, ?, ?, ?, ?)
      ON CONFLICT(account_roll, user_type, purpose) DO UPDATE SET
        phone_number = excluded.phone_number,
        otp = excluded.otp,
        expires_at = excluded.expires_at,
        created_at = excluded.created_at`)
      .run(roll, userType, phone, String(otp), expiresAt, Date.now(), attempts);
  };

  const verifyOtp = (arg1, arg2, arg3, arg4) => {
    let roll, userType, phone, otp;
    if (arg3 === undefined) {
      phone = String(arg1 || '');
      otp = String(arg2 || '');
      roll = phone;
      userType = 'STUDENT';
    } else {
      roll = String(arg1 || '');
      userType = String(arg2 || 'STUDENT');
      phone = String(arg3 || '');
      otp = String(arg4 || '');
    }
    const row = db.prepare(`SELECT * FROM otp_verifications
      WHERE account_roll = ? AND user_type = ? AND purpose = 'PHONE_VERIFY' AND expires_at > ?`)
      .get(roll, userType, Date.now());
    if (!row) return false;
    const currentAttempts = (row.attempts || 0) + 1;
    if (currentAttempts > 5) {
      db.prepare("DELETE FROM otp_verifications WHERE account_roll = ? AND user_type = ? AND purpose = 'PHONE_VERIFY'")
        .run(roll, userType);
      return false;
    }
    if (row.phone_number === phone && row.otp === String(otp).trim()) {
      db.prepare("DELETE FROM otp_verifications WHERE account_roll = ? AND user_type = ? AND purpose = 'PHONE_VERIFY'")
        .run(roll, userType);
      return true;
    }
    db.prepare("UPDATE otp_verifications SET attempts = ? WHERE account_roll = ? AND user_type = ? AND purpose = 'PHONE_VERIFY'")
      .run(currentAttempts, roll, userType);
    return false;
  };

  /* Password Reset Codes (₹0 Self-Service + Admin Desk / Telegram) */
  const savePasswordResetCode = (rollNumber, contactLabel, code, ttlMs = 15 * 60 * 1000) => {
    const roll = String(rollNumber || '').trim().toUpperCase();
    if (!roll) return false;
    const nowMs = Date.now();
    const expiresAt = nowMs + Math.max(60_000, Number(ttlMs) || 15 * 60 * 1000);
    db.prepare(`
      INSERT INTO otp_verifications
        (account_roll, user_type, purpose, phone_number, otp, expires_at, created_at, attempts)
      VALUES (?, 'STUDENT', 'PASSWORD_RESET', ?, ?, ?, ?, 0)
      ON CONFLICT(account_roll, user_type, purpose) DO UPDATE SET
        phone_number = excluded.phone_number,
        otp = excluded.otp,
        expires_at = excluded.expires_at,
        created_at = excluded.created_at,
        attempts = 0
    `).run(roll, String(contactLabel || ''), String(code || '').trim(), expiresAt, nowMs);
    return true;
  };

  const verifyPasswordResetCode = (rollNumber, code) => {
    const roll = String(rollNumber || '').trim().toUpperCase();
    const row = db.prepare(`
      SELECT * FROM otp_verifications
      WHERE account_roll = ? AND user_type = 'STUDENT' AND purpose = 'PASSWORD_RESET'
    `).get(roll);
    if (!row) return { ok: false, reason: 'NOT_FOUND' };
    if (Number(row.expires_at) < Date.now()) {
      db.prepare("DELETE FROM otp_verifications WHERE account_roll = ? AND user_type = 'STUDENT' AND purpose = 'PASSWORD_RESET'")
        .run(roll);
      return { ok: false, reason: 'EXPIRED' };
    }
    const prevAttempts = Number(row.attempts || 0);
    if (prevAttempts >= 5) {
      db.prepare("DELETE FROM otp_verifications WHERE account_roll = ? AND user_type = 'STUDENT' AND purpose = 'PASSWORD_RESET'")
        .run(roll);
      return { ok: false, reason: 'MAX_ATTEMPTS' };
    }
    const expectedBuf = Buffer.from(String(row.otp || '').trim(), 'utf8');
    const providedBuf = Buffer.from(String(code || '').trim(), 'utf8');
    const match =
      expectedBuf.length > 0 &&
      expectedBuf.length === providedBuf.length &&
      crypto.timingSafeEqual(expectedBuf, providedBuf);

    if (!match) {
      const nextAttempts = prevAttempts + 1;
      if (nextAttempts >= 5) {
        db.prepare("DELETE FROM otp_verifications WHERE account_roll = ? AND user_type = 'STUDENT' AND purpose = 'PASSWORD_RESET'")
          .run(roll);
        return { ok: false, reason: 'MAX_ATTEMPTS' };
      }
      db.prepare("UPDATE otp_verifications SET attempts = ? WHERE account_roll = ? AND user_type = 'STUDENT' AND purpose = 'PASSWORD_RESET'")
        .run(nextAttempts, roll);
      return { ok: false, reason: 'INVALID_CODE' };
    }

    db.prepare("DELETE FROM otp_verifications WHERE account_roll = ? AND user_type = 'STUDENT' AND purpose = 'PASSWORD_RESET'")
      .run(roll);
    return { ok: true };
  };

  const listActivePasswordResetRequests = () => {
    return db.prepare(`
      SELECT o.account_roll, COALESCE(s.name, '') AS name, o.phone_number, o.otp, o.expires_at, o.created_at
      FROM otp_verifications o
      LEFT JOIN students s ON UPPER(s.roll_number) = UPPER(o.account_roll)
      WHERE o.user_type = 'STUDENT' AND o.purpose = 'PASSWORD_RESET' AND o.expires_at > ?
      ORDER BY o.created_at DESC
    `).all(Date.now());
  };

  const updateStudentPhone = (roll, phone) => {
    return db.prepare('UPDATE students SET student_phone = ?, student_phone_verified = 1 WHERE roll_number = ?')
      .run(phone, roll).changes > 0;
  };

  const updateParentPhone = (roll, phone) => {
    return db.prepare('UPDATE students SET parent_phone = ?, parent_phone_verified = 1 WHERE roll_number = ?')
      .run(phone, roll).changes > 0;
  };

  const updateStudentPhoneVerified = (roll) => {
    return db.prepare('UPDATE students SET student_phone_verified = 1 WHERE roll_number = ?')
      .run(roll).changes > 0;
  };

  const updateParentPhoneVerified = (roll) => {
    return db.prepare('UPDATE students SET parent_phone_verified = 1 WHERE roll_number = ?')
      .run(roll).changes > 0;
  };

  /* Mobile Push / SMS Notifications */
  const logNotification = (n) => {
    const r = db.prepare(`INSERT INTO mobile_notifications 
      (ts, recipient_type, roll_number, phone_number, category, title, message, status, channel) 
      VALUES (?,?,?,?,?,?,?,?,?)`)
      .run(n.ts || Date.now(), n.recipient_type || 'ALL', n.roll_number || null, n.phone_number || '', n.category || 'INFO', n.title || 'Transit Alert', n.message, n.status || 'DELIVERED', n.channel || 'IN_APP_SMS');
    return r.lastInsertRowid;
  };

  const listNotifications = (roll, userType) => {
    return db.prepare(`SELECT * FROM mobile_notifications 
      WHERE (roll_number IS NULL OR roll_number = ? OR roll_number = 'ALL')
        AND (recipient_type = 'ALL' OR recipient_type = ?)
      ORDER BY ts DESC LIMIT 50`).all(roll || 'ALL', userType || 'STUDENT');
  };

  /* Preferences */
  const getNotificationPreferences = (roll, userType) => {
    const row = db.prepare('SELECT * FROM notification_preferences WHERE roll_number = ? AND user_type = ?')
      .get(roll, userType);
    if (row) return row;
    return {
      roll_number: roll,
      user_type: userType,
      trip_started: 1,
      approaching_stop: 1,
      boarded: 1,
      traffic_delay: 1,
      campus_arrived: 1,
      emergency_broadcast: 1
    };
  };

  const saveNotificationPreferences = (roll, userType, prefs) => {
    return db.prepare(`INSERT OR REPLACE INTO notification_preferences 
      (roll_number, user_type, trip_started, approaching_stop, boarded, traffic_delay, campus_arrived, emergency_broadcast)
      VALUES (?,?,?,?,?,?,?,?)`)
      .run(
        roll,
        userType,
        prefs.trip_started ? 1 : 0,
        prefs.approaching_stop ? 1 : 0,
        prefs.boarded ? 1 : 0,
        prefs.traffic_delay ? 1 : 0,
        prefs.campus_arrived ? 1 : 0,
        prefs.emergency_broadcast ? 1 : 0
      ).changes > 0;
  };

  /* Route Optimization Engine (Server-Authoritative, Fail-Safe Area Skip) */
  function computeRouteOptimization(routeId, day) {
    const normRoute = normalizeRouteTopologyId(routeId);
    const topology = ROUTE_TOPOLOGY[normRoute] || ROUTE_TOPOLOGY['route-14'];
    const planRow = db.prepare('SELECT * FROM route_plans WHERE route_id = ? AND day = ?').get(normRoute, day);
    
    const locked = Boolean(planRow?.locked);
    const lockedAt = planRow?.locked_at || null;
    let overrideKeepClusters = [];
    try {
      if (planRow?.override_keep_clusters_json) {
        overrideKeepClusters = JSON.parse(planRow.override_keep_clusters_json);
      }
    } catch {}

    let lockedSkippedClusters = [];
    try {
      if (planRow?.skipped_clusters_json) {
        lockedSkippedClusters = JSON.parse(planRow.skipped_clusters_json);
      }
    } catch {}

    // Get all registered students on this route
    const students = listStudentsForRoute(normRoute);
    const unmappedStudents = [];

    for (const s of students) {
      if (!s.stop_id || !s.area_cluster_id) {
        const resolved = resolveStopForStudent(s.route_id, s.pickup_stop);
        if (resolved) {
          s.stop_id = resolved.stopId;
          s.area_cluster_id = resolved.areaClusterId;
          try {
            db.prepare('UPDATE students SET stop_id = ?, area_cluster_id = ? WHERE roll_number = ?')
              .run(resolved.stopId, resolved.areaClusterId, s.roll_number);
          } catch {}
        } else {
          unmappedStudents.push({
            rollNumber: s.roll_number,
            name: s.name,
            pickupStop: s.pickup_stop,
          });
        }
      }
    }

    // Query active absences for day
    const absentRows = db.prepare('SELECT roll_number FROM absences WHERE day = ?').all(day);
    const absentRolls = new Set(absentRows.map((r) => String(r.roll_number).toUpperCase()));

    const clusters = [];
    for (const cl of topology.clusters || []) {
      const clusterStudents = students.filter((s) => s.area_cluster_id === cl.areaClusterId);
      const totalStudents = clusterStudents.length;
      const studentCount = clusterStudents.filter((s) => (s.rider_type || 'STUDENT').toUpperCase() === 'STUDENT').length;
      const facultyCount = clusterStudents.filter((s) => (s.rider_type || 'STUDENT').toUpperCase() === 'FACULTY').length;
      const absentStudents = clusterStudents.filter((s) => absentRolls.has(String(s.roll_number).toUpperCase())).length;
      const comingStudents = totalStudents - absentStudents;
      const isAdminKept = overrideKeepClusters.includes(cl.areaClusterId);
      const isCampus = cl.areaClusterId === 'cluster-campus';

      const stops = (cl.stopIds || []).map((stopId) => {
        const stopObj = topology.stops.find((s) => s.id === stopId);
        const stopStudents = clusterStudents.filter((s) => s.stop_id === stopId);
        const stopAbsent = stopStudents.filter((s) => absentRolls.has(String(s.roll_number).toUpperCase())).length;
        const stopStudentCount = stopStudents.filter((s) => (s.rider_type || 'STUDENT').toUpperCase() === 'STUDENT').length;
        const stopFacultyCount = stopStudents.filter((s) => (s.rider_type || 'STUDENT').toUpperCase() === 'FACULTY').length;
        return {
          stopId,
          stopName: stopObj ? stopObj.name : stopId,
          shortName: stopObj ? (stopObj.shortName || stopObj.name) : stopId,
          total: stopStudents.length,
          totalStudents: stopStudents.length,
          absent: stopAbsent,
          coming: stopStudents.length - stopAbsent,
          studentCount: stopStudentCount,
          facultyCount: stopFacultyCount,
        };
      });

      let canSkip = false;
      let reason = '';
      if (isCampus) {
        canSkip = false;
        reason = 'Campus hub is never skippable';
      } else if (isAdminKept) {
        canSkip = false;
        reason = 'Admin Override: Forced Active';
      } else if (unmappedStudents.length > 0) {
        canSkip = false;
        reason = `Route has ${unmappedStudents.length} unmapped student(s) — Skip disabled for safety`;
      } else if (totalStudents === 0) {
        canSkip = false;
        reason = 'No registered students in cluster — Skip disabled';
      } else if (comingStudents === 0) {
        canSkip = true;
        reason = `All ${totalStudents} student(s) across stops marked Not Coming — Reroute Active`;
      } else {
        canSkip = false;
        reason = `${comingStudents} of ${totalStudents} student(s) still coming — Must Stop`;
      }

      clusters.push({
        areaClusterId: cl.areaClusterId,
        clusterId: cl.areaClusterId,
        areaClusterName: cl.areaClusterName,
        clusterName: cl.areaClusterName,
        stopIds: cl.stopIds,
        totalStudents,
        totalRegisteredStudents: totalStudents,
        studentCount,
        facultyCount,
        absentStudents,
        comingStudents,
        canSkip,
        isSkipped: canSkip,
        isCampus,
        isAdminKept,
        reason,
        stops,
        estimatedMinutesSaved: cl.estimatedMinutesSaved || 0,
        estimatedKmSaved: cl.estimatedKmSaved || 0,
      });
    }

    let skippedClusterIds = [];
    if (locked) {
      skippedClusterIds = lockedSkippedClusters;
    } else {
      skippedClusterIds = clusters.filter((c) => c.canSkip).map((c) => c.areaClusterId);
    }

    for (const c of clusters) {
      c.isSkipped = skippedClusterIds.includes(c.areaClusterId);
    }

    const allStops = topology.stops || [];
    const skippedStopIds = allStops.filter((s) => skippedClusterIds.includes(s.areaClusterId)).map((s) => s.id);
    const activeStopIds = allStops.filter((s) => !skippedClusterIds.includes(s.areaClusterId)).map((s) => s.id);

    let estimatedMinutesSaved = 0;
    let estimatedKmSaved = 0;
    for (const clId of skippedClusterIds) {
      const cl = topology.clusters.find((c) => c.areaClusterId === clId);
      if (cl) {
        estimatedMinutesSaved += cl.estimatedMinutesSaved || 0;
        estimatedKmSaved += cl.estimatedKmSaved || 0;
      }
    }
    estimatedKmSaved = Number(estimatedKmSaved.toFixed(2));

    // Persist plan if not locked
    const nowIso = new Date().toISOString();
    if (!locked) {
      db.prepare(`
        INSERT INTO route_plans (route_id, day, skipped_clusters_json, override_keep_clusters_json, locked, estimated_minutes_saved, estimated_km_saved, updated_at)
        VALUES (?, ?, ?, ?, 0, ?, ?, ?)
        ON CONFLICT(route_id, day) DO UPDATE SET
          skipped_clusters_json = excluded.skipped_clusters_json,
          estimated_minutes_saved = excluded.estimated_minutes_saved,
          estimated_km_saved = excluded.estimated_km_saved,
          updated_at = excluded.updated_at
        WHERE route_plans.locked = 0
      `).run(
        normRoute,
        day,
        JSON.stringify(skippedClusterIds),
        JSON.stringify(overrideKeepClusters),
        estimatedMinutesSaved,
        estimatedKmSaved,
        nowIso
      );
    }

    const totalRouteStudents = students.length;
    const studentCount = students.filter((s) => (s.rider_type || 'STUDENT').toUpperCase() === 'STUDENT').length;
    const facultyCount = students.filter((s) => (s.rider_type || 'STUDENT').toUpperCase() === 'FACULTY').length;
    const absentRouteStudents = students.filter((s) => absentRolls.has(String(s.roll_number).toUpperCase())).length;

    return {
      routeId: normRoute,
      day,
      locked,
      lockedAt,
      cutoffTimeIst: '1h pre-departure',
      totalRouteStudents,
      studentCount,
      facultyCount,
      absentRouteStudents,
      expectedRouteStudents: totalRouteStudents - absentRouteStudents,
      skippedClusterIds,
      activeStopIds,
      skippedStopIds,
      clusters,
      unmappedStudents,
      estimatedMinutesSaved,
      estimatedKmSaved,
      overrideKeepClusters,
    };
  }

  function setRoutePlanLock(routeId, day, lock) {
    const normRoute = normalizeRouteTopologyId(routeId);
    const nowIso = new Date().toISOString();
    let skippedJson = '[]';
    if (lock) {
      // Snapshot the calculated live skipped clusters at lock time
      const live = computeRouteOptimization(normRoute, day);
      skippedJson = JSON.stringify(live.skippedClusterIds || []);
    }
    const existing = db.prepare('SELECT * FROM route_plans WHERE route_id = ? AND day = ?').get(normRoute, day);
    if (!existing) {
      db.prepare(`INSERT INTO route_plans (route_id, day, skipped_clusters_json, override_keep_clusters_json, locked, locked_at, updated_at)
        VALUES (?, ?, ?, '[]', ?, ?, ?)`).run(normRoute, day, skippedJson, lock ? 1 : 0, lock ? nowIso : null, nowIso);
    } else {
      if (lock) {
        db.prepare('UPDATE route_plans SET locked = 1, locked_at = ?, skipped_clusters_json = ?, updated_at = ? WHERE route_id = ? AND day = ?')
          .run(nowIso, skippedJson, nowIso, normRoute, day);
      } else {
        db.prepare('UPDATE route_plans SET locked = 0, locked_at = NULL, updated_at = ? WHERE route_id = ? AND day = ?')
          .run(nowIso, normRoute, day);
      }
    }
    return computeRouteOptimization(normRoute, day);
  }

  function setClusterOverride(routeId, day, clusterId, keep) {
    const normRoute = normalizeRouteTopologyId(routeId);
    const nowIso = new Date().toISOString();
    const existing = db.prepare('SELECT * FROM route_plans WHERE route_id = ? AND day = ?').get(normRoute, day);
    let overrides = [];
    try {
      if (existing?.override_keep_clusters_json) {
        overrides = JSON.parse(existing.override_keep_clusters_json);
      }
    } catch {}
    if (keep) {
      if (!overrides.includes(clusterId)) overrides.push(clusterId);
    } else {
      overrides = overrides.filter((c) => c !== clusterId);
    }
    if (!existing) {
      db.prepare(`INSERT INTO route_plans (route_id, day, skipped_clusters_json, override_keep_clusters_json, locked, updated_at)
        VALUES (?, ?, '[]', ?, 0, ?)`).run(normRoute, day, JSON.stringify(overrides), nowIso);
    } else {
      db.prepare('UPDATE route_plans SET override_keep_clusters_json = ?, updated_at = ? WHERE route_id = ? AND day = ?')
        .run(JSON.stringify(overrides), nowIso, normRoute, day);
    }
    return computeRouteOptimization(normRoute, day);
  }

  function getRoutePlan(routeId, day) {
    const normRoute = normalizeRouteTopologyId(routeId);
    return db.prepare('SELECT * FROM route_plans WHERE route_id = ? AND day = ?').get(normRoute, day);
  }

  function savePushSubscription(roll, userType, sub) {
    if (!sub || !sub.endpoint || !sub.keys?.p256dh || !sub.keys?.auth) return false;
    const now = Date.now();
    db.prepare(`
      INSERT INTO push_subscriptions (roll_number, user_type, endpoint, p256dh, auth, created_at)
      VALUES (?, ?, ?, ?, ?, ?)
      ON CONFLICT(endpoint) DO UPDATE SET
        roll_number = excluded.roll_number,
        user_type = excluded.user_type,
        p256dh = excluded.p256dh,
        auth = excluded.auth,
        created_at = excluded.created_at
    `).run(String(roll).trim(), String(userType).trim(), String(sub.endpoint).trim(), String(sub.keys.p256dh).trim(), String(sub.keys.auth).trim(), now);
    return true;
  }

  function deletePushSubscription(endpoint) {
    if (!endpoint) return false;
    const res = db.prepare('DELETE FROM push_subscriptions WHERE endpoint = ?').run(String(endpoint).trim());
    return res.changes > 0;
  }

  function listPushSubscriptions({ roll, routeId, userType } = {}) {
    let sql = 'SELECT * FROM push_subscriptions WHERE 1=1';
    const params = [];
    if (roll) {
      sql += ' AND roll_number = ?';
      params.push(String(roll).trim());
    } else if (routeId) {
      sql += ` AND (roll_number IN (SELECT roll_number FROM students WHERE route_id = ?) OR user_type IN ('DRIVER', 'ADMIN'))`;
      params.push(String(routeId).trim());
    }
    if (userType) {
      sql += ' AND user_type = ?';
      params.push(String(userType).trim());
    }
    sql += ' ORDER BY id ASC';
    return db.prepare(sql).all(...params);
  }

  function recordStopSegmentDuration(routeId, fromStopId, toStopId, durationSec, recordedAt = Date.now()) {
    const d = Number(durationSec);
    if (!Number.isFinite(d) || d < 30 || d > 3600) return false;
    if (!fromStopId || !toStopId) return false;
    const normRoute = normalizeRouteTopologyId(routeId);

    // Compute IST day_of_week (0-6) and shift (MORNING if IST hour < 12 else EVENING)
    const istOffsetMs = 5.5 * 60 * 60 * 1000;
    const istDate = new Date(recordedAt + istOffsetMs);
    const dayOfWeek = istDate.getUTCDay();
    const istHour = istDate.getUTCHours();
    const shift = istHour < 12 ? 'MORNING' : 'EVENING';

    db.prepare(`
      INSERT INTO stop_segment_history (route_id, from_stop_id, to_stop_id, day_of_week, shift, duration_sec, recorded_at)
      VALUES (?, ?, ?, ?, ?, ?, ?)
    `).run(normRoute, String(fromStopId).trim(), String(toStopId).trim(), dayOfWeek, shift, Math.round(d), recordedAt);
    return true;
  }

  function getHistoricalSegmentMedians(routeId, dayOfWeek, shift, lookbackDays = 14) {
    const normRoute = normalizeRouteTopologyId(routeId);
    const cutoff = Date.now() - (lookbackDays * 864e5);
    let sql = 'SELECT from_stop_id, to_stop_id, duration_sec FROM stop_segment_history WHERE route_id = ? AND recorded_at >= ?';
    const params = [normRoute, cutoff];
    if (dayOfWeek !== undefined && dayOfWeek !== null) {
      sql += ' AND day_of_week = ?';
      params.push(Number(dayOfWeek));
    }
    if (shift) {
      sql += ' AND shift = ?';
      params.push(String(shift).trim());
    }
    sql += ' ORDER BY from_stop_id, to_stop_id, duration_sec ASC';
    const rows = db.prepare(sql).all(...params);

    const grouped = new Map();
    for (const r of rows) {
      const key = `${r.from_stop_id}->${r.to_stop_id}`;
      if (!grouped.has(key)) grouped.set(key, []);
      grouped.get(key).push(r.duration_sec);
    }

    const medians = {};
    for (const [key, durations] of grouped.entries()) {
      if (durations.length < 3) continue;
      const n = durations.length;
      let medianSec;
      if (n % 2 === 1) {
        medianSec = durations[Math.floor(n / 2)];
      } else {
        medianSec = Math.round((durations[n / 2 - 1] + durations[n / 2]) / 2);
      }
      medians[key] = { medianSec, sampleCount: n };
    }
    return medians;
  }

  function bulkImportRiders(riders) {
    if (!Array.isArray(riders)) return { success: false, error: 'riders must be an array' };
    const maxRows = 500;
    const slice = riders.slice(0, maxRows);

    return tx(() => {
      let createdCount = 0;
      let skippedExistingCount = 0;
      const errors = [];
      const credentials = [];
      const now = new Date().toISOString().replace('T', ' ').slice(0, 19);

      for (let i = 0; i < slice.length; i++) {
        const row = slice[i];
        const rowIdx = i + 1;
        const rollNumber = typeof row?.rollNumber === 'string' ? row.rollNumber.trim() : (typeof row?.roll_number === 'string' ? row.roll_number.trim() : '');
        const name = typeof row?.name === 'string' ? row.name.trim() : (typeof row?.student_name === 'string' ? row.student_name.trim() : '');
        const routeId = typeof row?.routeId === 'string' ? row.routeId.trim() : (typeof row?.route_id === 'string' ? row.route_id.trim() : '');
        const pickupStop = typeof row?.pickupStop === 'string' ? row.pickupStop.trim() : (typeof row?.pickup_stop === 'string' ? row.pickup_stop.trim() : '');

        if (!rollNumber || !name || !routeId || !pickupStop) {
          errors.push({
            row: rowIdx,
            rollNumber: rollNumber || 'UNKNOWN',
            error: 'Missing required field (rollNumber, name, routeId, pickupStop)',
          });
          continue;
        }

        const existing = db.prepare('SELECT roll_number FROM students WHERE roll_number = ?').get(rollNumber);
        if (existing) {
          skippedExistingCount++;
          continue;
        }

        const temporaryPassword = crypto.randomBytes(6).toString('base64url');
        const passwordHash = hashPassword(temporaryPassword);

        const routeNorm = normalizeRouteTopologyId(routeId);
        const resolved = resolveStopForStudent(routeNorm, pickupStop);
        const stopId = row.stopId || row.stop_id || resolved?.stopId || pickupStop;
        const clusterId = row.areaClusterId || row.area_cluster_id || resolved?.areaClusterId || 'CENTRAL';
        const rawType = (row.riderType || row.rider_type || '').toUpperCase();
        const riderType = rawType === 'FACULTY' ? 'FACULTY' : 'STUDENT';
        const gender = row.gender || 'M';
        const program = row.program || (riderType === 'FACULTY' ? 'Faculty Member' : 'Engineering');
        const parentName = row.parentName || row.parent_name || (riderType === 'FACULTY' ? 'N/A' : 'Parent');
        const parentPhone = row.parentPhone || row.parent_phone || '+91 00000 00000';

        db.prepare(`
          INSERT INTO students (
            roll_number, name, program, route_id, pickup_stop, parent_name, parent_phone,
            pass_status, fee_status, registered_at, last_active, password_hash, stop_id,
            area_cluster_id, rider_type, gender, must_change_password
          ) VALUES (?, ?, ?, ?, ?, ?, ?, 'ACTIVE', 'PAID', ?, ?, ?, ?, ?, ?, ?, 1)
        `).run(
          rollNumber,
          name,
          program,
          routeNorm,
          pickupStop,
          parentName,
          parentPhone,
          now,
          now,
          passwordHash,
          stopId,
          clusterId,
          riderType,
          gender
        );

        createdCount++;
        credentials.push({
          rollNumber,
          name,
          routeId: routeNorm,
          pickupStop,
          riderType,
          temporaryPassword,
        });
      }

      return {
        success: true,
        createdCount,
        skippedExistingCount,
        errors,
        credentials,
      };
    });
  }

  function getCachedRouteGeometry(cacheKey, maxAgeMs = 30 * 24 * 3600 * 1000) {
    if (typeof cacheKey !== 'string' || !cacheKey) return null;
    const row = db.prepare('SELECT route_id, geometry_json, distance_km, duration_min, updated_at FROM route_geometry_cache WHERE cache_key = ?').get(cacheKey);
    if (!row) return null;
    if (maxAgeMs <= 0 || (Date.now() - row.updated_at > maxAgeMs)) return null;
    try {
      return {
        routeId: row.route_id,
        coordinates: JSON.parse(row.geometry_json),
        distanceKm: row.distance_km,
        durationMinutes: row.duration_min,
        updatedAt: row.updated_at,
      };
    } catch {
      return null;
    }
  }

  function saveCachedRouteGeometry(cacheKey, routeId, coordinates, distanceKm, durationMinutes) {
    if (!cacheKey || !routeId || !Array.isArray(coordinates)) return false;
    db.prepare(`
      INSERT INTO route_geometry_cache (cache_key, route_id, geometry_json, distance_km, duration_min, updated_at)
      VALUES (?, ?, ?, ?, ?, ?)
      ON CONFLICT(cache_key) DO UPDATE SET
        route_id = excluded.route_id,
        geometry_json = excluded.geometry_json,
        distance_km = excluded.distance_km,
        duration_min = excluded.duration_min,
        updated_at = excluded.updated_at
    `).run(
      String(cacheKey),
      String(routeId),
      JSON.stringify(coordinates),
      Number(distanceKm) || 0,
      Math.round(Number(durationMinutes) || 0),
      Date.now()
    );
    return true;
  }

  /* ---------------- Driver Stop Dwell & Utility Audit Logs ---------------- */
  function recordStopDwell(routeId, stopId, stopName, arrivedAtIso, departedAtIso, dwellSec) {
    const normRoute = normalizeRouteTopologyId(routeId);
    const cleanSec = Math.max(0, Math.round(Number(dwellSec) || 0));
    const flag = cleanSec < 45 ? 'TOO_SHORT' : cleanSec > 300 ? 'TOO_LONG' : 'NORMAL';
    const recordedAt = Date.now();

    db.prepare(`
      INSERT INTO stop_dwell_logs (route_id, stop_id, stop_name, arrived_at, departed_at, dwell_sec, flag, recorded_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      normRoute,
      String(stopId || '').trim() || 'stop',
      String(stopName || '').trim() || 'Stop',
      String(arrivedAtIso || new Date(recordedAt - cleanSec * 1000).toISOString()),
      String(departedAtIso || new Date(recordedAt).toISOString()),
      cleanSec,
      flag,
      recordedAt
    );

    try {
      db.prepare('DELETE FROM stop_dwell_logs WHERE recorded_at < ?').run(recordedAt - 60 * 864e5);
    } catch {}

    return { routeId: normRoute, stopId, stopName, arrivedAt: arrivedAtIso, departedAt: departedAtIso, dwellSec: cleanSec, flag, recordedAt };
  }

  function getDriverUtilityLogs(routeId = null, limit = 100) {
    const safeLimit = Math.max(1, Math.min(500, Math.round(Number(limit) || 100)));
    if (routeId) {
      const normRoute = normalizeRouteTopologyId(routeId);
      return db.prepare('SELECT * FROM stop_dwell_logs WHERE route_id = ? ORDER BY recorded_at DESC, id DESC LIMIT ?')
        .all(normRoute, safeLimit);
    }
    return db.prepare('SELECT * FROM stop_dwell_logs ORDER BY recorded_at DESC, id DESC LIMIT ?').all(safeLimit);
  }

  /* ---------------- Self-Signup & Transport Office 1-Click Verification ---------------- */
  function createPendingStudent({ rollNumber, name, email, passwordHash, studentPhone, pickupStop }) {
    const roll = String(rollNumber || '').trim().toUpperCase();
    if (!roll) return false;
    const now = new Date().toISOString().replace('T', ' ').slice(0, 19);
    const cleanPhone = String(studentPhone || '').replace(/\D/g, '').slice(-10);
    const r = db.prepare(`
      INSERT OR IGNORE INTO students (
        roll_number, name, email, program, route_id, pickup_stop,
        parent_name, parent_phone, pass_status, fee_status,
        registered_at, last_active, password_hash,
        student_phone, student_phone_verified, must_change_password,
        rider_type, verification_status
      ) VALUES (?, ?, ?, 'B.Tech', 'UNASSIGNED', ?, 'Parent', '', 'ACTIVE', 'PAID', ?, ?, ?, ?, 0, 0, 'STUDENT', 'PENDING_VERIFICATION')
    `).run(
      roll,
      String(name || '').trim(),
      String(email || '').trim().toLowerCase(),
      String(pickupStop || '').trim(),
      now,
      now,
      passwordHash || null,
      cleanPhone
    );
    return r.changes === 1;
  }

  function listPendingVerifications() {
    return db.prepare(`
      SELECT roll_number, name, email, student_phone, pickup_stop, registered_at, verification_status
      FROM students
      WHERE verification_status = 'PENDING_VERIFICATION'
      ORDER BY roll_number ASC
    `).all();
  }

  function verifyStudentRegistration(rollNumber, { approved, routeId, pickupStop } = {}) {
    const roll = String(rollNumber || '').trim().toUpperCase();
    const existing = getStudentRow(roll);
    if (!existing) return null;

    if (approved) {
      const targetRoute = routeId
        ? normalizeRouteTopologyId(routeId)
        : (existing.route_id && existing.route_id !== 'UNASSIGNED' ? normalizeRouteTopologyId(existing.route_id) : 'route-51');
      const targetStop = (pickupStop && String(pickupStop).trim()) || existing.pickup_stop || 'Erragadda';
      const resolved = resolveStopForStudent(targetRoute, targetStop);
      db.prepare(`
        UPDATE students
        SET verification_status = 'VERIFIED',
            route_id = ?,
            pickup_stop = ?,
            stop_id = ?,
            area_cluster_id = ?
        WHERE roll_number = ?
      `).run(
        targetRoute,
        targetStop,
        resolved?.stopId || null,
        resolved?.areaClusterId || null,
        roll
      );
      return {
        success: true,
        rollNumber: roll,
        verificationStatus: 'VERIFIED',
        routeId: targetRoute,
        pickupStop: targetStop,
        stopId: resolved?.stopId || null,
      };
    }

    db.prepare("UPDATE students SET verification_status = 'REJECTED' WHERE roll_number = ?").run(roll);
    return {
      success: true,
      rollNumber: roll,
      verificationStatus: 'REJECTED',
    };
  }

  /* ---------------- Multi-Admin Access Accounts ---------------- */
  function getAdminUser(adminId) {
    const cleanId = String(adminId || '').trim();
    if (!cleanId) return null;
    return db.prepare('SELECT * FROM admin_users WHERE LOWER(admin_id) = LOWER(?)').get(cleanId) || null;
  }

  function hasAnyActiveAdmin() {
    return Boolean(db.prepare('SELECT 1 FROM admin_users WHERE active = 1 LIMIT 1').get());
  }

  function listAdminUsers() {
    return db
      .prepare('SELECT admin_id, name, active, session_version, created_by, created_at FROM admin_users ORDER BY created_at ASC, admin_id ASC')
      .all();
  }

  function createAdminUser({ adminId, name, passwordHash, createdBy }) {
    const cleanId = String(adminId || '').trim();
    const cleanName = String(name || '').trim() || cleanId;
    if (!cleanId || !passwordHash) return null;
    if (getAdminUser(cleanId)) return null;
    const createdAt = new Date().toISOString();
    db.prepare(`
      INSERT INTO admin_users (admin_id, name, password_hash, active, session_version, created_by, created_at)
      VALUES (?, ?, ?, 1, 0, ?, ?)
    `).run(cleanId, cleanName, passwordHash, createdBy ? String(createdBy).trim() : null, createdAt);
    return {
      admin_id: cleanId,
      name: cleanName,
      active: 1,
      session_version: 0,
      created_by: createdBy ? String(createdBy).trim() : null,
      created_at: createdAt,
    };
  }

  function setAdminUserActive(adminId, active) {
    const existing = getAdminUser(adminId);
    if (!existing) return null;
    const nextActive = active ? 1 : 0;
    const bumpSession = nextActive === 0 ? 1 : 0;
    db.prepare(`
      UPDATE admin_users
      SET active = ?, session_version = session_version + ?
      WHERE LOWER(admin_id) = LOWER(?)
    `).run(nextActive, bumpSession, existing.admin_id);
    const updated = getAdminUser(existing.admin_id);
    if (!updated) return null;
    return {
      admin_id: updated.admin_id,
      name: updated.name,
      active: updated.active,
      session_version: updated.session_version,
      created_by: updated.created_by,
      created_at: updated.created_at,
    };
  }

  function setAdminPasswordHash(adminId, passwordHash) {
    const existing = getAdminUser(adminId);
    if (!existing) return false;
    db.prepare('UPDATE admin_users SET password_hash = ?, session_version = session_version + 1 WHERE LOWER(admin_id) = LOWER(?)')
      .run(passwordHash, existing.admin_id);
    return true;
  }

  return { migrate, tx, getStudentRow, setPasswordHash, touchLastActive, getSessionVersion, isSessionCurrent, revokeStudentSessions, createStudent, claimEvent, pruneEvents, recentCheckIn,
    saveApplication, listApplications, getApplication, reviewApplication, createLinkCode, consumeLinkCode, createParentCode, redeemParentCode,
    activateGracePass, setFeeStatus, canStudentTravel, setAbsence, isAbsent, listAbsences, countAbsencesForRoute, getAssignedStudentCount, listStudentsForRoute,
    getTripState, setTripState, setMustChangePassword, clearMustChangePassword,
    createIncident, listIncidents, resolveIncident, createAnnouncement, listAnnouncements, deleteAnnouncement,
    reportLostItem, listLostItems, resolveLostItem, saveFeedback, listFeedback,
    saveOtp, verifyOtp, savePasswordResetCode, verifyPasswordResetCode, listActivePasswordResetRequests,
    updateStudentPhone, updateParentPhone, updateStudentPhoneVerified, updateParentPhoneVerified, logNotification, listNotifications,
    getNotificationPreferences, saveNotificationPreferences, resetBillingCycle,
    setStopTimer, getStopTimer, clearStopTimer, clearStopTimerIfNoPending, getPendingStopStudentCount, isBoardedToday, isOptedOutToday,
    computeRouteOptimization, setRoutePlanLock, setClusterOverride, getRoutePlan,
    savePushSubscription, deletePushSubscription, listPushSubscriptions,
    recordStopSegmentDuration, getHistoricalSegmentMedians, bulkImportRiders,
    getCachedRouteGeometry, saveCachedRouteGeometry,
    recordStopDwell, getDriverUtilityLogs,
    createPendingStudent, listPendingVerifications, verifyStudentRegistration,
    getAdminUser, hasAnyActiveAdmin, listAdminUsers, createAdminUser, setAdminUserActive, setAdminPasswordHash };
}

```

---

## 10. `server/index.js` <a id="serverindexjs"></a>

**Description:** Express 5 REST API server with timing-safe HMAC JWT auth, self-signup + 1-click admin verification, self-checkin boarding, stop dwell audit logging, 1-hour pre-departure absence cutoff, SSE live stream tickets, and CARTO tile proxy.  
**File Path:** `sreenidhi-express/server/index.js`  

```javascript
// server/index.js — hardened TransitPulse API (Express 5). Replaces the previous file.
try { process.loadEnvFile?.(); } catch {}
import express from 'express';
import cors from 'cors';
import path from 'node:path';
import fs from 'node:fs';
import crypto from 'node:crypto';
import { fileURLToPath } from 'node:url';
import { db, DATA_DIR, DB_FILE_PATH, EXCEL_FILE_PATH, generateExcelFileFromDb, getExcelSummary, appendSheetRow, maskPhoneNumber, getAllStudents, createSqliteBackup } from './excelStorage.js';
import { createExtras } from './dbExtras.js';
import { sendTelegramAlert } from './telegramNotifier.js';
import { getRouteStops, ROUTE_TOPOLOGY } from './routeTopology.js';
import * as webpushModule from 'web-push';
import {
  IS_PROD, signToken, verifyToken, requireAuth, requireRole, setAccessTokenValidator, hashPassword, verifyPassword, verifyDummy, rateLimit,
  buildCorsOptions, escapeHtml, normalizeRoute, haversineKm, gateToken, verifyGateToken, GATE_STEP_SECONDS,
  validateEvent, utcStamp, HttpError, CSP_HEADER,
} from './security.js';

const wp = webpushModule.default || webpushModule;
const VAPID_PUBLIC_KEY = process.env.VAPID_PUBLIC_KEY || '';
const VAPID_PRIVATE_KEY = process.env.VAPID_PRIVATE_KEY || '';
const VAPID_SUBJECT = process.env.VAPID_SUBJECT || 'mailto:transport@sreenidhi.edu.in';
const CARTO_API_KEY = (process.env.CARTO_API_KEY || '').trim();

let vapidConfigured = false;
if (VAPID_PUBLIC_KEY && VAPID_PRIVATE_KEY) {
  try {
    wp.setVapidDetails(VAPID_SUBJECT, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY);
    vapidConfigured = true;
  } catch (err) {
    console.warn('[WebPush] Failed to configure VAPID:', err.message);
  }
}

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const distPath = path.resolve(__dirname, '../dist');
const PORT = Number(process.env.PORT) || 3001;

const extras = createExtras(db);
extras.migrate();

async function sendWebPush({ roll, routeId, userType, title, body, url = '/' } = {}) {
  if (!vapidConfigured) return;
  try {
    const subs = extras.listPushSubscriptions({ roll, routeId, userType });
    if (!subs || subs.length === 0) return;

    const payload = JSON.stringify({
      title: title || 'Sreenidhi Express',
      body: body || '',
      url: url || '/',
    });

    await Promise.allSettled(
      subs.map(async (sub) => {
        const pushSubscription = {
          endpoint: sub.endpoint,
          keys: {
            p256dh: sub.p256dh,
            auth: sub.auth,
          },
        };
        try {
          await wp.sendNotification(pushSubscription, payload);
        } catch (err) {
          if (err.statusCode === 404 || err.statusCode === 410) {
            extras.deletePushSubscription(sub.endpoint);
          }
        }
      })
    );
  } catch (err) {
    console.warn('[WebPush] Error dispatching push:', err.message);
  }
}

setAccessTokenValidator((user) => {
  if (user.role === 'ADMIN' && user.adminSource === 'DATABASE') {
    const adminRow = extras.getAdminUser(user.sub);
    if (!adminRow || !adminRow.active) return false;
    if (adminRow.session_version !== Number(user.sessionVersion || 0)) return false;
    return true;
  }
  if (user.role !== 'STUDENT') return true;
  const row = extras.getStudentRow(user.sub);
  if (!row) return false;
  if (row.verification_status && row.verification_status !== 'VERIFIED') return false;
  if (row.session_version !== Number(user.sessionVersion || 0)) return false;
  if (row.must_change_password && !user.mustChangePassword) return false;
  return true;
});

const app = express();
if (process.env.TRUST_PROXY) app.set('trust proxy', Number(process.env.TRUST_PROXY) || 1);
app.disable('x-powered-by');
app.use((req, res, next) => {
  res.set({
    'X-Content-Type-Options': 'nosniff',
    'X-Frame-Options': 'DENY',
    'Referrer-Policy': 'strict-origin-when-cross-origin',
    'Content-Security-Policy': CSP_HEADER,
  });
  if (IS_PROD) res.set('Strict-Transport-Security', 'max-age=15552000');
  next();
});
app.use(cors(buildCorsOptions()));
app.use((req, res, next) => {
  if (req.path === '/api/admin/students/bulk-import') {
    return next();
  }
  express.json({ limit: '32kb' })(req, res, next);
});

// Request logging for API visibility and debugging
app.use((req, res, next) => {
  const t0 = Date.now();
  const url = req.originalUrl || req.url;
  res.on('finish', () => {
    if (!url.startsWith('/assets/')) {
      console.log(`[HTTP] ${req.method} ${url} -> ${res.statusCode} (${Date.now() - t0}ms) from ${req.ip}`);
    }
  });
  next();
});

const now = () => new Date().toISOString().replace('T', ' ').slice(0, 19);
const str = (v, max, name) => {
  if (typeof v !== 'string' || !v.trim() || v.length > max) throw new HttpError(400, `${name} is required (max ${max} chars)`);
  return v.trim();
};
const sameStopName = (a, b) =>
  String(a || '').trim().toLowerCase().replace(/\s+/g, ' ') ===
  String(b || '').trim().toLowerCase().replace(/\s+/g, ' ');
const resolveStudentRoll = (user) => {
  if (!user) throw new HttpError(401, 'Unauthorized');
  if (user.role === 'PARENT') {
    if (!user.wardRoll || typeof user.wardRoll !== 'string' || !user.wardRoll.trim()) {
      throw new HttpError(403, 'Parent token missing wardRoll');
    }
    return user.wardRoll.trim().toUpperCase();
  }
  return user.sub;
};
const rowToStudent = (s, { maskPhone = true } = {}) => ({
  'Roll Number': s.roll_number,
  'Student Name': s.name,
  'Department / Program': s.program,
  'Assigned Route': s.route_id,
  'Pickup Stop': s.pickup_stop,
  'Parent Name': s.parent_name,
  'Parent Phone': maskPhone ? maskPhoneNumber(s.parent_phone) : s.parent_phone,
  'Pass Status': s.pass_status,
  'Fee Status': s.fee_status || 'PAID',
  'Registered At': s.registered_at,
  'Last Active': s.last_active,
  mustChangePassword: Boolean(s.must_change_password),
  studentPhone: s.student_phone || '',
  studentPhoneVerified: Boolean(s.student_phone_verified),
  parentPhoneVerified: Boolean(s.parent_phone_verified),
  riderType: (s.rider_type || 'STUDENT').toUpperCase(),
  gender: s.gender || 'M',
  verificationStatus: s.verification_status || 'VERIFIED',
  boardedToday: extras.isBoardedToday(s.roll_number, s.route_id),
});

/* ---------------- limiters ---------------- */
const loginKey = (req) => `${req.ip}|${String(req.body?.rollNumber ?? req.body?.adminId ?? req.body?.routeId ?? req.body?.code ?? '').trim().toUpperCase()}`;
const loginLimiter = rateLimit({ windowMs: 15 * 60_000, max: IS_PROD ? 8 : 100, key: loginKey, message: 'Too many attempts. Try again in 15 minutes.' });
const ipLoginLimiter = rateLimit({ windowMs: 15 * 60_000, max: IS_PROD ? 300 : 500 }); // blunt IP-wide cap against credential stuffing (300 in prod for campus Wi-Fi & CGNAT)
const apiLimiter = rateLimit({ windowMs: 60_000, max: 240, key: (r) => r.user?.sub ?? r.ip });
const telemetryLimiter = rateLimit({ windowMs: 60_000, max: 120, key: (r) => r.user?.sub ?? r.ip });
const alertLimiter = rateLimit({ windowMs: 60_000, max: 10, key: (r) => r.user?.sub ?? r.ip, message: 'Alert rate limit reached' });
const otpRequestLimiter = rateLimit({ windowMs: 10 * 60_000, max: 3, key: (r) => `${r.ip}|${r.user?.sub || 'anonymous'}|${r.body?.userType || ''}`, message: 'Too many OTP requests. Please wait 10 minutes.' });
const authLimiter = rateLimit({ windowMs: 15 * 60_000, max: IS_PROD ? 10 : 120, key: loginKey, message: 'Too many password reset requests. Please try again later.' });
const dispatchLimiter = rateLimit({ windowMs: 60_000, max: 5, key: (r) => r.user?.sub ?? r.ip, message: 'Too many notification dispatches' });
const tileLimiter = rateLimit({ windowMs: 60_000, max: 600, key: (r) => r.ip });

/* ---------------- Server-Side CARTO Tile Proxy & LRU Cache ---------------- */
const TILE_CACHE_MAX = 1500;
const TILE_CACHE_TTL_MS = 24 * 60 * 60 * 1000;
const tileCache = new Map();
let warnedNoCartoKey = false;

app.get('/api/tiles/:theme/:z/:x/:y', tileLimiter, async (req, res) => {
  const { theme, z: rawZ, x: rawX, y: rawY } = req.params;
  if (theme !== 'voyager' && theme !== 'dark_all') {
    return res.status(400).json({ error: 'Invalid tile theme' });
  }

  const cleanY = String(rawY || '').replace(/\.png$/i, '');
  if (!/^\d+$/.test(String(rawZ)) || !/^\d+$/.test(String(rawX)) || !/^\d+$/.test(cleanY)) {
    return res.status(400).json({ error: 'Invalid tile coordinates' });
  }

  const z = Number.parseInt(rawZ, 10);
  const x = Number.parseInt(rawX, 10);
  const y = Number.parseInt(cleanY, 10);

  if (!Number.isInteger(z) || z < 0 || z > 19) {
    return res.status(400).json({ error: 'Invalid tile coordinates' });
  }

  const maxCoord = 1 << z;
  if (!Number.isInteger(x) || x < 0 || x >= maxCoord || !Number.isInteger(y) || y < 0 || y >= maxCoord) {
    return res.status(400).json({ error: 'Invalid tile coordinates' });
  }

  const cacheKey = `${theme}/${z}/${x}/${y}`;
  const cached = tileCache.get(cacheKey);
  if (cached) {
    if (Date.now() - cached.timestamp < TILE_CACHE_TTL_MS) {
      tileCache.delete(cacheKey);
      tileCache.set(cacheKey, cached);
      res.set({
        'Content-Type': 'image/png',
        'Cache-Control': 'public, max-age=86400',
      });
      return res.send(cached.buffer);
    }
    tileCache.delete(cacheKey);
  }

  if (!CARTO_API_KEY && !warnedNoCartoKey) {
    warnedNoCartoKey = true;
    console.warn('[tiles] CARTO_API_KEY not set — CARTO will watermark tiles');
  }

  const baseUrl = theme === 'dark_all'
    ? `https://a.basemaps.cartocdn.com/dark_all/${z}/${x}/${y}.png`
    : `https://a.basemaps.cartocdn.com/rastertiles/voyager/${z}/${x}/${y}.png`;
  const upstreamUrl = CARTO_API_KEY ? `${baseUrl}?key=${encodeURIComponent(CARTO_API_KEY)}` : baseUrl;

  try {
    const upstreamRes = await fetch(upstreamUrl, {
      signal: AbortSignal.timeout(8000),
      headers: {
        'User-Agent': 'SreenidhiExpress/1.0',
      },
    });

    const ctype = upstreamRes.headers.get('content-type') || '';
    if (!upstreamRes.ok || !ctype.startsWith('image/')) {
      return res.status(502).json({ error: 'Tile upstream unavailable' });
    }

    const arrayBuffer = await upstreamRes.arrayBuffer();
    const buffer = Buffer.from(arrayBuffer);

    if (tileCache.size >= TILE_CACHE_MAX) {
      const oldestKey = tileCache.keys().next().value;
      if (oldestKey) tileCache.delete(oldestKey);
    }
    tileCache.set(cacheKey, { buffer, timestamp: Date.now() });

    res.set({
      'Content-Type': 'image/png',
      'Cache-Control': 'public, max-age=86400',
    });
    return res.send(buffer);
  } catch {
    return res.status(502).json({ error: 'Tile upstream unavailable' });
  }
});

/* ---------------- health (minimal, no internals) ---------------- */
app.get('/api/health', (req, res) => res.json({ status: 'ONLINE' }));

/* ---------------- authentication ---------------- */
app.post('/api/students/register', ipLoginLimiter, async (req, res) => {
  const rollNumber = str(req.body?.rollNumber, 20, 'rollNumber').toUpperCase();
  const name = str(req.body?.name, 80, 'name');
  const email = str(req.body?.email, 120, 'email').toLowerCase();
  const password = typeof req.body?.password === 'string' ? req.body.password : '';
  const studentPhone = String(req.body?.studentPhone || '').replace(/\D/g, '').slice(-10);
  const pickupStop = str(req.body?.pickupStop, 80, 'pickupStop');

  if (!email.includes('@')) throw new HttpError(400, 'Please enter a valid college email address');
  if (password.length < 8) throw new HttpError(400, 'Password must be at least 8 characters');
  if (studentPhone.length !== 10) throw new HttpError(400, 'Please enter a valid 10-digit mobile number');

  const existing = extras.getStudentRow(rollNumber);
  if (existing) {
    return res.status(409).json({
      success: false,
      error: 'Roll number is already registered. Sign in or contact the Transport Office.',
    });
  }

  const passwordHash = await hashPassword(password);
  const created = extras.createPendingStudent({
    rollNumber,
    name,
    email,
    passwordHash,
    studentPhone,
    pickupStop,
  });
  if (!created) {
    return res.status(409).json({
      success: false,
      error: 'Roll number is already registered.',
    });
  }

  appendSheetRow('Alerts_Notifications', {
    Timestamp: now(),
    'Alert ID': `REG-${Date.now()}`,
    'Recipient Name': 'Transport Office',
    Category: 'REGISTRATION',
    Title: 'New Student Self-Signup',
    Message: `${name} (${rollNumber}) requested stop "${pickupStop}" — awaiting 1-click verification.`,
    'Delivery Status': 'PENDING',
  });

  res.status(201).json({
    success: true,
    status: 'PENDING_VERIFICATION',
    rollNumber,
    message: 'Submitted — awaiting Transport Office tick-mark approval & bus assignment.',
  });
});

app.post('/api/students/login', ipLoginLimiter, loginLimiter, async (req, res) => {
  const roll = str(req.body?.rollNumber, 20, 'rollNumber').toUpperCase();
  const password = typeof req.body?.password === 'string' ? req.body.password : '';
  const row = extras.getStudentRow(roll);
  const ok = row?.password_hash ? await verifyPassword(password, row.password_hash) : await verifyDummy(password);
  if (!ok) return res.status(401).json({ success: false, error: 'Invalid roll number or password' }); // same message for both cases

  if (row.verification_status === 'PENDING_VERIFICATION') {
    return res.status(403).json({
      success: false,
      code: 'ACCOUNT_PENDING_VERIFICATION',
      error: 'Your registration is awaiting Transport Office verification.',
    });
  }
  if (row.verification_status === 'REJECTED') {
    return res.status(403).json({
      success: false,
      code: 'ACCOUNT_REJECTED',
      error: 'Your registration was rejected. Contact the Transport Office.',
    });
  }

  loginLimiter.reset(loginKey(req));
  extras.touchLastActive(roll);
  appendSheetRow('Boarding_Attendance', {
    Timestamp: now(), 'Roll Number': roll, 'Student Name': row.name, 'Route ID': row.route_id, 'Stop Name': row.pickup_stop,
    'Event Type': 'STUDENT_PORTAL_LOGIN', 'Check-In Method': 'PASSWORD', Notes: 'Authenticated student session',
  });
  const token = signToken({
    sub: roll,
    name: row.name,
    role: 'STUDENT',
    routeId: row.route_id,
    mustChangePassword: Boolean(row.must_change_password),
    sessionVersion: extras.getSessionVersion(row.roll_number),
  });
  const studentData = rowToStudent(row);
  studentData.mustChangePassword = Boolean(row.must_change_password);
  res.json({ success: true, student: studentData, token });
});

app.get('/api/students/me', requireRole('STUDENT', 'PARENT'), (req, res) => {
  const roll = resolveStudentRoll(req.user);
  const row = extras.getStudentRow(roll);
  if (!row) return res.status(404).json({ error: 'Student not found' });
  const studentData = rowToStudent(row);
  studentData.mustChangePassword = Boolean(row.must_change_password);
  res.json({ success: true, student: studentData });
});

function getConfiguredEnvAdmins() {
  const admins = [];
  if (process.env.ADMIN_ID && process.env.ADMIN_PASSWORD_HASH) {
    admins.push({
      id: String(process.env.ADMIN_ID).trim(),
      name: process.env.ADMIN_NAME || 'Transport Incharge',
      passwordHash: process.env.ADMIN_PASSWORD_HASH,
      source: 'ENV',
    });
  }
  if (process.env.ADMIN_ACCOUNTS) {
    try {
      const parsed = JSON.parse(process.env.ADMIN_ACCOUNTS);
      if (Array.isArray(parsed)) {
        for (const entry of parsed) {
          const eid = typeof entry?.id === 'string' ? entry.id.trim() : '';
          const ehash = typeof entry?.passwordHash === 'string' ? entry.passwordHash.trim() : '';
          if (eid && ehash && !admins.some((a) => a.id.toUpperCase() === eid.toUpperCase())) {
            admins.push({
              id: eid,
              name: typeof entry?.name === 'string' && entry.name.trim() ? entry.name.trim() : eid,
              passwordHash: ehash,
              source: 'ENV',
            });
          }
        }
      }
    } catch {
      console.warn('[admin] Ignoring malformed ADMIN_ACCOUNTS JSON');
    }
  }
  return admins;
}

app.post('/api/admin/login', ipLoginLimiter, loginLimiter, async (req, res) => {
  const envAdmins = getConfiguredEnvAdmins();
  if (envAdmins.length === 0 && !extras.hasAnyActiveAdmin()) {
    return res.status(503).json({ error: 'Admin login is not configured on this server' });
  }
  const id = str(req.body?.adminId, 80, 'adminId');
  const password = typeof req.body?.password === 'string' ? req.body.password : '';
  const idUpperBuf = Buffer.from(id.toUpperCase());

  let candidate = null;
  for (const envAdmin of envAdmins) {
    const targetBuf = Buffer.from(envAdmin.id.toUpperCase());
    if (idUpperBuf.length === targetBuf.length && crypto.timingSafeEqual(idUpperBuf, targetBuf)) {
      candidate = envAdmin;
      break;
    }
  }

  if (!candidate) {
    const dbAdmin = extras.getAdminUser(id);
    if (dbAdmin && dbAdmin.active === 1) {
      candidate = {
        id: dbAdmin.admin_id,
        name: dbAdmin.name,
        passwordHash: dbAdmin.password_hash,
        source: 'DATABASE',
        sessionVersion: dbAdmin.session_version || 0,
      };
    }
  }

  // Always verify against a real or dummy scrypt hash so timing doesn't leak whether ID matched
  const pwOk = candidate ? await verifyPassword(password, candidate.passwordHash) : await verifyDummy(password);
  if (!candidate || !pwOk) return res.status(401).json({ success: false, error: 'Invalid credentials' });

  loginLimiter.reset(loginKey(req));
  const admin = { id: candidate.id, name: candidate.name, role: 'ADMIN' };
  appendSheetRow('Alerts_Notifications', {
    Timestamp: now(),
    'Alert ID': `ADM-${Date.now()}`,
    'Recipient Name': admin.name,
    Category: 'SECURITY',
    Title: 'Admin login',
    Message: `Admin login (${admin.id}) from ${req.ip}`,
    'Delivery Status': 'AUDIT',
  });
  const token = signToken(
    {
      sub: admin.id,
      name: admin.name,
      role: 'ADMIN',
      ...(candidate.source === 'DATABASE'
        ? { adminSource: 'DATABASE', sessionVersion: candidate.sessionVersion || 0 }
        : {}),
    },
    { ttlSec: 2 * 3600 }
  );
  res.json({ success: true, admin, token });
});

// DRIVER_PIN_HASHES='{"route-51":"scrypt$...","route-14":"scrypt$...","route-15":"scrypt$..."}'  (one hash per bus; generate with scripts/generate-env.js; use 6+ digits)
const getDriverHashes = () => {
  try { return JSON.parse(process.env.DRIVER_PIN_HASHES || '{}'); } catch { return {}; }
};
app.post('/api/driver/login', ipLoginLimiter, loginLimiter, async (req, res) => {
  const route = normalizeRoute(str(req.body?.routeId, 40, 'routeId'));
  const pin = typeof req.body?.pin === 'string' ? req.body.pin : '';
  const stored = getDriverHashes()[route];
  let ok = false;
  if (stored) {
    ok = await verifyPassword(pin, stored);
  } else if (process.env.NODE_ENV !== 'production') {
    if ((route === 'route-51' && pin === (process.env.DRIVER_PIN_51 || '515151')) ||
        (route === 'route-14' && pin === (process.env.DRIVER_PIN_14 || '141414')) ||
        (route === 'route-15' && pin === (process.env.DRIVER_PIN_15 || '151515'))) {
      ok = true;
    } else {
      await verifyDummy(pin);
    }
  } else {
    await verifyDummy(pin);
  }
  if (!ok) return res.status(401).json({ success: false, error: 'Invalid route or PIN' });
  loginLimiter.reset(loginKey(req));
  const driver = { id: `driver-${route}`, role: 'DRIVER', routeId: route, name: `Driver (${route})` };
  appendSheetRow('Driver_Trip_Logs', { Timestamp: now(), 'Route ID': route, 'Driver Name': driver.name, Direction: 'SESSION_START' });
  res.json({ success: true, driver, token: signToken({ sub: driver.id, name: driver.name, role: 'DRIVER', routeId: route }, { ttlSec: 12 * 3600 }) });
});

// Parent portal: the student generates a 30-day code in their app and shares it. The token is scoped to that one ward.
app.post('/api/students/me/parent-access-code', requireRole('STUDENT'), alertLimiter, (req, res) =>
  res.json({ code: extras.createParentCode(req.user.sub), expiresInDays: 30 }));
app.post('/api/parents/login', ipLoginLimiter, loginLimiter, (req, res) => {
  const code = str(req.body?.code, 20, 'code').trim();
  const roll = extras.redeemParentCode(code);
  if (!roll) return res.status(401).json({ success: false, error: 'Invalid or expired parent access code. Please ask your ward to generate a code in their Student Portal.' });
  const ward = extras.getStudentRow(roll);
  if (!ward) return res.status(401).json({ success: false, error: 'Student record not found for this access code' });
  loginLimiter.reset(loginKey(req));
  const parent = { 
    id: `parent-${roll}`, 
    role: 'PARENT', 
    wardRoll: roll, 
    wardName: ward.name, 
    wardRouteId: ward.route_id,
    wardPickupStop: ward.pickup_stop,
    name: `${ward.name}'s Parent` 
  };
  res.json({ success: true, parent, token: signToken({ sub: parent.id, name: parent.name, role: 'PARENT', wardRoll: roll, routeId: ward.route_id }, { ttlSec: 7 * 24 * 3600 }) });
});

app.post('/api/students/me/password', requireRole('STUDENT'), loginLimiter, async (req, res) => {
  const { current, next } = req.body ?? {};
  if (typeof next !== 'string' || next.length < 10 || next.length > 128) throw new HttpError(400, 'New password must be 10-128 characters');
  const row = extras.getStudentRow(req.user.sub);
  if (!row?.password_hash || !(await verifyPassword(String(current ?? ''), row.password_hash))) throw new HttpError(401, 'Current password is incorrect');
  extras.setPasswordHash(req.user.sub, await hashPassword(next));
  extras.clearMustChangePassword(req.user.sub);
  const refreshedToken = signToken({
    sub: req.user.sub,
    name: row.name,
    role: 'STUDENT',
    routeId: row.route_id,
    mustChangePassword: false,
    sessionVersion: extras.getSessionVersion(row.roll_number),
  });
  res.json({ success: true, token: refreshedToken });
});

/* ---------------- ₹0 Self-Service Forgot Password Flow ---------------- */
app.post('/api/auth/forgot-password', authLimiter, async (req, res) => {
  const rollNumber = str(req.body?.rollNumber, 32, 'rollNumber').toUpperCase();
  const contact = str(req.body?.contact, 120, 'contact');
  const safeResponse = {
    success: true,
    message: 'If your Roll/Employee ID and mobile/email match our records, a 6-digit reset code has been issued. Check Telegram (if linked) or ask the Transport Office desk.',
  };

  const row = extras.getStudentRow(rollNumber);
  if (row && String(row.verification_status || 'VERIFIED').toUpperCase() !== 'REJECTED') {
    const contactDigits = contact.replace(/\D/g, '').slice(-10);
    const studentDigits = String(row.student_phone || '').replace(/\D/g, '').slice(-10);
    const parentDigits = String(row.parent_phone || '').replace(/\D/g, '').slice(-10);
    const contactEmail = contact.trim().toLowerCase();
    const rowEmail = String(row.email || '').trim().toLowerCase();

    const matchesPhone =
      contactDigits.length === 10 &&
      ((studentDigits.length === 10 && contactDigits === studentDigits) ||
        (parentDigits.length === 10 && contactDigits === parentDigits));
    const matchesEmail = Boolean(rowEmail && contactEmail.includes('@') && contactEmail === rowEmail);

    if (matchesPhone || matchesEmail) {
      const code = String(crypto.randomInt(100000, 1_000_000));
      const storedContact = matchesPhone ? contactDigits : contactEmail;
      extras.savePasswordResetCode(rollNumber, storedContact, code, 15 * 60 * 1000);

      if (row.telegram_chat_id) {
        const tgHtml = `🔐 <b>Sreenidhi Express Password Reset</b>\n\nAccount: <b>${escapeHtml(row.name)}</b> (${escapeHtml(rollNumber)})\nReset Code: <code>${code}</code>\n\nValid for 15 minutes.`;
        await sendTelegramAlert(row.telegram_chat_id, tgHtml).catch(() => {});
      }

      try {
        appendSheetRow('Alerts_Notifications', {
          Timestamp: now(),
          'Alert ID': `PWR-${Date.now()}`,
          'Recipient Name': row.name || rollNumber,
          Category: 'SECURITY',
          Title: 'PASSWORD_RESET_REQUESTED',
          Message: `Self-service 6-digit reset code issued for ${rollNumber} (valid 15m).`,
          'Delivery Status': row.telegram_chat_id ? 'TELEGRAM_AND_DESK' : 'TRANSPORT_DESK',
        });
      } catch {}

      try {
        extras.logNotification({
          recipient_type: 'STUDENT',
          roll_number: rollNumber,
          phone_number: studentDigits || parentDigits || storedContact,
          category: 'SECURITY',
          title: 'PASSWORD_RESET_REQUESTED',
          message: `A 6-digit password reset code was requested for ${rollNumber}. Contact the Transport Office desk or check Telegram.`,
          channel: 'IN_APP_SMS',
          status: 'DELIVERED',
        });
      } catch {}
    }
  }

  res.json(safeResponse);
});

app.post('/api/auth/reset-password', authLimiter, async (req, res) => {
  const rollNumber = str(req.body?.rollNumber, 32, 'rollNumber').toUpperCase();
  const code = String(req.body?.code || '').trim();
  const newPassword = typeof req.body?.newPassword === 'string' ? req.body.newPassword : '';

  if (!/^\d{6}$/.test(code)) {
    throw new HttpError(400, 'Enter the valid 6-digit reset code');
  }
  if (newPassword.length < 8 || newPassword.length > 128) {
    throw new HttpError(400, 'New password must be 8-128 characters');
  }

  const check = extras.verifyPasswordResetCode(rollNumber, code);
  if (!check.ok) {
    const msg =
      check.reason === 'EXPIRED'
        ? 'Reset code has expired. Please request a new 6-digit code.'
        : check.reason === 'MAX_ATTEMPTS'
          ? 'Too many invalid reset attempts. Request a new 6-digit code.'
          : 'Invalid reset code. Check your 6-digit code and try again.';
    throw new HttpError(400, msg);
  }

  const row = extras.getStudentRow(rollNumber);
  if (!row) throw new HttpError(404, 'Student or faculty account not found');

  const hashed = await hashPassword(newPassword);
  extras.setPasswordHash(rollNumber, hashed);
  extras.clearMustChangePassword(rollNumber);
  extras.revokeStudentSessions(rollNumber);

  try {
    appendSheetRow('Alerts_Notifications', {
      Timestamp: now(),
      'Alert ID': `PWC-${Date.now()}`,
      'Recipient Name': row.name || rollNumber,
      Category: 'SECURITY',
      Title: 'PASSWORD_RESET_COMPLETED',
      Message: `${rollNumber} completed self-service password reset.`,
      'Delivery Status': 'AUDIT',
    });
  } catch {}

  res.json({
    success: true,
    message: 'Password updated. You can now sign in with your new password.',
  });
});

app.get('/api/admin/password-reset-requests', requireRole('ADMIN'), apiLimiter, (_req, res) => {
  const requests = extras.listActivePasswordResetRequests();
  res.json({ success: true, requests });
});

/* ---------------- admin: provisioning (replaces the public /register that overwrote records) ---------------- */
app.post('/api/admin/students', requireRole('ADMIN'), async (req, res) => {
  const b = req.body ?? {};
  const roll = str(b.rollNumber, 20, 'rollNumber').toUpperCase();
  if (!/^[0-9A-Z]{6,20}$/.test(roll)) throw new HttpError(400, 'rollNumber format invalid');
  const phone = str(b.parentPhone, 20, 'parentPhone');
  if (!/^\+?[\d\s-]{10,16}$/.test(phone)) throw new HttpError(400, 'parentPhone format invalid');
  const temp = crypto.randomBytes(9).toString('base64url');
  const created = extras.createStudent({
    roll, name: str(b.name, 80, 'name'), program: str(b.program, 80, 'program'), routeId: str(b.routeId, 60, 'routeId'),
    pickupStop: str(b.pickupStopId, 80, 'pickupStopId'), parentName: str(b.parentName, 80, 'parentName'), parentPhone: phone,
  }, await hashPassword(temp));
  if (!created) throw new HttpError(409, 'A student with this roll number already exists');
  extras.setMustChangePassword(roll, 1);
  res.status(201).json({ success: true, rollNumber: roll, temporaryPassword: temp, mustChangePassword: true }); // shown once; student must change it
});

app.post('/api/admin/students/:roll/password', requireRole('ADMIN'), async (req, res) => {
  const roll = req.params.roll.toUpperCase();
  const temp = crypto.randomBytes(9).toString('base64url');
  if (!extras.setPasswordHash(roll, await hashPassword(temp))) throw new HttpError(404, 'Student not found');
  extras.setMustChangePassword(roll, 1);
  extras.revokeStudentSessions(roll);
  appendSheetRow('Alerts_Notifications', { Timestamp: now(), 'Alert ID': `PWD-${Date.now()}`, Category: 'SECURITY', Title: 'Password reset', Message: `${req.user.sub} reset password for ${roll}`, 'Delivery Status': 'AUDIT' });
  res.json({ success: true, temporaryPassword: temp, mustChangePassword: true });
});

/* ---------------- students (scoped by role; no more "every student's data for any login") ---------------- */
app.get('/api/students', requireAuth, apiLimiter, (req, res) => {
  const { role, sub, routeId } = req.user;
  if (role === 'ADMIN') { const s = getAllStudents(false); return res.json({ success: true, count: s.length, students: s, piiMasked: false }); }
  if (role === 'STUDENT' || role === 'PARENT') { const r = extras.getStudentRow(role === 'PARENT' ? req.user.wardRoll : sub); return res.json({ success: true, count: 1, students: r ? [rowToStudent(r)] : [], piiMasked: true }); }
  const mine = getAllStudents(true).filter((s) => normalizeRoute(s['Assigned Route']) === normalizeRoute(routeId));
  res.json({ success: true, count: mine.length, students: mine, piiMasked: true });
});

/* ---------------- events (idempotent, validated, identity forced from the token) ---------------- */
function processEvent(user, item) {
  const { eventId, sheetName, data, clientTime } = item ?? {};
  if (eventId !== undefined && !/^[\w-]{8,64}$/.test(eventId)) throw new HttpError(400, 'eventId format invalid');
  const row = validateEvent(user, sheetName, data);
  row.Timestamp = utcStamp(clientTime ?? data?.Timestamp);
  return extras.tx(() => {
    if (eventId && !extras.claimEvent(`${user.sub}:${eventId}`)) return { duplicate: true };
    appendSheetRow(sheetName, row);
    return { duplicate: false };
  });
}
app.post('/api/events/record', requireAuth, apiLimiter, (req, res) => res.json({ success: true, ...processEvent(req.user, req.body) }));
app.post('/api/events/batch', requireAuth, apiLimiter, (req, res) => {
  const items = req.body?.events;
  if (!Array.isArray(items) || items.length === 0 || items.length > 50) throw new HttpError(400, 'events must be an array of 1-50 items');
  // Per-item results so one bad row never blocks the rest of an offline backlog.
  const results = items.map((it) => {
    try { return { eventId: it?.eventId, ok: true, ...processEvent(req.user, it) }; }
    catch (e) { return { eventId: it?.eventId, ok: false, status: e.status ?? 500, error: e instanceof HttpError ? e.message : 'failed' }; }
  });
  res.json({ success: true, results });
});

/* ---------------- boarding: server-verified (fee gate + rotating gate token) ---------------- */
app.get('/api/driver/gate-token', requireRole('DRIVER'), (req, res) => {
  const t = gateToken(req.user.routeId);
  res.json({ token: t, qrPayload: `SUH-GATE:${normalizeRoute(req.user.routeId)}:${t}`, refreshInSeconds: GATE_STEP_SECONDS });
});

app.post('/api/boarding/check-in', requireRole('STUDENT'), apiLimiter, (req, res) => {
  const { routeId, method, token, rssi, eventId, clientTime } = req.body ?? {};
  if (method !== 'QR' && method !== 'BLE') throw new HttpError(400, 'method must be QR or BLE');
  const route = normalizeRoute(str(routeId, 40, 'routeId'));
  const s = extras.getStudentRow(req.user.sub);
  if (!s) throw new HttpError(401, 'Unknown student');
  if (!extras.canStudentTravel(s.roll_number)) {
    return res.status(403).json({ success: false, code: 'PASS_INACTIVE', error: 'Bus pass is locked due to pending transport fee clearance. Clear dues or request an Emergency Grace Pass.' });
  }
  if (normalizeRoute(s.route_id) !== route) throw new HttpError(403, 'You are not assigned to this bus'); // relax here if alternate-route boarding is allowed
  if (!verifyGateToken(route, token)) throw new HttpError(401, 'Gate code invalid or expired');
  if (extras.isBoardedToday(s.roll_number, s.route_id)) return res.json({ success: true, duplicate: true });
  const result = extras.tx(() => {
    if (eventId && !extras.claimEvent(`${s.roll_number}:${eventId}`)) return { duplicate: true };
    if (extras.isBoardedToday(s.roll_number, s.route_id)) return { duplicate: true };
    appendSheetRow('Boarding_Attendance', {
      Timestamp: utcStamp(clientTime), 'Roll Number': s.roll_number, 'Student Name': s.name, 'Route ID': s.route_id, 'Stop Name': s.pickup_stop,
      'Event Type': method === 'QR' ? 'BOARDED_QR' : 'BOARDED_BLE',
      'Check-In Method': method === 'QR' ? 'QR_ROTATING' : `BLE_ROTATING${typeof rssi === 'number' ? ` (${Math.round(rssi)} dBm)` : ''}`,
      Notes: 'Server-verified gate token',
    });
    const trip = extras.getTripState(route);
    const nextHeadcount = Math.min(60, (trip.headcount || 0) + 1);
    extras.setTripState(route, trip.running, trip.delayMinutes, nextHeadcount);
    return { duplicate: false, headcount: nextHeadcount };
  });
  if (!result.duplicate) {
    broadcast('STUDENT_BOARDED', {
      rollNumber: s.roll_number,
      studentName: s.name,
      routeId: s.route_id,
      stopName: s.pickup_stop,
      method: method === 'QR' ? 'QR_ROTATING' : 'BLE_ROTATING',
      headcount: result.headcount,
      timestamp: Date.now()
    }, route);
    broadcast('STOP_BOARDED', { routeId: route, stopName: s.pickup_stop, count: 1, headcount: result.headcount }, route);
    if (extras.clearStopTimerIfNoPending(route, s.pickup_stop)) {
      broadcast('STOP_TIMER_CLEARED', { routeId: route, stopName: s.pickup_stop }, route);
    }
    void sendWebPush({
      roll: s.roll_number,
      title: 'Boarding Verified',
      body: `You have successfully boarded Route ${route}. Safe travels!`,
      url: '/'
    });
    void sendWebPush({
      roll: s.roll_number,
      userType: 'PARENT',
      title: 'Ward Boarded Bus',
      body: `Your ward ${s.name} (${s.roll_number}) has safely boarded bus ${route}.`,
      url: '/'
    });
  }
  res.json({ success: true, ...result });
});

app.post('/api/boarding/self-checkin', requireRole('STUDENT'), apiLimiter, (req, res) => {
  const s = extras.getStudentRow(req.user.sub);
  if (!s) throw new HttpError(401, 'Unknown student');
  if (!extras.canStudentTravel(s.roll_number)) {
    return res.status(403).json({
      success: false,
      code: 'PASS_INACTIVE',
      error: 'Bus pass is locked due to pending transport fee clearance. Clear dues or request an Emergency Grace Pass.',
    });
  }
  const route = normalizeRoute(s.route_id);
  const trip = extras.getTripState(route);
  if (!trip || !trip.running) {
    return res.status(409).json({
      success: false,
      error: 'Bus trip is not currently active.',
    });
  }
  const rawMethod = String(req.body?.method || 'STUDENT_SELF_TAP').trim().toUpperCase();
  const checkInMethod = rawMethod === 'BLE_PROXIMITY' ? 'BLE_PROXIMITY' : 'STUDENT_SELF_TAP';

  if (extras.isBoardedToday(s.roll_number, s.route_id)) {
    return res.json({
      success: true,
      duplicate: true,
      alreadyBoarded: true,
      boardingStatus: 'ON_BOARD',
      method: checkInMethod,
      headcount: trip.headcount,
      boardedCount: trip.headcount,
    });
  }

  const result = extras.tx(() => {
    if (extras.isBoardedToday(s.roll_number, s.route_id)) {
      const latest = extras.getTripState(route);
      return { duplicate: true, headcount: latest.headcount };
    }
    appendSheetRow('Boarding_Attendance', {
      Timestamp: now(),
      'Roll Number': s.roll_number,
      'Student Name': s.name,
      'Route ID': route,
      'Stop Name': s.pickup_stop || 'Stop',
      'Event Type': 'BOARDED_CONFIRMED',
      'Check-In Method': checkInMethod,
      Notes: 'Student self check-in',
    });
    const currentTrip = extras.getTripState(route);
    const newHeadcount = Math.min(60, (currentTrip.headcount || 0) + 1);
    extras.setTripState(route, true, currentTrip.delayMinutes, newHeadcount);
    return { duplicate: false, headcount: newHeadcount };
  });

  if (!result.duplicate) {
    broadcast('STUDENT_BOARDED', {
      rollNumber: s.roll_number,
      studentName: s.name,
      routeId: route,
      stopName: s.pickup_stop || 'Stop',
      method: checkInMethod,
      headcount: result.headcount,
      timestamp: Date.now(),
    }, route);
    broadcast('STOP_BOARDED', {
      routeId: route,
      stopName: s.pickup_stop || 'Stop',
      count: 1,
      headcount: result.headcount,
    }, route);
    if (extras.clearStopTimerIfNoPending(route, s.pickup_stop)) {
      broadcast('STOP_TIMER_CLEARED', { routeId: route, stopName: s.pickup_stop }, route);
    }
    void sendWebPush({
      roll: s.roll_number,
      title: 'Boarding Confirmed',
      body: `You confirmed boarding on ${route.replace('route-', 'Route ')}. Safe travels!`,
      url: '/',
    });
    void sendWebPush({
      roll: s.roll_number,
      userType: 'PARENT',
      title: 'Ward Boarded Bus',
      body: `Your ward ${s.name} (${s.roll_number}) confirmed boarding on ${route.replace('route-', 'Route ')}.`,
      url: '/',
    });
  }

  res.json({
    success: true,
    duplicate: result.duplicate,
    alreadyBoarded: result.duplicate,
    boardingStatus: 'ON_BOARD',
    method: checkInMethod,
    headcount: result.headcount,
    boardedCount: result.headcount,
  });
});

/* ---------------- live telemetry (DRIVER only, own route only, sanity-checked) ---------------- */
const liveBus = new Map();        // routeKey -> telemetry
const staleFlag = new Set();      // routeKeys currently flagged stale
const sseClients = new Set();     // { res, routeKey|null, sub }
const STALE_AFTER_MS = 90_000;
const usedStreamTickets = new Map(); // jti -> expiresAtMs

// Prune expired stream tickets every 60s
setInterval(() => {
  const now = Date.now();
  for (const [jti, exp] of usedStreamTickets) {
    if (now > exp) usedStreamTickets.delete(jti);
  }
}, 60_000).unref();

function broadcast(type, data, routeKey) {
  const msg = `data: ${JSON.stringify({ type, data })}\n\n`;
  for (const c of sseClients) {
    if (!c.routeKey || c.routeKey === routeKey) {
      if (c.res.writableEnded || c.res.destroyed || (c.res.writableLength ?? 0) > 65536) {
        try { c.res.end(); } catch {}
        sseClients.delete(c);
        continue;
      }
      try {
        c.res.write(msg);
      } catch {
        sseClients.delete(c);
      }
    }
  }
}

app.post('/api/bus/telemetry', requireRole('DRIVER'), telemetryLimiter, (req, res) => {
  const b = req.body ?? {};
  const routeKey = normalizeRoute(req.user.routeId);
  if (b.routeId && normalizeRoute(b.routeId) !== routeKey) throw new HttpError(403, 'You can only report for your own route');
  const num = (v, lo, hi, d) => (typeof v === 'number' && Number.isFinite(v) && v >= lo && v <= hi ? v : d);
  const lat = num(b.lat, -90, 90, null), lng = num(b.lng, -180, 180, null);
  if (lat === null || lng === null) throw new HttpError(400, 'lat/lng out of range');
  const prev = liveBus.get(routeKey);
  if (prev) {
    const km = haversineKm(prev, { lat, lng }), hrs = (Date.now() - prev.updatedAt) / 3.6e6;
    if (km > 0.3 && hrs > 0 && km / hrs > 200) throw new HttpError(422, 'Position jump rejected');
  }
  const t = {
    routeId: routeKey, lat, lng, speedKmh: num(b.speedKmh, 0, 140, 0), heading: num(b.heading, 0, 360, 0),
    currentStopIndex: num(b.currentStopIndex, 0, 200, 0), delayMinutes: num(b.delayMinutes, -60, 600, 0),
    flyoverBypassActive: b.flyoverBypassActive === true, batteryPct: num(b.batteryPct, 0, 100, null),
    accuracyM: num(b.accuracyM, 0, 10_000, null), updatedAt: Date.now(), reportedBy: req.user.sub,
  };
  liveBus.set(routeKey, t);
  if (staleFlag.delete(routeKey)) broadcast('BUS_RECOVERED', { routeId: routeKey }, routeKey);
  broadcast('BUS_TELEMETRY', t, routeKey);
  res.json({ success: true });
});

app.get('/api/bus/telemetry/:routeId', requireAuth, apiLimiter, (req, res) => {
  const key = normalizeRoute(req.params.routeId);
  if (req.user.role !== 'ADMIN' && normalizeRoute(req.user.routeId) !== key) throw new HttpError(403, 'Not your route');
  const t = liveBus.get(key);
  if (!t) throw new HttpError(404, 'No live telemetry yet');
  res.json({ success: true, telemetry: t, stale: Date.now() - t.updatedAt > STALE_AFTER_MS });
});

// EventSource cannot send headers, so exchange the bearer token for a 2-minute, stream-scoped ticket.
app.post('/api/bus/stream-ticket', requireAuth, apiLimiter, (req, res) => {
  const ticket = signToken(
    { sub: req.user.sub, role: req.user.role, routeId: req.user.routeId, jti: crypto.randomUUID() },
    { ttlSec: 120, scope: 'stream' }
  );
  res.json({ ticket });
});
app.get('/api/bus/live-stream', (req, res) => {
  const u = verifyToken(String(req.query.ticket ?? ''), { scope: 'stream' });
  if (!u) return res.status(401).end();
  if (!u.jti || usedStreamTickets.has(u.jti)) return res.status(401).end();
  usedStreamTickets.set(u.jti, Date.now() + 125_000);

  if (sseClients.size >= 1000 || [...sseClients].filter((c) => c.sub === u.sub).length >= 3) return res.status(429).end();
  res.set({
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache, no-transform',
    Connection: 'keep-alive',
    'X-Accel-Buffering': 'no',
  });
  res.flushHeaders?.();
  const client = { res, sub: u.sub, routeKey: u.role === 'ADMIN' ? null : normalizeRoute(u.routeId) };
  sseClients.add(client);
  for (const [k, t] of liveBus) if (!client.routeKey || client.routeKey === k) res.write(`data: ${JSON.stringify({ type: 'BUS_TELEMETRY', data: t })}\n\n`);
  const hb = setInterval(() => { try { res.write(': hb\n\n'); } catch { clearInterval(hb); sseClients.delete(client); } }, 15_000);
  req.on('close', () => { clearInterval(hb); sseClients.delete(client); });
});

// Dead-battery / dead-zone watchdog: no heartbeat for 90 s => tell clients and log it for the admin.
setInterval(() => {
  for (const [k, t] of liveBus) {
    if (Date.now() - t.updatedAt > STALE_AFTER_MS && !staleFlag.has(k)) {
      staleFlag.add(k);
      broadcast('BUS_STALE', { routeId: k, lastSeen: t.updatedAt, lastBatteryPct: t.batteryPct, lat: t.lat, lng: t.lng }, k);
      appendSheetRow('Alerts_Notifications', { Timestamp: now(), 'Alert ID': `STALE-${k}-${Date.now()}`, Category: 'TELEMETRY', Title: 'Bus went silent', Message: `${k} last seen ${Math.round((Date.now() - t.updatedAt) / 1000)}s ago, battery ${t.batteryPct ?? '?'}%`, 'Delivery Status': 'AUDIT' });
    }
  }
}, 30_000).unref();
setInterval(() => extras.pruneEvents(), 6 * 3600e3).unref();

/* ---------------- applications (persisted; students see only their own) ---------------- */
const APP_TYPES = new Set(['BUS_PASS_RENEWAL', 'ROUTE_CHANGE', 'FEE_GRACE_PERIOD', 'EXAM_SHUTTLE', 'FEE_CONCESSION']);
app.post('/api/applications', requireRole('STUDENT'), apiLimiter, (req, res) => {
  const b = req.body ?? {};
  const requestType = APP_TYPES.has(b.requestType) ? b.requestType : 'BUS_PASS_RENEWAL';
  const proofUrl = typeof b.proofUrl === 'string' && /^https:\/\//.test(b.proofUrl) ? b.proofUrl.slice(0, 500) : '';
  const id = `APP-${crypto.randomBytes(4).toString('hex').toUpperCase()}`;
  extras.saveApplication({ id, roll: req.user.sub, name: req.user.name, requestType, title: str(b.title ?? 'Transit Service Request', 120, 'title'),
    description: String(b.description ?? '').slice(0, 1000), proofUrl, requestedValue: String(b.requestedValue ?? '').slice(0, 200) });
  res.status(201).json({ success: true, application: extras.getApplication(id) });
});
app.get('/api/applications', requireRole('STUDENT', 'ADMIN'), apiLimiter, (req, res) =>
  res.json({ success: true, applications: extras.listApplications(req.user.role === 'ADMIN' ? null : req.user.sub) }));
app.post('/api/applications/:id/scrutiny', requireRole('ADMIN'), (req, res) => {
  if (!extras.getApplication(req.params.id)) throw new HttpError(404, 'Application not found');
  extras.reviewApplication(req.params.id, req.body?.status === 'APPROVED' ? 'APPROVED' : 'REJECTED', String(req.body?.adminNote ?? '').slice(0, 500), req.user.name);
  res.json({ success: true, application: extras.getApplication(req.params.id) });
});

/* ---------------- parent alerts via Telegram (templated server-side, chat id from DB) ---------------- */
const ALERTS = {
  PRE_ARRIVAL_10M: 'The bus is about 10 minutes from the pickup stop.',
  BOARDED: 'Has boarded the bus.',
  BOARDED_CONFIRMED: 'Has boarded the bus.',
  ARRIVED_CAMPUS: 'Has arrived at campus.',
  DELAY: 'The bus is running late.',
  BREAKDOWN: 'The bus has broken down; a replacement is being arranged.',
  OVERSLEEP_MISSED_STOP: 'May have missed their stop; the driver has been notified.',
  EARLY_EXIT: 'Has deboarded early at an unscheduled transit stop.',
  EMERGENCY: 'An emergency was reported on the bus. The transport office is responding.',
};
const STUDENT_ALERTS = new Set(['OVERSLEEP_MISSED_STOP', 'EARLY_EXIT']);

app.post('/api/alerts/notify-parent', requireRole('STUDENT', 'DRIVER', 'ADMIN'), alertLimiter, async (req, res) => {
  const category = String(req.body?.category ?? '');
  if (!ALERTS[category]) throw new HttpError(400, 'Unknown alert category');
  const roll = req.user.role === 'STUDENT' ? req.user.sub : str(req.body?.studentRoll, 20, 'studentRoll').toUpperCase();
  if (req.user.role === 'STUDENT' && !STUDENT_ALERTS.has(category)) throw new HttpError(403, 'Not allowed');
  const s = extras.getStudentRow(roll);
  if (!s) throw new HttpError(404, 'Student not found');
  if (req.user.role === 'DRIVER' && normalizeRoute(s.route_id) !== normalizeRoute(req.user.routeId)) throw new HttpError(403, 'Student is not on your bus');
  const note = req.user.role === 'STUDENT' ? '' : String(req.body?.note ?? '').slice(0, 200);
  const html = `<b>🚌 Sreenidhi Express · Safety Alert</b>\n\n<b>Student:</b> ${escapeHtml(s.name)} (${escapeHtml(s.roll_number)})\n${escapeHtml(ALERTS[category])}` + (note ? `\n\n<i>${escapeHtml(note)}</i>` : '');
  const tg = await sendTelegramAlert(s.telegram_chat_id, html);
  appendSheetRow('Parent_Alerts_Log', {
    Timestamp: now(), 'Alert ID': `ALERT-${Date.now()}`, 'Recipient Name': s.parent_name, 'Recipient Phone': s.parent_phone,
    Category: category, Title: category, Message: ALERTS[category], 'Delivery Status': tg.mode === 'LIVE_DELIVERED' ? 'DELIVERED_TELEGRAM' : tg.mode,
  });

  // Notify driver cabin immediately for critical anomalies (oversleep, early exit, emergency)
  if (['OVERSLEEP_MISSED_STOP', 'EARLY_EXIT', 'EMERGENCY'].includes(category)) {
    broadcast('STUDENT_SAFETY_ALERT', {
      routeId: s.route_id,
      rollNumber: s.roll_number,
      studentName: s.name,
      category,
      message: ALERTS[category],
      timestamp: Date.now(),
    }, s.route_id);
    extras.createIncident(
      'SAFETY_ANOMALY',
      s.name,
      s.route_id,
      `Safety Alert: ${category} for ${s.name} (${s.roll_number})`
    );
  }

  // Record in-app & WhatsApp mobile notification for parents
  const alertTitle = category.replace(/_/g, ' ');
  const alertMsg = ALERTS[category] + (note ? ` - ${note}` : '');
  try {
    extras.logNotification({
      ts: Date.now(),
      recipient_type: 'PARENT',
      roll_number: s.roll_number,
      phone_number: s.parent_phone,
      category,
      title: alertTitle,
      message: alertMsg,
      channel: 'APP_AND_WHATSAPP',
      status: 'DELIVERED',
    });
  } catch (err) {
    console.error('[notify-parent] Failed to record mobile notification:', err);
  }
  broadcast('PARENT_ALERT', { studentRoll: s.roll_number, category, title: alertTitle, message: alertMsg }, normalizeRoute(s.route_id));
  void sendWebPush({
    roll: s.roll_number,
    userType: 'PARENT',
    title: `Sreenidhi Express: ${alertTitle}`,
    body: alertMsg,
    url: '/'
  });

  res.status(tg.success ? 200 : 502).json({ success: tg.success, delivered: tg.mode === 'LIVE_DELIVERED', mode: tg.mode });
});

app.post('/api/notifications/parent-test', requireRole('PARENT', 'STUDENT', 'ADMIN'), alertLimiter, (req, res) => {
  let roll = '';
  if (req.user.role === 'ADMIN' && req.body?.rollNumber) {
    roll = str(req.body.rollNumber, 20, 'rollNumber').toUpperCase();
  } else {
    roll = resolveStudentRoll(req.user);
  }
  const s = extras.getStudentRow(roll);
  if (!s) throw new HttpError(404, 'Student not found');
  const cleanPhone = String(s.parent_phone || '').replace(/\D/g, '').slice(-10);
  const message = `Sreenidhi Express Transport Alert: Live bus tracking and arrival updates for student ${s.name} (${s.roll_number}) on ${s.route_id}. View status: ${process.env.APP_URL || 'http://localhost:3001'}`;
  const notifId = extras.logNotification({
    ts: Date.now(),
    recipient_type: 'PARENT',
    roll_number: s.roll_number,
    phone_number: s.parent_phone,
    category: 'PARENT_NOTIFICATION',
    title: 'Parent Transport Alert',
    message,
    status: 'DELIVERED',
    channel: 'APP_AND_WHATSAPP',
  });
  const whatsappUrl = cleanPhone ? `https://wa.me/91${cleanPhone}?text=${encodeURIComponent(message)}` : null;
  const notification = {
    id: notifId,
    ts: Date.now(),
    recipient_type: 'PARENT',
    roll_number: s.roll_number,
    phone_number: s.parent_phone,
    category: 'PARENT_NOTIFICATION',
    title: 'Parent Transport Alert',
    message,
    status: 'DELIVERED',
    channel: 'APP_AND_WHATSAPP',
  };
  res.json({ success: true, notification, whatsappUrl });
});

app.post('/api/students/me/parent-link-code', requireAuth, requireRole('STUDENT', 'PARENT'), alertLimiter, (req, res) => {
  const targetRoll = resolveStudentRoll(req.user);
  if (!targetRoll) throw new HttpError(400, 'Student roll required');
  const code = extras.createLinkCode(targetRoll);
  const bot = process.env.TELEGRAM_BOT_USERNAME || 'SreenidhiTransitBot';
  res.json({ code, expiresInHours: 24, deepLink: `https://t.me/${bot}?start=${code}` });
});
// Register once:  curl "https://api.telegram.org/bot$TOKEN/setWebhook" -d url=https://YOUR_HOST/api/telegram/webhook -d secret_token=$TELEGRAM_WEBHOOK_SECRET
app.post('/api/telegram/webhook', async (req, res) => {
  const secret = process.env.TELEGRAM_WEBHOOK_SECRET || '';
  const got = String(req.headers['x-telegram-bot-api-secret-token'] ?? '');
  if (!secret || got.length !== secret.length || !crypto.timingSafeEqual(Buffer.from(got), Buffer.from(secret))) return res.status(401).end();
  const msg = req.body?.message;
  const m = /^\/start\s+([A-Fa-f0-9]{10})$/.exec(msg?.text ?? '');
  if (m && msg.chat?.id) {
    const roll = extras.consumeLinkCode(m[1], msg.chat.id);
    await sendTelegramAlert(String(msg.chat.id), roll ? '✅ Linked. You will now receive safety alerts for your ward.' : '⚠️ That link code is invalid or expired. Ask your ward to generate a new one in the app.');
  }
  res.json({ ok: true });
});

function formatIstDateTime(isoOrMs) {
  if (isoOrMs === null || isoOrMs === undefined || isoOrMs === '') return '';
  const d = typeof isoOrMs === 'number' ? new Date(isoOrMs) : new Date(String(isoOrMs));
  if (Number.isNaN(d.getTime())) return '';
  return d
    .toLocaleString('en-IN', {
      timeZone: 'Asia/Kolkata',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    })
    .replace(/\b(am|pm)\b/i, (m) => m.toUpperCase());
}

function formatIstTimeOnly(isoOrMs) {
  if (isoOrMs === null || isoOrMs === undefined || isoOrMs === '') return '';
  const d = typeof isoOrMs === 'number' ? new Date(isoOrMs) : new Date(String(isoOrMs));
  if (Number.isNaN(d.getTime())) return '';
  return d
    .toLocaleTimeString('en-IN', {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    })
    .replace(/\b(am|pm)\b/i, (m) => m.toUpperCase());
}

function getIstDateKey(isoOrMs) {
  if (isoOrMs === null || isoOrMs === undefined || isoOrMs === '') return '';
  const d = typeof isoOrMs === 'number' ? new Date(isoOrMs) : new Date(String(isoOrMs));
  if (Number.isNaN(d.getTime())) return '';
  return new Date(d.getTime() + 5.5 * 3600 * 1000).toISOString().slice(0, 10);
}

function formatDwellDuration(sec) {
  const total = Math.max(0, Math.round(Number(sec) || 0));
  const mins = Math.floor(total / 60);
  const rem = total % 60;
  if (mins <= 0) return `${rem}s`;
  return `${mins}m ${rem}s`;
}

function resolveScheduledStopInfo(routeId, stopId, arrivedAtIso) {
  const normRoute = normalizeRoute(routeId);
  const stops = ROUTE_TOPOLOGY[normRoute]?.stops || [];
  const targetId = String(stopId || '').trim().toLowerCase();
  const stop = stops.find((s) => String(s.id || '').toLowerCase() === targetId);
  if (!stop) return { scheduledTime: null, delayMinutes: null };

  const arrivedDate = arrivedAtIso ? new Date(String(arrivedAtIso)) : null;
  if (!arrivedDate || Number.isNaN(arrivedDate.getTime())) {
    return { scheduledTime: null, delayMinutes: null };
  }

  const istDate = new Date(arrivedDate.getTime() + 5.5 * 3600 * 1000);
  const istHour = istDate.getUTCHours();
  const istMin = istDate.getUTCMinutes();
  const actualMinutesOfDay = istHour * 60 + istMin;

  const scheduledStr = istHour < 12 ? stop.scheduledMorningTime : stop.scheduledEveningTime;
  if (typeof scheduledStr !== 'string') {
    return { scheduledTime: null, delayMinutes: null };
  }
  const match = scheduledStr.trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)?$/i);
  if (!match) {
    return { scheduledTime: scheduledStr, delayMinutes: null };
  }
  let schedH = Number(match[1]);
  const schedM = Number(match[2]);
  const meridiem = (match[3] || '').toUpperCase();
  if (meridiem === 'PM' && schedH < 12) schedH += 12;
  if (meridiem === 'AM' && schedH === 12) schedH = 0;
  if (!Number.isFinite(schedH) || !Number.isFinite(schedM)) {
    return { scheduledTime: scheduledStr, delayMinutes: null };
  }
  const scheduledMinutesOfDay = schedH * 60 + schedM;
  return {
    scheduledTime: scheduledStr,
    delayMinutes: Math.round(actualMinutesOfDay - scheduledMinutesOfDay),
  };
}

function buildDriverUtilityReport(routeFilterRaw = null, dateFilterRaw = null, limitRaw = 200, maxCap = 500) {
  const routeId = routeFilterRaw ? normalizeRoute(String(routeFilterRaw)) : null;
  const dateFilter =
    typeof dateFilterRaw === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(dateFilterRaw.trim())
      ? dateFilterRaw.trim()
      : null;
  const limit = Math.max(1, Math.min(maxCap, Math.round(Number(limitRaw) || 200)));
  const fetchLimit = dateFilter ? Math.max(limit, maxCap) : limit;

  let rawLogs = extras.getDriverUtilityLogs(routeId, fetchLimit);
  if (dateFilter) {
    rawLogs = rawLogs.filter((r) => getIstDateKey(r.arrived_at || r.recorded_at) === dateFilter);
  }
  rawLogs = rawLogs.slice(0, limit);

  const logs = rawLogs.map((r) => {
    const { scheduledTime, delayMinutes } = resolveScheduledStopInfo(r.route_id, r.stop_id, r.arrived_at);
    return {
      ...r,
      arrived_at_ist: formatIstDateTime(r.arrived_at),
      arrived_time_ist: formatIstTimeOnly(r.arrived_at),
      departed_at_ist: formatIstDateTime(r.departed_at),
      departed_time_ist: formatIstTimeOnly(r.departed_at),
      date_ist: getIstDateKey(r.arrived_at || r.recorded_at),
      dwell_formatted: formatDwellDuration(r.dwell_sec),
      scheduled_time: scheduledTime,
      delay_minutes: delayMinutes,
    };
  });

  const rawTrips = routeId
    ? db.prepare('SELECT route_id, started_at, running, headcount FROM trip_states WHERE route_id = ? AND started_at IS NOT NULL').all(routeId)
    : db.prepare('SELECT route_id, started_at, running, headcount FROM trip_states WHERE started_at IS NOT NULL ORDER BY route_id ASC').all();
  const filteredTrips = dateFilter
    ? rawTrips.filter((t) => getIstDateKey(t.started_at) === dateFilter)
    : rawTrips;
  const tripStarts = filteredTrips.map((t) => ({
    ...t,
    started_at_ist: formatIstDateTime(t.started_at),
  }));

  const totalStopsLogged = logs.length;
  let totalDwellSec = 0;
  let maxDwellSec = 0;
  let longestStopName = null;
  let tooShortCount = 0;
  let tooLongCount = 0;

  for (const row of logs) {
    const sec = Number(row.dwell_sec) || 0;
    totalDwellSec += sec;
    if (sec >= maxDwellSec && totalStopsLogged > 0) {
      if (sec > maxDwellSec || longestStopName === null) {
        maxDwellSec = sec;
        longestStopName = row.stop_name || null;
      }
    }
    if (row.flag === 'TOO_SHORT') tooShortCount += 1;
    if (row.flag === 'TOO_LONG') tooLongCount += 1;
  }

  const avgDwellSec = totalStopsLogged > 0 ? Math.round(totalDwellSec / totalStopsLogged) : 0;
  const summary = {
    totalStopsLogged,
    avgDwellSec,
    avgDwellFormatted: formatDwellDuration(avgDwellSec),
    maxDwellSec,
    longestStopName,
    tooShortCount,
    tooLongCount,
  };

  return { logs, tripStarts, summary };
}

/* ---------------- Trip State Machine & Driver Quick Delay ---------------- */
function getTodayStr() {
  // Explicit Asia/Kolkata date policy (UTC + 5:30)
  const istNow = new Date(Date.now() + 5.5 * 3600 * 1000);
  return istNow.toISOString().slice(0, 10);
}

function getTomorrowStr() {
  // Explicit Asia/Kolkata date policy (UTC + 5:30)
  const istNow = new Date(Date.now() + 5.5 * 3600 * 1000);
  istNow.setUTCDate(istNow.getUTCDate() + 1);
  return istNow.toISOString().slice(0, 10);
}

function toCsvString(headers, rows) {
  const esc = (v) => {
    let s = String(v ?? '');
    // Neutralize spreadsheet formula injection characters (=, +, -, @, tabs)
    if (/^[=+\-@\t\r]/.test(s)) {
      s = "'" + s;
    }
    return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  return [headers.map(esc).join(','), ...rows.map((r) => r.map(esc).join(','))].join('\r\n') + '\r\n';
}

app.post('/api/bus/trip', requireRole('DRIVER', 'ADMIN'), (req, res) => {
  const rId = req.user.role === 'ADMIN' && req.body?.routeId 
    ? normalizeRoute(req.body.routeId) 
    : normalizeRoute(req.user.routeId || 'route-51');
  const running = Boolean(req.body?.running);
  const st = extras.getTripState(rId);
  const updatedDelay = running ? st.delayMinutes : 0;
  const startedAtIso = running && !st.running ? new Date().toISOString() : undefined;
  const updatedState = extras.setTripState(rId, running, updatedDelay, st.headcount, startedAtIso);
  if (running && !st.running) {
    const istStart = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', hour12: true });
    appendSheetRow('Driver_Trip_Logs', {
      Timestamp: now(),
      'Route ID': rId,
      'Driver Name': req.user.name || `Driver (${rId})`,
      Direction: 'TRIP_START',
      Notes: `Started at ${istStart} IST (${startedAtIso})`,
    });
  }
  const msg = running ? `Bus trip for ${rId} has started from departure terminal.` : `Bus trip for ${rId} completed/paused by driver.`;
  extras.createAnnouncement(rId, msg);
  // Log e-commerce style mobile push notification
  extras.logNotification({
    recipient_type: 'ALL',
    category: running ? 'TRIP_STARTED' : 'CAMPUS_ARRIVED',
    title: running ? `🚀 Trip Started: ${rId.replace('route-', 'Route ')} En Route` : `🏫 Trip Completed: Reached SNIST`,
    message: running 
      ? `${rId.replace('route-', 'Route ')} bus has departed Erragadda terminal. Live tracking is active. Estimated arrival at campus: 08:35 AM.` 
      : `${rId.replace('route-', 'Route ')} bus has safely completed its trip and arrived at Sreenidhi University Campus.`,
    channel: 'IN_APP_SMS',
    status: 'DELIVERED'
  });
  const pushTitle = running ? `🚀 Trip Started: ${rId.replace('route-', 'Route ')}` : `🏫 Trip Ended: ${rId.replace('route-', 'Route ')}`;
  const pushBody = running 
    ? `Bus on ${rId.replace('route-', 'Route ')} has departed. Live tracking is active.` 
    : `Bus on ${rId.replace('route-', 'Route ')} completed its trip.`;
  void sendWebPush({ routeId: rId, title: pushTitle, body: pushBody, url: '/' });
  broadcast('BUS_TRIP', { routeId: rId, running, delayMinutes: updatedDelay, startedAt: updatedState.startedAt }, rId);
  res.json({ success: true, running, routeId: rId, startedAt: updatedState.startedAt });
});

app.post('/api/bus/stop-dwell', requireRole('DRIVER'), telemetryLimiter, (req, res) => {
  const b = req.body ?? {};
  const stopId = str(b.stopId, 80, 'stopId');
  const stopName = str(b.stopName, 120, 'stopName');
  const arrivedAt = str(b.arrivedAt, 64, 'arrivedAt');
  const departedAt = str(b.departedAt, 64, 'departedAt');
  const dwellSec = Number(b.dwellSec);
  if (!Number.isFinite(dwellSec) || dwellSec < 0 || dwellSec > 3600) {
    throw new HttpError(400, 'dwellSec must be a finite number between 0 and 3600');
  }
  const routeKey = normalizeRoute(req.user.routeId || 'route-51');
  const saved = extras.recordStopDwell(routeKey, stopId, stopName, arrivedAt, departedAt, dwellSec);
  broadcast(
    'STOP_DWELL_RECORDED',
    {
      routeId: routeKey,
      stopId,
      stopName,
      arrivedAt,
      departedAt,
      dwellSec: saved.dwellSec,
      flag: saved.flag,
    },
    routeKey
  );
  res.json({ success: true, flag: saved.flag, dwellSec: saved.dwellSec });
});

app.post('/api/bus/delay', requireRole('DRIVER', 'ADMIN'), (req, res) => {
  const rId = req.user.role === 'ADMIN' && req.body?.routeId 
    ? normalizeRoute(req.body.routeId) 
    : normalizeRoute(req.user.routeId || 'route-51');
  const delayMinutes = Math.max(0, Math.min(120, Number(req.body?.delayMinutes) || 0));
  const st = extras.getTripState(rId);
  extras.setTripState(rId, st.running, delayMinutes, st.headcount);
  if (delayMinutes > 0) {
    const msg = `Traffic Delay Notice: ${rId.replace('route-', 'Route ')} is running +${delayMinutes} minutes behind schedule due to highway congestion.`;
    extras.createAnnouncement(rId, msg);
    extras.logNotification({
      recipient_type: 'ALL',
      category: 'DELAY',
      title: `⚠️ Highway Traffic Delay: +${delayMinutes}m`,
      message: `${rId.replace('route-', 'Route ')} is running +${delayMinutes} minutes behind schedule due to traffic congestion near Uppal Ring Road. Live countdown ETA updated.`,
      channel: 'IN_APP_SMS',
      status: 'DELIVERED'
    });
    void sendWebPush({
      routeId: rId,
      title: `⚠️ Traffic Delay: +${delayMinutes}m`,
      body: `${rId.replace('route-', 'Route ')} is running +${delayMinutes}m behind schedule.`,
      url: '/'
    });
  }
  broadcast('BUS_DELAY', { routeId: rId, delayMinutes }, rId);
  res.json({ success: true, delayMinutes, routeId: rId });
});

app.post('/api/driver/board-stop', requireRole('DRIVER'), (req, res) => {
  const rId = normalizeRoute(req.user.routeId || 'route-51');
  const stopName = str(req.body?.stopName || 'Current Stop', 80, 'stopName');
  const studentsList = Array.isArray(req.body?.students) ? req.body.students : [];
  const accepted = [];
  if (studentsList.length > 0) {
    for (const stu of studentsList) {
      const roll = String(stu.rollNumber || '').trim().toUpperCase();
      if (!roll) continue;
      const sRow = extras.getStudentRow(roll);
      if (!sRow || normalizeRoute(sRow.route_id) !== rId || !sameStopName(sRow.pickup_stop, stopName)) {
        continue; // reject invalid or off-route roll numbers
      }
      if (extras.isBoardedToday(roll, rId)) {
        continue; // idempotent: already boarded today on this route
      }
      appendSheetRow('Boarding_Attendance', {
        Timestamp: now(), 
        'Roll Number': roll,
        'Student Name': sRow.name,
        'Route ID': rId, 
        'Stop Name': stopName,
        'Event Type': 'BOARDED_DRIVER_CONFIRMED',
        'Check-In Method': 'DRIVER_CABIN_ROSTER',
        Notes: `Driver checked-in ${sRow.name} (${roll}) at ${stopName}`
      });
      accepted.push({ roll, name: sRow.name });
      broadcast('STUDENT_BOARDED', {
        rollNumber: roll,
        studentName: sRow.name,
        routeId: rId,
        stopName,
        method: 'DRIVER_CABIN_ROSTER',
        timestamp: Date.now()
      }, rId);
    }
  } else {
    const count = Math.max(0, Math.min(60, Number(req.body?.count) || 0));
    if (count === 0) return res.json({ success: true, routeId: rId, headcount: extras.getTripState(rId).headcount, boardedRollNumbers: [] });
    appendSheetRow('Boarding_Attendance', {
      Timestamp: now(), 'Roll Number': `BATCH-${Date.now()}`, 'Student Name': `Batch Boarding (${count} riders)`,
      'Route ID': rId, 'Stop Name': stopName,
      'Event Type': 'BATCH_BOARDED', 'Check-In Method': 'DRIVER_CABIN_STEPPER',
      Notes: `Driver checked-in ${count} passengers at ${stopName}`
    });
    for (let i = 0; i < count; i++) accepted.push({ roll: null, name: null });
  }
  const count = accepted.length;
  const st = extras.getTripState(rId);
  const newHeadcount = Math.min(60, (st.headcount || 0) + count);
  extras.setTripState(rId, st.running, st.delayMinutes, newHeadcount);
  if (extras.clearStopTimerIfNoPending(rId, stopName)) {
    broadcast('STOP_TIMER_CLEARED', { routeId: rId, stopName }, rId);
  }
  broadcast('STOP_BOARDED', { routeId: rId, stopName, count, headcount: newHeadcount }, rId);
  res.json({ success: true, routeId: rId, headcount: newHeadcount, boardedRollNumbers: accepted.map((s) => s.roll).filter(Boolean) });
});

/* ---------------- Shared Real-Time Stop Countdown Timers & Live Opt-Outs (Durable SQLite) ---------------- */
app.post('/api/trips/timer', requireRole('DRIVER'), (req, res) => {
  const rId = normalizeRoute(req.user.routeId || 'route-51');
  const stopName = str(req.body?.stopName || 'Stop', 80, 'stopName');
  const durationSeconds = Math.max(10, Math.min(300, Number(req.body?.durationSeconds) || 120));
  const timer = extras.setStopTimer(rId, stopName, durationSeconds);
  broadcast('STOP_TIMER_STARTED', { routeId: rId, stopName, durationSeconds, startedAt: timer.startedAt }, rId);
  res.json({ success: true, routeId: rId, stopName, durationSeconds, startedAt: timer.startedAt });
});

app.post('/api/trips/clear-timer', requireRole('DRIVER'), (req, res) => {
  const rId = normalizeRoute(req.user.routeId || 'route-51');
  extras.clearStopTimer(rId);
  broadcast('STOP_TIMER_CLEARED', { routeId: rId }, rId);
  res.json({ success: true, routeId: rId });
});

app.get('/api/trips/timer/:routeId', requireAuth, (req, res) => {
  const rId = normalizeRoute(req.params.routeId);
  if (req.user.role !== 'ADMIN' && normalizeRoute(rId) !== normalizeRoute(req.user.routeId)) {
    throw new HttpError(403, 'Forbidden: You can only view stop timers for your assigned route');
  }
  const timer = extras.getStopTimer(rId);
  if (!timer) return res.json({ success: true, active: false });
  // A route may have many stops. Students and parents should see the timer
  // only when the bus is at their own pickup stop.
  if (req.user.role === 'STUDENT' || req.user.role === 'PARENT') {
    const roll = req.user.role === 'PARENT' ? req.user.wardRoll : req.user.sub;
    const student = extras.getStudentRow(roll);
    if (!student || !sameStopName(student.pickup_stop, timer.stopName)) {
      return res.json({ success: true, active: false });
    }
  }
  res.json({ success: true, active: true, stopName: timer.stopName, remainingSeconds: timer.remainingSeconds, startedAt: timer.startedAt });
});

app.post('/api/trips/opt-out', requireRole('STUDENT'), (req, res) => {
  const rId = normalizeRoute(req.user.routeId || 'route-51');
  const note = str(req.body?.note || 'Skipping stop today', 200, 'note');
  const s = extras.getStudentRow(req.user.sub);
  if (!s || normalizeRoute(s.route_id) !== rId) throw new HttpError(403, 'Student is not assigned to this route');
  appendSheetRow('Boarding_Attendance', {
    Timestamp: now(), 'Roll Number': req.user.sub,
    'Student Name': req.user.name || s?.name || 'Student',
    'Route ID': rId, 'Stop Name': s?.pickup_stop || 'Stop',
    'Event Type': 'NOT_COMING_OPT_OUT',
    'Check-In Method': 'STUDENT_PORTAL_TAP',
    Notes: note
  });
  broadcast('STUDENT_OPT_OUT', {
    rollNumber: req.user.sub,
    studentName: req.user.name || s?.name || 'Student',
    routeId: rId,
    stopName: s?.pickup_stop,
    note,
    timestamp: Date.now()
  }, rId);
  if (extras.clearStopTimerIfNoPending(rId, s.pickup_stop)) {
    broadcast('STOP_TIMER_CLEARED', { routeId: rId, stopName: s.pickup_stop }, rId);
  }
  res.json({ success: true, rollNumber: req.user.sub, routeId: rId, note });
});

app.get('/api/bus/state/:routeId', requireAuth, (req, res) => {
  const rId = normalizeRoute(req.params.routeId);
  if (req.user.role !== 'ADMIN' && normalizeRoute(rId) !== normalizeRoute(req.user.routeId)) {
    throw new HttpError(403, 'Forbidden: You can only view bus state for your assigned route');
  }
  const st = extras.getTripState(rId);
  const tomorrow = getTomorrowStr();
  const plan = extras.computeRouteOptimization(rId, tomorrow);
  res.json({
    success: true,
    ...st,
    assignedCount: plan.totalRouteStudents,
    absentTomorrowCount: plan.absentRouteStudents,
    expectedTomorrow: plan.expectedRouteStudents,
    skippedClusterIds: plan.skippedClusterIds,
    hasRosterData: plan.totalRouteStudents > 0,
    routePlan: plan,
  });
});

