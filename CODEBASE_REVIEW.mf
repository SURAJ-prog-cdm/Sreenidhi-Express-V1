    CREATE TABLE boarding_attendance (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT, roll_number TEXT, name TEXT, route_id TEXT, stop_name TEXT, event_type TEXT, check_in_method TEXT, notes TEXT);`);
