NODE_ENV=production
PORT=3001
TRUST_PROXY=1                      # behind Render/Nginx so req.ip (rate limits) is the real client
JWT_SECRET=                        # >= 32 random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATE_SECRET=                       # >= 32 random chars, different from JWT_SECRET
ALLOWED_ORIGINS=https://your-app.example.com   # exact origins only; https://localhost (Capacitor) is built in
ADMIN_ID=SNIST-ADMIN
ADMIN_NAME=Transport Incharge
ADMIN_PASSWORD_HASH=               # node scripts/hash-password.js "a long passphrase"
# Optional additional admins in .env (comma-separated JSON objects):
# ADMIN_ACCOUNTS=[{"id":"hod@sreenidhi.edu.in","name":"HOD CSE (AI/ML)","passwordHash":"scrypt$..."}]
DRIVER_PIN_HASHES={"route-14":"scrypt$...","route-15":"scrypt$..."}   # one hash per bus; use 6+ digit PINs
TELEGRAM_BOT_TOKEN=                # server-side ONLY. Remove VITE_NOTIFICATION_API_KEY / webhook URLs from the client env
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=           # any random string; pass it as secret_token when calling setWebhook

# client (.env for vite build)
VITE_API_BASE_URL=https://api.your-app.example.com   # HTTPS: the Android webview blocks http:// as mixed content
